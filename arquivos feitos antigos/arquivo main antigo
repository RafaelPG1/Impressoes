class ModalManager {
    constructor() {
        this.confirmCallback = null;
        this.editingId = null;
        this.initializeElements();
        this.setupEventListeners();
    }

    initializeElements() {
        this.elements = {
            confirmModal: document.getElementById('confirmModal'),
            editModal: document.getElementById('editModal'),
            addModal: document.getElementById('addModal'),
            confirmTitle: document.getElementById('confirmTitle'),
            confirmMessage: document.getElementById('confirmMessage'),
            confirmYes: document.getElementById('confirmYes'),
            editForm: document.getElementById('editForm'),
            addForm: document.getElementById('addForm')
        };
    }

    setupEventListeners() {
        const closeButtons = document.querySelectorAll('.modal .close, .close-modal');
        closeButtons.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const modal = e.target.closest('.modal');
                this.closeModal(modal);
            });
        });

        const confirmCancelBtn = document.getElementById('confirmCancelBtn');
        confirmCancelBtn?.addEventListener('click', () => this.closeConfirm());

        const confirmOkBtn = document.getElementById('confirmOkBtn');
        confirmOkBtn?.addEventListener('click', () => {
            if (this.confirmCallback) {
                this.confirmCallback();
                this.confirmCallback = null;
            }
            this.closeConfirm();
        });

        const editCancelBtn = this.elements.editModal?.querySelector('.btn-secondary');
        editCancelBtn?.addEventListener('click', () => this.closeEdit());

        const addCancelBtn = this.elements.addModal?.querySelector('.btn-secondary');
        addCancelBtn?.addEventListener('click', () => this.closeAdd());

        this.elements.confirmYes?.addEventListener('click', () => {
            if (this.confirmCallback) {
                this.confirmCallback();
                this.confirmCallback = null;
            }
            this.closeConfirm();
        });

        this.elements.editForm?.addEventListener('submit', (e) => this.handleEditSubmit(e));
        this.elements.addForm?.addEventListener('submit', (e) => this.handleAddSubmit(e));
    }

    showSuccess(message) {
        if (window.modernAlert) {
            window.modernAlert.success(message);
        }
    }

    showError(message) {
        if (window.modernAlert) {
            window.modernAlert.error(message);
        }
    }

    showConfirm(title, message, callback) {
        this.elements.confirmTitle.textContent = title;
        this.elements.confirmMessage.textContent = message;
        this.confirmCallback = callback;
        this.elements.confirmModal.style.display = 'block';
    }

    closeConfirm() {
        this.elements.confirmModal.style.display = 'none';
        this.confirmCallback = null;
    }

    showEdit(id, impressao) {
        this.editingId = id;
        const form = this.elements.editForm;
        
        form.querySelector('#editCliente').value = impressao.cliente;
        form.querySelector('#editDataHora').value = impressao.dataHora.slice(0, 16);
        
        if (window.editCalculationManager) {
            window.editCalculationManager.loadImpression(impressao);
        } else {
            form.querySelector('#editTipoImpressao').value = impressao.tipoImpressao || '';
            form.querySelector('#editFolhasNormais').value = impressao.folhasNormais || 0;
            form.querySelector('#editFolhasOffset').value = impressao.folhasOffset || 0;
            form.querySelector('#editProjetoCanva').value = (impressao.projetoCanva || 0).toFixed(2);
            form.querySelector('#editTrabalho').value = (impressao.trabalho || 0).toFixed(2);
        }
        
        this.elements.editModal.style.display = 'block';
    }

    closeEdit() {
        this.elements.editModal.style.display = 'none';
        this.editingId = null;
    }

    showAdd() {
        this.elements.addForm?.reset();
        const now = new Date();
        const localDateTime = new Date(now.getTime() - now.getTimezoneOffset() * 60000)
            .toISOString()
            .slice(0, 16);
        this.elements.addForm.querySelector('#addDataHora').value = localDateTime;
        this.elements.addModal.style.display = 'block';
    }

    closeAdd() {
        this.elements.addModal.style.display = 'none';
    }

    closeModal(modal) {
        modal.style.display = 'none';
    }

    async handleEditSubmit(event) {
        event.preventDefault();
        
        if (!this.editingId) {
            console.error('[MODAL] ❌ Tentativa de editar sem ID válido');
            if (window.modernAlert) {
                window.modernAlert.error('Erro: ID da impressão não encontrado');
            }
            return;
        }
        
        console.log('[MODAL] Editando impressão ID:', this.editingId);
        
        const form = event.target;
        
        const valorTotal = window.editCalculationManager ? 
            window.editCalculationManager.calculateTotal() : 0;
        
        const nomeCliente = form.querySelector('#editCliente').value.trim();
        
        const hasLetter = /[a-zA-ZÀ-ÿ]/.test(nomeCliente);
        if (!nomeCliente || !hasLetter) {
            if (window.modernAlert) {
                window.modernAlert.error('Nome do cliente inválido');
            }
            return;
        }
        
        const isManual = window.editCalculationManager && 
                        window.editCalculationManager.isUsingManualValue();
        
        const tipoImpressao = isManual ? 0 : parseInt(form.querySelector('#editTipoImpressao').value);
        
        if (!isManual && (!tipoImpressao || tipoImpressao === 0)) {
            if (window.modernAlert) {
                window.modernAlert.error('Selecione um tipo de impressão válido');
            }
            return;
        }
        
        const updatedData = {
            cliente: nomeCliente,
            tipoImpressao: tipoImpressao,
            folhasNormais: isManual ? 0 : (parseInt(form.querySelector('#editFolhasNormais').value) || 0),
            folhasOffset: isManual ? 0 : (parseInt(form.querySelector('#editFolhasOffset').value) || 0),
            projetoCanva: isManual ? 0 : (parseFloat(form.querySelector('#editProjetoCanva').value) || 0),
            trabalho: isManual ? 0 : (parseFloat(form.querySelector('#editTrabalho').value) || 0),
            valorTotal: valorTotal,
            dataHora: form.querySelector('#editDataHora').value + ':00.000Z'
        };
        
        console.log('[MODAL] Dados a atualizar:', updatedData);
        console.log('[MODAL] Modo:', isManual ? 'MANUAL' : 'AUTOMÁTICO');
        console.log('[MODAL] Tipo de impressão:', tipoImpressao === 0 ? 'Desconhecido' : tipoImpressao);
        
        const idToUpdate = this.editingId;
        
        this.closeEdit();
        
        if (window.impressionManager) {
            await window.impressionManager.updateImpression(idToUpdate, updatedData);
        }
    }

    async handleAddSubmit(event) {
        event.preventDefault();
        
        const form = event.target;
        const nomeCliente = form.querySelector('#addCliente').value.trim();
        
        if (!nomeCliente) {
            if (window.modernAlert) {
                window.modernAlert.error('Digite o nome do cliente');
            }
            return;
        }

        const hasLetter = /[a-zA-ZÀ-ÿ]/.test(nomeCliente);
        if (!hasLetter) {
            if (window.modernAlert) {
                window.modernAlert.error('Nome deve ter pelo menos uma letra');
            }
            return;
        }

        const valorTotal = parseFloat(form.querySelector('#addValorTotal').value);
        const dataHora = form.querySelector('#addDataHora').value + ':00.000Z';
        
        const impressao = {
            cliente: nomeCliente,
            tipoImpressao: 0,
            tipoPreco: 'Desconhecido',
            folhasNormais: 0,
            folhasOffset: 0,
            projetoCanva: 0,
            trabalho: 0,
            valorTotal: valorTotal,
            valorPago: 0,
            statusPagamento: 'ativo',
            dataHora: dataHora,
            timestamp: Date.now()
        };
        
        this.closeAdd();
        
        if (window.impressionManager) {
            await window.impressionManager.addImpression(impressao);
        }
    }

    getTypeText(tipo) {
        const tipos = {
            0: 'Desconhecido',
            1: 'Xerox P&B',
            2: 'Xerox Colorido',
            3: 'Digital P&B',
            4: 'Digital Colorido'
        };
        return tipos[tipo] || 'Desconhecido';
    }
}

window.ModalManager = ModalManager;

