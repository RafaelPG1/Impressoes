// ===============================
// SISTEMA DE LOADING MODERNO
// ===============================

class ModernLoadingSystem {
    constructor() {
        this.overlay = document.getElementById('modernLoadingOverlay');
        this.visible = false;
    }

    show() {
        if (!this.visible) {
            this.overlay.classList.add('show');
            this.visible = true;
            console.log('[LOADING] 🔄 Loading exibido');
        }
    }

    hide() {
        if (this.visible) {
            this.overlay.classList.remove('show');
            this.visible = false;
            console.log('[LOADING] ✅ Loading ocultado');
        }
    }
}

// ===============================
// SISTEMA DE ALERTAS MODERNO
// ===============================

class ModernAlertSystem {
    constructor() {
        this.container = document.getElementById('modernAlertContainer');
        this.alertQueue = [];
    }

    show(type, message, title = null, duration = 4000) {
        const alert = this.createAlert(type, message, title);
        this.container.appendChild(alert);

        setTimeout(() => {
            alert.style.opacity = '1';
            alert.style.transform = 'translateY(0)';
        }, 10);

        const autoCloseTimer = setTimeout(() => {
            this.close(alert);
        }, duration);

        const closeBtn = alert.querySelector('.modern-alert-close');
        if (closeBtn) {
            closeBtn.addEventListener('click', () => {
                clearTimeout(autoCloseTimer);
                this.close(alert);
            });
        }
    }

    createAlert(type, message, title) {
        const alert = document.createElement('div');
        alert.className = `modern-alert ${type}`;

        const icons = {
            success: 'fa-check-circle',
            error: 'fa-exclamation-circle',
            warning: 'fa-exclamation-triangle',
            info: 'fa-info-circle'
        };

        const titles = {
            success: title || 'Sucesso!',
            error: title || 'Erro!',
            warning: title || 'Atenção!',
            info: title || 'Informação'
        };

        alert.innerHTML = `
            <div class="modern-alert-icon">
                <i class="fas ${icons[type]}"></i>
            </div>
            <div class="modern-alert-content">
                <h4 class="modern-alert-title">${titles[type]}</h4>
                <p class="modern-alert-message">${message}</p>
            </div>
            <button class="modern-alert-close">
                <i class="fas fa-times"></i>
            </button>
        `;

        return alert;
    }

    close(alert) {
        alert.classList.add('hiding');
        setTimeout(() => {
            alert.remove();
        }, 300);
    }

    success(message, title = null, duration = 3000) {
        this.show('success', message, title, duration);
    }

    error(message, title = null, duration = 4000) {
        this.show('error', message, title, duration);
    }

    warning(message, title = null, duration = 4000) {
        this.show('warning', message, title, duration);
    }

    info(message, title = null, duration = 3000) {
        this.show('info', message, title, duration);
    }
}

const modernLoading = new ModernLoadingSystem();
const modernAlert = new ModernAlertSystem();

window.modernLoading = modernLoading;
window.modernAlert = modernAlert;

// ===============================
// FUNÇÃO GLOBAL DE ATUALIZAÇÃO
// ===============================

async function refreshAllData(silent = false) {
    if (!silent) {
        console.log('[REFRESH] 🔄 Atualizando dados...');
    }
    
    try {
        if (window.impressionManager) {
            console.log('[REFRESH] Carregando impressões do Supabase...');
            await window.impressionManager.loadFromSupabase();
        }
        
        console.log('[REFRESH] Carregando resumo de clientes...');
        await carregarResumoClientes({
            containerId: 'resumoClientes',
            orderBy: 'saldo_devedor',
            ascending: false
        });
        
        if (!silent) {
            console.log('[REFRESH] ✅ Dados atualizados!');
        }
    } catch (error) {
        console.error('[REFRESH] ❌ Erro ao atualizar dados:', error);
        modernAlert.error('Erro ao atualizar dados');
    }
}

window.refreshAllData = refreshAllData;

