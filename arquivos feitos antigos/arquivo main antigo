class ImpressionManager {
    constructor() {
        this.impressions = [];
        this.initializeElements();
        this.setupEventListeners();
    }

    initializeElements() {
        this.elements = {
            tableBody: document.getElementById('impressoesTableBody'),
            clearTableBtn: document.getElementById('clearTableBtn'),
            addManualBtn: document.getElementById('addManualBtn')
        };
    }

    setupEventListeners() {
        this.elements.clearTableBtn?.addEventListener('click', () => this.confirmClearAll());
        this.elements.addManualBtn?.addEventListener('click', () => modalManager.showAdd());
    }

    async loadFromSupabase() {
        try {
            console.log('[IMPRESSION] Carregando impressões do Supabase...');
            modernLoading.show();
            this.impressions = await supabaseManager.loadImpressions();
            console.log('[IMPRESSION] Total de impressões carregadas:', this.impressions.length);
            this.renderTable();
            modernLoading.hide();
        } catch (error) {
            modernLoading.hide();
            console.error('[IMPRESSION] ❌ Erro ao carregar impressões:', error);
            modernAlert.error('Erro ao carregar impressões do banco');
        }
    }



    async addImpression(impressionData) {
        try {
            console.log('[IMPRESSION] Adicionando nova impressão:', impressionData);
            modernLoading.show();
            
            await supabaseManager._syncAddImpression(impressionData);
            
            modernAlert.success('Impressão adicionada com sucesso!');
            
            await new Promise(resolve => setTimeout(resolve, 500));
            
            console.log('[IMPRESSION] Recarregando dados após adicionar...');
            await this.loadFromSupabase();
            await refreshAllData(true);
            
            modernLoading.hide();
        } catch (error) {
            modernLoading.hide();
            console.error('[IMPRESSION] ❌ Erro ao adicionar impressão:', error);
            modernAlert.error('Erro ao adicionar impressão');
        }
    }

    
async updateImpression(id, updatedData) {
    try {
        console.log('[IMPRESSION] Atualizando impressão:', id, updatedData);
        modernLoading.show();
        
        // ✅ CORREÇÃO: Não mostra preço quando for "Desconhecido"
        let tipoPreco;
        if (updatedData.tipoImpressao === 0) {
            tipoPreco = 'Desconhecido';  // SEM "R$ 0,00"
        } else {
            tipoPreco = `${modalManager.getTypeText(updatedData.tipoImpressao)} R$ ${priceManager.getPrice(updatedData.tipoImpressao).toFixed(2)}`;
        }
        
        await supabaseManager.updateImpression(id, {
