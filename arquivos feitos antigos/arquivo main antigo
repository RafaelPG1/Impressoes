class FormManager {
    constructor() {
        this.STORAGE_KEY = 'impressaoForm_autoSave';
        this.initializeElements();
        this.setupEventListeners();
        this.loadFormData();
    }

    initializeElements() {
        this.elements = {
            form: document.getElementById('impressaoForm'),
            nomeCliente: document.getElementById('nomeCliente'),
            tipoImpressao: document.getElementById('tipoImpressao'),
            folhasNormais: document.getElementById('folhasNormais'),
            folhasOffset: document.getElementById('folhasOffset'),
            projetoCanva: document.getElementById('projetoCanva'),
            trabalho: document.getElementById('trabalho'),
            clearFormBtn: document.getElementById('clearFormBtn'),
            nomeClienteError: document.getElementById('nomeClienteError'),
            folhasOffsetError: document.getElementById('folhasOffsetError')
        };
    }

    setupEventListeners() {
        this.elements.form?.addEventListener('submit', (e) => this.handleSubmit(e));
        this.elements.clearFormBtn?.addEventListener('click', () => this.clearForm());

        this.elements.nomeCliente?.addEventListener('input', () => {
            this.validateClientName();
            this.saveFormData();
        });

        this.elements.folhasOffset?.addEventListener('input', () => {
            this.validateFolhasOffset();
            this.saveFormData();
        });

        this.elements.folhasNormais?.addEventListener('input', () => {
            this.validateFolhasOffset();
            this.saveFormData();
        });

        this.elements.tipoImpressao?.addEventListener('change', () => this.saveFormData());
        this.elements.projetoCanva?.addEventListener('input', () => this.saveFormData());
        this.elements.trabalho?.addEventListener('input', () => this.saveFormData());

        this.setupNumberFieldFormatting();
    }

    saveFormData() {
        try {
            const formData = {
                nomeCliente: this.elements.nomeCliente?.value || '',
                tipoImpressao: this.elements.tipoImpressao?.value || '',
                folhasNormais: this.elements.folhasNormais?.value || '0.00',
                folhasOffset: this.elements.folhasOffset?.value || '0.00',
                projetoCanva: this.elements.projetoCanva?.value || '0.00',
                trabalho: this.elements.trabalho?.value || '0.00',
                timestamp: Date.now()
            };

            localStorage.setItem(this.STORAGE_KEY, JSON.stringify(formData));
            console.log('[FORM] Dados salvos no localStorage');
        } catch (error) {
            console.error('[FORM] Erro ao salvar dados do formulário:', error);
        }
    }

    loadFormData() {
        try {
            console.log('[FORM] Carregando dados do localStorage...');
            const savedData = localStorage.getItem(this.STORAGE_KEY);
            if (!savedData) {
                console.log('[FORM] Nenhum dado salvo encontrado');
                return;
            }

            const formData = JSON.parse(savedData);

            const dayInMs = 24 * 60 * 60 * 1000;
            if (formData.timestamp && (Date.now() - formData.timestamp) > dayInMs) {
                console.log('[FORM] Dados expirados (>24h), limpando...');
                this.clearSavedData();
                return;
            }

            if (this.elements.nomeCliente) this.elements.nomeCliente.value = formData.nomeCliente || '';
            if (this.elements.tipoImpressao) this.elements.tipoImpressao.value = formData.tipoImpressao || '';
            if (this.elements.folhasNormais) this.elements.folhasNormais.value = formData.folhasNormais || '0.00';
            if (this.elements.folhasOffset) this.elements.folhasOffset.value = formData.folhasOffset || '0.00';
            if (this.elements.projetoCanva) this.elements.projetoCanva.value = formData.projetoCanva || '0.00';
            if (this.elements.trabalho) this.elements.trabalho.value = formData.trabalho || '0.00';

            if (formData.tipoImpressao) {
                priceManager.showTypePrice();
            }

            calculationManager.calculateTotal();

            console.log('[FORM] ✅ Dados do formulário restaurados');
        } catch (error) {
            console.error('[FORM] Erro ao carregar dados do formulário:', error);
            this.clearSavedData();
        }
    }

    clearSavedData() {
        try {
            localStorage.removeItem(this.STORAGE_KEY);
            console.log('[FORM] Dados do localStorage removidos');
        } catch (error) {
            console.error('[FORM] Erro ao limpar dados salvos:', error);
        }
    }

    setupNumberFieldFormatting() {
        const numberFields = [
            this.elements.folhasNormais,
            this.elements.folhasOffset,
            this.elements.projetoCanva,
            this.elements.trabalho
        ];

        numberFields.forEach(field => {
            if (!field) return;

            field.addEventListener('click', e => e.target.select());
            field.addEventListener('focus', e => e.target.select());

            field.addEventListener('blur', e => {
                let value = e.target.value;

                if (value === '' || value === null) {
                    e.target.value = '0.00';
                } else {
                    const numericValue = parseFloat(value);
                    e.target.value = isNaN(numericValue) ? '0.00' : numericValue.toFixed(2);
                }

                calculationManager.calculateTotal();
                this.saveFormData();
            });
        });
    }

    validateClientName() {
        const nome = this.elements.nomeCliente.value.trim();
        const hasLetter = /[a-zA-ZÀ-ÿ]/.test(nome);

        if (nome && !hasLetter) {
            this.elements.nomeClienteError.textContent = 'O nome deve ter pelo menos uma letra';
            this.elements.nomeCliente.classList.add('error');
            return false;
        }

        this.elements.nomeClienteError.textContent = '';
        this.elements.nomeCliente.classList.remove('error');
        return true;
    }

    validateFolhasOffset() {
        const folhasNormais = parseInt(this.elements.folhasNormais.value) || 0;
        const folhasOffset = parseInt(this.elements.folhasOffset.value) || 0;

        if (folhasOffset > folhasNormais) {
            this.elements.folhasOffsetError.textContent = 'Offset não pode ser maior que o total';
            this.elements.folhasOffset.classList.add('error');
            this.elements.folhasOffset.value = folhasNormais;
            calculationManager.calculateTotal();
            return false;
        }

        this.elements.folhasOffsetError.textContent = '';
        this.elements.folhasOffset.classList.remove('error');
        return true;
    }

    async handleSubmit(event) {
        event.preventDefault();

        console.log('[FORM] Submetendo formulário...');

        const isClientNameValid = this.validateClientName();
        const isFolhasOffsetValid = this.validateFolhasOffset();

        if (!isClientNameValid) {
            modernAlert.error('Nome inválido');
            return;
        }

        if (!isFolhasOffsetValid) return;

        const formData = this.getFormData();
        if (!this.validateForm(formData)) return;

        const valorTotal = calculationManager.calculateTotal();

        const impressao = {
            cliente: formData.nome,
            tipoImpressao: formData.tipo,
            tipoPreco: `${this.getTypeText(formData.tipo)} R$ ${priceManager.getPrice(formData.tipo).toFixed(2)}`,
            folhasNormais: formData.folhasNormais,
            folhasOffset: formData.folhasOffset,
            projetoCanva: formData.projetoCanva,
            trabalho: formData.trabalho,
            valorTotal: valorTotal,
            valorPago: 0,
            statusPagamento: 'ativo',
            dataHora: new Date().toISOString(),
            timestamp: Date.now()
        };

        console.log('[FORM] Impressão a ser adicionada:', impressao);

        await impressionManager.addImpression(impressao);

        this.clearForm();
        this.clearSavedData();
    }

    getFormData() {
        return {
            nome: this.elements.nomeCliente?.value.trim(),
            tipo: parseInt(this.elements.tipoImpressao?.value),
            folhasNormais: parseInt(this.elements.folhasNormais?.value) || 0,
            folhasOffset: parseInt(this.elements.folhasOffset?.value) || 0,
            projetoCanva: parseFloat(this.elements.projetoCanva?.value) || 0,
            trabalho: parseFloat(this.elements.trabalho?.value) || 0
        };
    }

    validateForm(formData) {
        if (!formData.nome) {
            modernAlert.error('Digite o nome do cliente');
            return false;
        }

        const hasLetter = /[a-zA-ZÀ-ÿ]/.test(formData.nome);
        if (!hasLetter) {
            modernAlert.error('Nome deve ter pelo menos uma letra');
            return false;
        }

        if (!formData.tipo) {
            modernAlert.error('Selecione o tipo de impressão');
            return false;
        }

        if (formData.folhasNormais === 0 && formData.folhasOffset === 0 && formData.projetoCanva === 0 && formData.trabalho === 0) {
            modernAlert.error('Informe pelo menos uma folha, projeto ou trabalho');
            return false;
        }

        if (formData.folhasOffset > formData.folhasNormais) {
            modernAlert.error('Offset não pode ser maior que total');
            return false;
        }

        return true;
    }

    getTypeText(tipo) {
        const tipos = {
            1: 'Xerox P&B',
            2: 'Xerox Colorido',
            3: 'Digital P&B',
            4: 'Digital Colorido'
        };
        return tipos[tipo] || 'Desconhecido';
    }

    clearForm() {
        console.log('[FORM] Limpando formulário...');
        this.elements.form?.reset();
        this.elements.nomeClienteError.textContent = '';
        this.elements.folhasOffsetError.textContent = '';
        this.elements.nomeCliente.classList.remove('error');
        this.elements.folhasOffset.classList.remove('error');
        priceManager.elements.precoTipo.style.display = 'none';
        calculationManager.elements.valorTotal.textContent = 'R$ 0,00';
        calculationManager.elements.totalBreakdown.innerHTML = '<div class="calculation-empty">Selecione o tipo de impressão e preencha os campos</div>';
    }
}

