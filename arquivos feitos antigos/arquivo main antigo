// ===============================

function initDateTimeHoldToClose() {
    const overlay = document.getElementById('customDateTimeOverlay');
    
    if (overlay) {
        let holdTimer = null;
        let progressElement = null;
        let isHolding = false;
        let startX = 0;
        let startY = 0;

        overlay.addEventListener('mousedown', (e) => {
            // Verifica se clicou no overlay (fundo)
            if (e.target === overlay) {
                isHolding = true;
                startX = e.clientX;
                startY = e.clientY;

                // Cria indicador
                progressElement = document.createElement('div');
                progressElement.className = 'modal-hold-progress';
                progressElement.style.left = `${e.clientX}px`;
                progressElement.style.top = `${e.clientY}px`;
                
                progressElement.innerHTML = `
                    <div class="hold-progress-circle">
                        <svg class="progress-ring" width="60" height="60">
                            <circle class="progress-ring-circle" 
                                    stroke="white" 
                                    stroke-width="3" 
                                    fill="transparent" 
                                    r="26" 
                                    cx="30" 
                                    cy="30"/>
                        </svg>
                        <div class="hold-progress-icon">
                            <i class="fas fa-times"></i>
                        </div>
                    </div>
                    <div class="hold-progress-text">Segure para fechar</div>
                `;

                document.body.appendChild(progressElement);

                // Anima círculo
                const circle = progressElement.querySelector('.progress-ring-circle');
                const radius = circle.r.baseVal.value;
                const circumference = radius * 2 * Math.PI;
                
                circle.style.strokeDasharray = `${circumference} ${circumference}`;
                circle.style.strokeDashoffset = circumference;
                circle.getBoundingClientRect();
                circle.style.transition = 'stroke-dashoffset 2000ms linear';
                circle.style.strokeDashoffset = '0';

                // Timer de 2 segundos
                holdTimer = setTimeout(() => {
                    if (window.customDateTimePicker) {
                        window.customDateTimePicker.close();
                    }
                    if (progressElement) {
                        progressElement.remove();
                    }
                    isHolding = false;
                }, 2000);
            }
        });

        overlay.addEventListener('mouseup', () => {
            if (holdTimer) {
                clearTimeout(holdTimer);
                holdTimer = null;
            }
            if (progressElement) {
                progressElement.remove();
                progressElement = null;
            }
            isHolding = false;
        });

        overlay.addEventListener('mousemove', (e) => {
            if (isHolding) {
                const deltaX = Math.abs(e.clientX - startX);
                const deltaY = Math.abs(e.clientY - startY);
                
                if (deltaX > 10 || deltaY > 10) {
                    if (holdTimer) {
                        clearTimeout(holdTimer);
                        holdTimer = null;
                    }
                    if (progressElement) {
                        progressElement.remove();
                        progressElement = null;
                    }
                    isHolding = false;
                }
            }
        });

        overlay.addEventListener('mouseleave', () => {
            if (holdTimer) {
                clearTimeout(holdTimer);
                holdTimer = null;
            }
            if (progressElement) {
                progressElement.remove();
                progressElement = null;
            }
            isHolding = false;
        });
        
        console.log('[DATETIME HOLD] ✅ Sistema de segurar para fechar inicializado para calendário');
    }
}

