// GERENCIADOR DE CÁLCULOS DO MODAL EDITAR
// VERSÃO FINAL - VALOR MANUAL APENAS PARA IMPRESSÕES CRIADAS MANUALMENTE
// ===============================

class EditCalculationManager {
    constructor() {
        this.currentImpressionId = null;
        this.loadedManualValue = null;
        this.isManualImpression = false;
        this.initializeElements();
        this.setupEventListeners();
        this.setupNumberFieldFormatting();
        this.calculateTotal();
    }

    initializeElements() {
        this.elements = {
            tipoImpressao: document.getElementById('editTipoImpressao'),
            folhasNormais: document.getElementById('editFolhasNormais'),
            folhasOffset: document.getElementById('editFolhasOffset'),
            projetoCanva: document.getElementById('editProjetoCanva'),
            trabalho: document.getElementById('editTrabalho'),
            valorTotal: document.getElementById('editValorTotal'),
            precoTipo: document.getElementById('editPrecoTipo'),
            valorTotalManual: document.getElementById('editValorTotalManual'),
            valorTotalManualContainer: document.getElementById('editValorTotalManualContainer')
        };
        
        if (this.elements.tipoImpressao && this.elements.tipoImpressao.options.length <= 1) {
            this.populateSelect();
        }
    }

    populateSelect() {
        if (!this.elements.tipoImpressao) {
            console.warn('[EDIT] Select #editTipoImpressao não encontrado');
            return;
        }
        
        const options = [
            { value: '', text: 'Selecione o tipo' },
            { value: '0', text: 'Desconhecido' },
            { value: '1', text: 'Xerox preto e branco' },
            { value: '2', text: 'Xerox Colorido' },
            { value: '3', text: 'Impressão digital' },
            { value: '4', text: 'Impressão Digital Colorido' }
        ];
        
        this.elements.tipoImpressao.innerHTML = options
            .map(opt => `<option value="${opt.value}">${opt.text}</option>`)
            .join('');
            
        console.log('[EDIT] Select populado com sucesso');
    }

    areAllAutomaticFieldsZero() {
        const folhasNormais = parseFloat(this.elements.folhasNormais?.value) || 0;
        const folhasOffset = parseFloat(this.elements.folhasOffset?.value) || 0;
        const projetoCanva = parseFloat(this.elements.projetoCanva?.value) || 0;
        const trabalho = parseFloat(this.elements.trabalho?.value) || 0;
        
        return folhasNormais === 0 && folhasOffset === 0 && 
               projetoCanva === 0 && trabalho === 0;
    }

    // ✅ MÉTODO NECESSÁRIO: Verifica se está usando valor manual
    isUsingManualValue() {
        // Só retorna true se for impressão manual E todos campos zerados E tem valor manual
        if (!this.isManualImpression) return false;
        
        const allFieldsZero = this.areAllAutomaticFieldsZero();
        const valorManual = parseFloat(this.elements.valorTotalManual?.value) || 0;
        
        return allFieldsZero && valorManual > 0;
    }

    updateManualFieldVisibility() {
        if (!this.elements.valorTotalManualContainer) return;
        
        // Só mostra se for impressão criada manualmente
        if (this.isManualImpression) {
            this.elements.valorTotalManualContainer.style.display = 'block';
        } else {
            this.elements.valorTotalManualContainer.style.display = 'none';
        }
    }

    setupEventListeners() {
        this.elements.tipoImpressao?.addEventListener('change', () => {
            this.showTypePrice();
            this.calculateTotal();
        });

        [
            this.elements.folhasNormais,
            this.elements.folhasOffset,
            this.elements.projetoCanva,
            this.elements.trabalho
        ].forEach(input => {
            input?.addEventListener('input', () => {
                this.calculateTotal();
            });
        });

        this.elements.valorTotalManual?.addEventListener('input', () => {
            const valor = parseFloat(this.elements.valorTotalManual.value);
            if (!isNaN(valor) && valor > 0) {
                this.loadedManualValue = valor;
            } else {
                this.loadedManualValue = null;
            }
            
            this.calculateTotal();
        });

        this.elements.valorTotalManual?.addEventListener('focus', () => {
            if (this.isManualImpression) {
                if (this.elements.folhasNormais) this.elements.folhasNormais.value = '0';
                if (this.elements.folhasOffset) this.elements.folhasOffset.value = '0';
                if (this.elements.projetoCanva) this.elements.projetoCanva.value = '0.00';
                if (this.elements.trabalho) this.elements.trabalho.value = '0.00';
                if (this.elements.tipoImpressao) this.elements.tipoImpressao.value = '';
                this.showTypePrice();
            }
        });
    }

    setupNumberFieldFormatting() {
        const fields = [
            this.elements.folhasNormais,
            this.elements.folhasOffset,
            this.elements.projetoCanva,
            this.elements.trabalho,
            this.elements.valorTotalManual
        ];

        fields.forEach(field => {
            if (!field) return;

            field.addEventListener('focus', e => e.target.select());
            field.addEventListener('click', e => e.target.select());

            field.addEventListener('blur', e => {
                let value = parseFloat(e.target.value);

                if (isNaN(value)) value = 0;

                if (
                    field === this.elements.projetoCanva ||
                    field === this.elements.trabalho ||
                    field === this.elements.valorTotalManual
                ) {
                    e.target.value = value.toFixed(2);
                } else {
                    e.target.value = Math.floor(value);
                }

                this.calculateTotal();
            });
        });
    }

    showTypePrice() {
        const tipo = parseInt(this.elements.tipoImpressao?.value);
        
        if (!tipo || tipo === 0) {
            if (this.elements.precoTipo) {
                this.elements.precoTipo.style.display = 'none';
            }
            return;
        }

        const preco = Number(priceManager?.getPrice(tipo)) || 0;
        this.elements.precoTipo.textContent = `R$ ${preco.toFixed(2)} por unidade`;
        this.elements.precoTipo.style.display = 'block';
    }

    calculateTotal() {
        // Se NÃO for impressão criada manualmente, SEMPRE usa cálculo automático
        if (!this.isManualImpression) {
            return this.calculateAutomatic();
        }

        // Se FOR impressão manual, verifica se todos campos são 0
        const allFieldsZero = this.areAllAutomaticFieldsZero();
        const valorManual = parseFloat(this.elements.valorTotalManual?.value) || 0;

        // MODO MANUAL: Todos automáticos = 0 → USA VALOR MANUAL
        if (allFieldsZero && valorManual > 0) {
            if (this.elements.valorTotal) {
                this.elements.valorTotal.textContent = `R$ ${valorManual.toFixed(2)}`;
            }
            
            if (!this.elements.tipoImpressao?.value) {
                this.elements.tipoImpressao.value = '0';
            }
            
            console.log('[EDIT CALC] ✅ MODO MANUAL:', valorManual);
            return valorManual;
        }

        // MODO AUTOMÁTICO: Algum campo preenchido
        return this.calculateAutomatic();
    }

    calculateAutomatic() {
        const tipo = parseInt(this.elements.tipoImpressao?.value);
        const folhasNormais = parseFloat(this.elements.folhasNormais?.value) || 0;
        const folhasOffset = parseFloat(this.elements.folhasOffset?.value) || 0;
        const projetoCanva = parseFloat(this.elements.projetoCanva?.value) || 0;
        const trabalho = parseFloat(this.elements.trabalho?.value) || 0;

        if (!tipo || tipo === 0) {
            if (this.elements.valorTotal) {
                this.elements.valorTotal.textContent = 'R$ 0,00';
            }
            return 0;
        }

        const precoTipo = Number(priceManager?.getPrice(tipo)) || 0;
        const precoOffset = Number(priceManager?.getOffsetPrice()) || 0;

        const total =
            folhasNormais * precoTipo +
            folhasOffset * precoOffset +
            projetoCanva +
            trabalho;

        if (this.elements.valorTotal) {
            this.elements.valorTotal.textContent = `R$ ${total.toFixed(2)}`;
        }

        console.log('[EDIT CALC] ✅ MODO AUTOMÁTICO:', total);
        return total;
    }

    loadImpression(impressao, impressionId) {
        this.currentImpressionId = impressionId;
        
        // ✅ IDENTIFICA se é impressão criada manualmente
        this.isManualImpression = (!impressao.tipoImpressao || impressao.tipoImpressao === 0) &&
                                  impressao.folhasNormais === 0 && 
                                  impressao.folhasOffset === 0 && 
                                  impressao.projetoCanva === 0 && 
                                  impressao.trabalho === 0 &&
                                  impressao.valorTotal > 0;

        console.log('[EDIT CALC] Impressão manual?', this.isManualImpression);

        if (this.isManualImpression) {
            // MODO MANUAL
            this.elements.tipoImpressao.value = '';
            this.elements.folhasNormais.value = 0;
            this.elements.folhasOffset.value = 0;
            this.elements.projetoCanva.value = '0.00';
            this.elements.trabalho.value = '0.00';
            this.elements.valorTotalManual.value = impressao.valorTotal.toFixed(2);
            this.loadedManualValue = impressao.valorTotal;
            console.log('[EDIT CALC] 💾 Valor manual carregado:', this.loadedManualValue);
        } else {
            // MODO AUTOMÁTICO
            this.elements.tipoImpressao.value = impressao.tipoImpressao || '';
            this.elements.folhasNormais.value = impressao.folhasNormais || 0;
            this.elements.folhasOffset.value = impressao.folhasOffset || 0;
            this.elements.projetoCanva.value = (impressao.projetoCanva || 0).toFixed(2);
            this.elements.trabalho.value = (impressao.trabalho || 0).toFixed(2);
            this.elements.valorTotalManual.value = '';
            this.loadedManualValue = null;
            console.log('[EDIT CALC] 📋 Modo automático carregado');
        }

        this.updateManualFieldVisibility();
        this.showTypePrice();
        this.calculateTotal();
    }
}

window.EditCalculationManager = EditCalculationManager;

