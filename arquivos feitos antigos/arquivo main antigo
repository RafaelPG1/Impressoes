    renderTable() {
        console.log('[IMPRESSION] Renderizando tabela com', this.impressions.length, 'impressões');
        
        if (this.impressions.length === 0) {
            this.elements.tableBody.innerHTML = `
                <tr>
                    <td colspan="10" class="empty-state">
                        <i class="fas fa-print"></i>
                        <p>Nenhuma impressão registrada</p>
                    </td>
                </tr>
            `;
            return;
        }
        
        const statusPriority = {
            'pago': 1,
            'riscado': 1,
            'manual': 1,
            'parcial': 2,
            'ativo': 3,
            'pendente': 3
        };
        
        const impressoesOrdenadas = [...this.impressions].sort((a, b) => {
            const statusA = a.statusPagamento || 'ativo';
            const statusB = b.statusPagamento || 'ativo';
            
            const valorTotalA = a.valorTotal || 0;
            const valorPagoA = a.valorPago || 0;
            const valorTotalB = b.valorTotal || 0;
            const valorPagoB = b.valorPago || 0;
            
            let priorityA = statusPriority[statusA] || 3;
            let priorityB = statusPriority[statusB] || 3;
            
            if (valorPagoA >= valorTotalA && valorTotalA > 0) {
                priorityA = 1;
            } else if (valorPagoA > 0 && valorPagoA < valorTotalA) {
                priorityA = 2;
            } else if (valorPagoA === 0) {
                priorityA = 3;
            }
            
            if (valorPagoB >= valorTotalB && valorTotalB > 0) {
                priorityB = 1;
            } else if (valorPagoB > 0 && valorPagoB < valorTotalB) {
                priorityB = 2;
            } else if (valorPagoB === 0) {
                priorityB = 3;
            }
            
            if (priorityA !== priorityB) {
                return priorityA - priorityB;
            }
            
            const nomeA = (a.cliente || '').toLowerCase().trim();
            const nomeB = (b.cliente || '').toLowerCase().trim();
            return nomeA.localeCompare(nomeB, 'pt-BR');
        });
        
        this.elements.tableBody.innerHTML = '';
        
        impressoesOrdenadas.forEach(impressao => {
            const row = document.createElement('tr');
            const isPaid = impressao.statusPagamento === 'pago' || impressao.statusPagamento === 'riscado' || impressao.statusPagamento === 'manual';
            const isPartial = impressao.statusPagamento === 'parcial';
            
            if (isPaid) {
                row.classList.add('paid-impression');
            } else if (isPartial) {
                row.classList.add('partial-impression');
            }
            
            const folhasNormaisDisplay = impressao.folhasNormais > 0 ? impressao.folhasNormais : 0;
            const folhasOffsetDisplay = impressao.folhasOffset > 0 ? impressao.folhasOffset : 0;
            const projetoCanvaDisplay = impressao.projetoCanva > 0 ? `R$ ${impressao.projetoCanva.toFixed(2)}` : 'R$ 0.00';
            const trabalhoDisplay = impressao.trabalho > 0 ? `R$ ${impressao.trabalho.toFixed(2)}` : 'R$ 0.00';
            const saldoDevedor = impressao.valorTotal - impressao.valorPago;
            
            row.innerHTML = `
                <td><div class="client-name">${impressao.cliente}</div></td>
                <td>
                    <div class="tipo-info">
                        <div class="tipo-nome">${impressao.tipoPreco}</div>
                    </div>
                </td>
                <td><div class="folhas-display">${folhasNormaisDisplay}</div></td>
                <td><div class="folhas-display">${folhasOffsetDisplay}</div></td>
                <td><div class="folhas-display">${projetoCanvaDisplay}</div></td>
                <td><div class="folhas-display">${trabalhoDisplay}</div></td>
                <td>
                    <div class="valor-info">
                        <div class="valor-total-display">R$ ${impressao.valorTotal.toFixed(2)}</div>
                        <div class="valor-pago-display">
                            Pago: <span class="${impressao.valorPago >= impressao.valorTotal ? 'status-pago' : impressao.valorPago > 0 ? 'status-parcial' : 'status-pendente'}">R$ ${impressao.valorPago.toFixed(2)}</span>
                        </div>
                        <div class="valor-pago-display">
                            Resta: <span class="${saldoDevedor > 0 ? 'status-pendente' : 'status-pago'}">R$ ${saldoDevedor.toFixed(2)}</span>
                        </div>
                    </div>
                </td>
                <td>
                    <span class="status-badge ${impressao.statusPagamento || 'ativo'}">
                        ${this.getStatusText(impressao.statusPagamento || 'ativo')}
                    </span>
                </td>
                <td><div class="data-hora">${this.formatDateTime(impressao.dataHora)}</div></td>
                <td>
                    <div class="acoes">
                        <button class="btn-icon btn-edit" data-id="${impressao.id}" title="Editar">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn-icon btn-danger" data-id="${impressao.id}" title="Excluir">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </td>
            `;
            
            const editBtn = row.querySelector('.btn-edit');
            const deleteBtn = row.querySelector('.btn-danger');
            
            editBtn.addEventListener('click', () => this.editImpression(impressao.id));
            deleteBtn.addEventListener('click', () => this.confirmDelete(impressao.id));
            
            this.elements.tableBody.appendChild(row);
        });
    }

    getStatusText(status) {
        const statusMap = {
            'ativo': 'Ativo',
            'riscado': 'Pago',
            'manual': 'Pago (Manual)',
            'pago': 'Pago',
            'pendente': 'Pendente',
            'parcial': 'Parcial'
        };
        return statusMap[status] || 'Ativo';
    }

    formatDateTime(dataHora) {
        const data = new Date(dataHora);
        return data.toLocaleString('pt-BR', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
    }

    editImpression(id) {
        const impressao = this.impressions.find(i => i.id === id);
        if (impressao) {
            modalManager.showEdit(id, impressao);
        }
    }
}


