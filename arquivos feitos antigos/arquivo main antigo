class CalculationManager {
    constructor() {
        this.initializeElements();
        this.setupEventListeners();
    }

    initializeElements() {
        this.elements = {
            tipoImpressao: document.getElementById('tipoImpressao'),
            folhasNormais: document.getElementById('folhasNormais'),
            folhasOffset: document.getElementById('folhasOffset'),
            projetoCanva: document.getElementById('projetoCanva'),
            trabalho: document.getElementById('trabalho'),
            valorTotal: document.getElementById('valorTotal'),
            totalBreakdown: document.getElementById('totalBreakdown')
        };
    }

    setupEventListeners() {
        this.elements.tipoImpressao?.addEventListener('change', () => {
            priceManager.showTypePrice();
            this.calculateTotal();
        });
        
        [this.elements.folhasNormais, this.elements.folhasOffset, this.elements.projetoCanva, this.elements.trabalho].forEach(input => {
            input?.addEventListener('input', () => this.calculateTotal());
        });
    }

    calculateTotal() {
        const tipo = parseInt(this.elements.tipoImpressao?.value);
        const folhasNormais = parseFloat(this.elements.folhasNormais?.value) || 0;
        const folhasOffset = parseFloat(this.elements.folhasOffset?.value) || 0;
        const projetoCanva = parseFloat(this.elements.projetoCanva?.value) || 0;
        const trabalho = parseFloat(this.elements.trabalho?.value) || 0;
        
        console.log('[CALC] Iniciando cálculo com valores:', {
            tipo,
            folhasNormais,
            folhasOffset,
            projetoCanva,
            trabalho
        });
        
        if (!tipo) {
            this.elements.valorTotal.textContent = 'R$ 0,00';
            this.elements.totalBreakdown.innerHTML = '<div class="calculation-empty">Selecione o tipo de impressão e preencha os campos</div>';
            return 0;
        }
        
        const precoTipo = parseFloat(priceManager.getPrice(tipo)) || 0;
        const precoOffset = parseFloat(priceManager.getOffsetPrice()) || 0;
        
        const custoFolhasNormais = folhasNormais * precoTipo;
        const custoFolhasOffset = folhasOffset * precoOffset;
        
        const total = custoFolhasNormais + custoFolhasOffset + projetoCanva + trabalho;
        
        console.log('[CALC] Resultado do cálculo:', {
            precoTipo,
            precoOffset,
            custoFolhasNormais,
            custoFolhasOffset,
            total
        });
        
        this.elements.valorTotal.textContent = `R$ ${total.toFixed(2)}`;
        
        let breakdownHTML = '';
        
        if (folhasNormais > 0) {
            breakdownHTML += `
                <div class="calculation-item">
                    <span class="item-icon">📄</span>
                    <span class="item-formula">${folhasNormais} folhas × ${precoTipo.toFixed(2)}</span>
                    <span class="item-arrow">→</span>
                    <span class="item-result">${custoFolhasNormais.toFixed(2)}</span>
                </div>
            `;
        }
        
        if (folhasOffset > 0) {
            breakdownHTML += `
                <div class="calculation-item">
                    <span class="item-icon">🖨️</span>
                    <span class="item-formula">${folhasOffset} offset × ${precoOffset.toFixed(2)}</span>
                    <span class="item-arrow">→</span>
                    <span class="item-result">${custoFolhasOffset.toFixed(2)}</span>
                </div>
            `;
        }
        
        if (projetoCanva > 0) {
            breakdownHTML += `
                <div class="calculation-item">
                    <span class="item-icon">🎨</span>
                    <span class="item-formula">Projeto Canva</span>
                    <span class="item-arrow">→</span>
                    <span class="item-result">${projetoCanva.toFixed(2)}</span>
                </div>
            `;
        }
        
        if (trabalho > 0) {
            breakdownHTML += `
                <div class="calculation-item">
                    <span class="item-icon">💼</span>
                    <span class="item-formula">Trabalho</span>
                    <span class="item-arrow">→</span>
                    <span class="item-result">${trabalho.toFixed(2)}</span>
                </div>
            `;
        }
        
        if (breakdownHTML === '') {
            breakdownHTML = '<div class="calculation-empty">Informe os valores para ver o cálculo</div>';
        } else {
            breakdownHTML += `
                <div class="calculation-total-line">
                    <span class="total-label">Total</span>
                    <span class="total-arrow">→</span>
                    <span class="total-result">R$ ${total.toFixed(2)}</span>
                </div>
            `;
        }
        
        this.elements.totalBreakdown.innerHTML = breakdownHTML;
        
        return total;
    }
}

