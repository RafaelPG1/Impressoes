class PriceManager {
    constructor() {
        this.prices = {
            1: 0.50,
            2: 1.00,
            3: 1.50,
            4: 2.00
        };
        this.offsetPrice = 0.50;
        this.isUnlocked = false;
        this.priceChangeListeners = [];
        
        this.initializeElements();
        this.setupEventListeners();
        this.setupPriceFormatting();
    }

    initializeElements() {
        this.elements = {
            lockButton: document.getElementById('lockButton'),
            lockIcon: document.getElementById('lockIcon'),
            preco1: document.getElementById('preco1'),
            preco2: document.getElementById('preco2'),
            preco3: document.getElementById('preco3'),
            preco4: document.getElementById('preco4'),
            precoOffset: document.getElementById('precoOffset'),
            offsetPriceLabel: document.getElementById('offsetPriceLabel'),
            offsetPriceInfo: document.getElementById('offsetPriceInfo'),
            clearPricesBtn: document.getElementById('clearPricesBtn'),
            precoTipo: document.getElementById('precoTipo'),
            tipoImpressao: document.getElementById('tipoImpressao'),
            pricesCard: document.querySelector('.prices-card')
        };
    }

    onPriceChange(callback) {
        this.priceChangeListeners.push(callback);
    }

    notifyPriceChange() {
        console.log('[PRICE] Notificando listeners sobre mudança de preços');
        this.priceChangeListeners.forEach(callback => callback());
    }

    setupEventListeners() {
        this.elements.lockButton?.addEventListener('click', () => this.toggleLock());
        this.elements.clearPricesBtn?.addEventListener('click', () => this.confirmClearPrices());
        
        [this.elements.preco1, this.elements.preco2, this.elements.preco3, this.elements.preco4, this.elements.precoOffset].forEach(input => {
            input?.addEventListener('input', () => this.updatePricesFromInputs());
        });

        this.elements.tipoImpressao?.addEventListener('change', () => {
            console.log('[PRICE] Tipo de impressão alterado para:', this.elements.tipoImpressao.value);
            this.showTypePrice();
        });

        document.addEventListener('click', (e) => {
            if (this.isUnlocked && !this.elements.pricesCard.contains(e.target)) {
                this.autoLock();
            }
        });
    }

    setupPriceFormatting() {
        const priceInputs = [
            this.elements.preco1,
            this.elements.preco2,
            this.elements.preco3,
            this.elements.preco4,
            this.elements.precoOffset
        ];

        priceInputs.forEach(input => {
            if (!input) return;

            input.addEventListener('focus', (e) => {
                if (!this.isUnlocked) return;
                e.target.select();
            });

            input.addEventListener('click', (e) => {
                if (!this.isUnlocked) return;
                e.target.select();
            });

            input.addEventListener('blur', (e) => {
                if (!this.isUnlocked) return;
                
                let value = e.target.value;
                
                if (value === '' || value === '0' || value === '0.00') {
                    e.target.value = '0.50';
                } else {
                    const numericValue = parseFloat(value);
                    if (!isNaN(numericValue)) {
                        e.target.value = numericValue.toFixed(2);
                    }
                }
                
                this.updatePricesFromInputs();
            });
        });
    }

    updateInputs() {
        console.log('[PRICE] Atualizando inputs com preços:', this.prices, 'Offset:', this.offsetPrice);
        
        this.elements.preco1.value = this.prices[1].toFixed(2);
        this.elements.preco2.value = this.prices[2].toFixed(2);
        this.elements.preco3.value = this.prices[3].toFixed(2);
        this.elements.preco4.value = this.prices[4].toFixed(2);
        
        if (this.offsetPrice !== null) {
            this.elements.precoOffset.value = this.offsetPrice.toFixed(2);
            
            if (this.elements.offsetPriceLabel) {
                this.elements.offsetPriceLabel.textContent = `(+R$ ${this.offsetPrice.toFixed(2)}/un)`;
            }
            
            if (this.elements.offsetPriceInfo) {
                this.elements.offsetPriceInfo.textContent = `+R$ ${this.offsetPrice.toFixed(2)}`;
            }
        } else {
            this.elements.precoOffset.value = '—';
            
            if (this.elements.offsetPriceLabel) {
                this.elements.offsetPriceLabel.textContent = '(Carregando...)';
            }
            
            if (this.elements.offsetPriceInfo) {
                this.elements.offsetPriceInfo.textContent = '—';
            }
        }
    }

    updatePricesFromInputs() {
        if (!this.isUnlocked) return;
        
        const oldPrices = { ...this.prices };
        const oldOffsetPrice = this.offsetPrice;
        
        this.prices = {
            1: parseFloat(this.elements.preco1.value) || 0.50,
            2: parseFloat(this.elements.preco2.value) || 1.00,
            3: parseFloat(this.elements.preco3.value) || 1.50,
            4: parseFloat(this.elements.preco4.value) || 2.00
        };
        
        this.offsetPrice = parseFloat(this.elements.precoOffset.value) || 0.50;
        
        console.log('[PRICE] Preços atualizados de:', oldPrices, 'para:', this.prices);
        console.log('[PRICE] Offset atualizado de:', oldOffsetPrice, 'para:', this.offsetPrice);
        
        if (this.elements.offsetPriceLabel) {
            this.elements.offsetPriceLabel.textContent = `+R$ ${this.offsetPrice.toFixed(2)}/un`;
        }
        
        this.showTypePrice();
        if (typeof calculationManager !== 'undefined') {
            calculationManager.calculateTotal();
        }
    }

    async toggleLock() {
        this.isUnlocked = !this.isUnlocked;
        
        console.log('[PRICE] Toggle lock:', this.isUnlocked ? 'desbloqueado' : 'bloqueado');
        
        const inputs = [this.elements.preco1, this.elements.preco2, this.elements.preco3, this.elements.preco4, this.elements.precoOffset];
        
        if (this.isUnlocked) {
            inputs.forEach(input => input?.removeAttribute('readonly'));
            this.elements.lockIcon.className = 'fas fa-unlock';
            this.elements.lockButton.classList.add('unlocked');
        } else {
            inputs.forEach(input => input?.setAttribute('readonly', true));
            this.elements.lockIcon.className = 'fas fa-lock';
            this.elements.lockButton.classList.remove('unlocked');
            await this.savePrices();
        }
    }

    async autoLock() {
        if (!this.isUnlocked) return;
        
        console.log('[PRICE] Auto-lock acionado');
        this.isUnlocked = false;
        const inputs = [this.elements.preco1, this.elements.preco2, this.elements.preco3, this.elements.preco4, this.elements.precoOffset];
        inputs.forEach(input => input?.setAttribute('readonly', true));
        this.elements.lockIcon.className = 'fas fa-lock';
        this.elements.lockButton.classList.remove('unlocked');
        await this.savePrices();
    }

    async savePrices() {
        try {
            console.log('[PRICE] Salvando preços no Supabase:', this.prices, 'Offset:', this.offsetPrice);
            modernLoading.show();
            
            if (typeof supabaseManager !== 'undefined') {
                await supabaseManager.savePrices(this.prices, this.offsetPrice);
            }
            
            console.log('[PRICE] ✅ Preços salvos com sucesso');
            
            this.notifyPriceChange();
            
            modernAlert.success('Preços salvos com sucesso!');
            modernLoading.hide();
        } catch (error) {
            modernLoading.hide();
            console.error('[PRICE] ❌ Erro ao salvar preços:', error);
            modernAlert.error('Erro ao salvar preços');
        }
    }

    confirmClearPrices() {
        console.log('[PRICE] Confirmando reset de preços');
        if (typeof modalManager !== 'undefined') {
            modalManager.showConfirm(
                'Limpar Preços',
                'Resetar todos os preços?',
                () => this.clearPrices()
            );
        }
    }

    async clearPrices() {
        try {
            console.log('[PRICE] Resetando preços para valores padrão...');
            modernLoading.show();
            
            this.prices = {
                1: 0.50,
                2: 1.00,
                3: 1.50,
                4: 2.00
            };
            
            this.offsetPrice = 0.50;
            
            console.log('[PRICE] ✅ Preços resetados para:', this.prices, 'Offset:', this.offsetPrice);
            
            this.updateInputs();
            this.showTypePrice();
            
            if (typeof supabaseManager !== 'undefined') {
                await supabaseManager._syncResetPrices();
                console.log('[RESET] Preços resetados e enviados ao Supabase:', {
                    ...this.prices,
                    offset: this.offsetPrice
                });
            }
            
            this.notifyPriceChange();
            
            if (typeof calculationManager !== 'undefined') {
                calculationManager.calculateTotal();
            }
            
            modernAlert.success('Preços resetados com sucesso!');
            modernLoading.hide();
        } catch (error) {
            modernLoading.hide();
            console.error('[PRICE] ❌ Erro ao resetar preços:', error);
            modernAlert.error('Erro ao resetar preços');
        }
    }

    showTypePrice() {
        const tipo = this.elements.tipoImpressao?.value;
        if (tipo) {
            const preco = this.prices[parseInt(tipo)];
            console.log('[PRICE] Exibindo preço do tipo', tipo, ':', preco);
            this.elements.precoTipo.textContent = `R$ ${preco.toFixed(2)} por unidade`;
            this.elements.precoTipo.style.display = 'block';
        } else {
            this.elements.precoTipo.style.display = 'none';
        }
    }

    getPrice(type) {
        const price = this.prices[type] || 0;
        console.log('[PRICE] getPrice para tipo', type, ':', price);
        return price;
    }

    getOffsetPrice() {
        console.log('[PRICE] getOffsetPrice:', this.offsetPrice);
        return this.offsetPrice;
    }

    async loadFromSupabase() {
        try {
            console.log('[PRICE] Carregando preços do Supabase...');
            if (typeof supabaseManager !== 'undefined') {
                const pricesData = await supabaseManager.loadPrices();
                
                if (pricesData) {
                    this.prices = {
                        1: parseFloat(pricesData[1]) || 0.50,
                        2: parseFloat(pricesData[2]) || 1.00,
                        3: parseFloat(pricesData[3]) || 1.50,
                        4: parseFloat(pricesData[4]) || 2.00
                    };
                    
                    this.offsetPrice = parseFloat(pricesData[5]) || 0.50;
                    
                    this.updateInputs();
                    console.log('[PRICE] ✅ Preços carregados do Supabase:', this.prices, 'Offset:', this.offsetPrice);
                }
            }
        } catch (error) {
            console.error('[PRICE] ❌ Erro ao carregar preços do Supabase:', error);
            this.prices = {
                1: 0.50,
                2: 1.00,
                3: 1.50,
                4: 2.00
            };
            this.offsetPrice = 0.50;
            this.updateInputs();
        }
    }
}

