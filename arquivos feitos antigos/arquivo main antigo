class ModalHoldToClose {
    constructor() {
        this.holdDuration = 2000; // 2 segundos
        this.holdTimer = null;
        this.progressElement = null;
        this.currentModal = null;
        this.isHolding = false;
        this.init();
    }

    init() {
        // Encontra todos os modais
        const modalElements = document.querySelectorAll('.modal');
        
        modalElements.forEach(modalElement => {
            // Mouse Down - Inicia contagem
            modalElement.addEventListener('mousedown', (e) => {
                // Verifica se clicou no overlay (fundo escuro)
                if (e.target === modalElement) {
                    this.startHold(modalElement, e);
                }
            });

            // Mouse Up - Cancela contagem
            modalElement.addEventListener('mouseup', (e) => {
                this.cancelHold();
            });

            // Mouse Move - Cancela se mover muito
            modalElement.addEventListener('mousemove', (e) => {
                if (this.isHolding) {
                    // Se mover mais de 10px, cancela
                    const moveThreshold = 10;
                    const deltaX = Math.abs(e.clientX - this.startX);
                    const deltaY = Math.abs(e.clientY - this.startY);
                    
                    if (deltaX > moveThreshold || deltaY > moveThreshold) {
                        this.cancelHold();
                    }
                }
            });

            // Mouse Leave - Cancela se sair
            modalElement.addEventListener('mouseleave', () => {
                this.cancelHold();
            });
        });

        console.log('[MODAL HOLD] ✅ Sistema de segurar para fechar inicializado para', modalElements.length, 'modais');
    }

    startHold(modalElement, e) {
        this.isHolding = true;
        this.currentModal = modalElement;
        this.startX = e.clientX;
        this.startY = e.clientY;

        // Cria indicador de progresso
        this.createProgressIndicator(e.clientX, e.clientY);

        console.log('[MODAL HOLD] ⏱️ Iniciando contagem para fechar modal');

        // Inicia timer
        this.holdTimer = setTimeout(() => {
            this.closeModal(modalElement);
        }, this.holdDuration);

        // Anima progresso
        this.animateProgress();
    }

    cancelHold() {
        if (!this.isHolding) return;

        console.log('[MODAL HOLD] ❌ Contagem cancelada');

        this.isHolding = false;
        
        if (this.holdTimer) {
            clearTimeout(this.holdTimer);
            this.holdTimer = null;
        }

        if (this.progressElement) {
            this.progressElement.remove();
            this.progressElement = null;
        }

        this.currentModal = null;
    }

    createProgressIndicator(x, y) {
        // Remove indicador anterior se existir
        if (this.progressElement) {
            this.progressElement.remove();
        }

        // Cria novo indicador
        this.progressElement = document.createElement('div');
        this.progressElement.className = 'modal-hold-progress';
        this.progressElement.style.left = `${x}px`;
        this.progressElement.style.top = `${y}px`;
        
        this.progressElement.innerHTML = `
            <div class="hold-progress-circle">
                <svg class="progress-ring" width="60" height="60">
                    <circle class="progress-ring-circle" 
                            stroke="white" 
                            stroke-width="3" 
                            fill="transparent" 
                            r="26" 
                            cx="30" 
                            cy="30"/>
                </svg>
                <div class="hold-progress-icon">
                    <i class="fas fa-times"></i>
                </div>
            </div>
            <div class="hold-progress-text">Segure para fechar</div>
        `;

        document.body.appendChild(this.progressElement);
    }

    animateProgress() {
        const circle = this.progressElement?.querySelector('.progress-ring-circle');
        if (!circle) return;

        const radius = circle.r.baseVal.value;
        const circumference = radius * 2 * Math.PI;
        
        circle.style.strokeDasharray = `${circumference} ${circumference}`;
        circle.style.strokeDashoffset = circumference;

        // Força reflow
        circle.getBoundingClientRect();

        // Anima
        circle.style.transition = `stroke-dashoffset ${this.holdDuration}ms linear`;
        circle.style.strokeDashoffset = '0';
    }

    closeModal(modalElement) {
        const modalId = modalElement.id;
        
        console.log('[MODAL HOLD] ✅ Modal fechado após segurar:', modalId);

        // Remove indicador
        if (this.progressElement) {
            this.progressElement.remove();
            this.progressElement = null;
        }

        // Fecha o modal
        modalElement.style.display = 'none';

        // Limpa overflow do body se necessário
        const openModals = document.querySelectorAll('.modal[style*="display: block"]');
        if (openModals.length === 0) {
            document.body.style.overflow = '';
        }

        // Executa limpezas específicas por modal
        switch(modalId) {
            case 'paymentModal':
                if (window.paymentModalManager) {
                    window.paymentModalManager.resetModal();
                }
                break;
            
            case 'editModal':
                if (window.modalManager) {
                    window.modalManager.editingId = null;
                }
                break;
            
            case 'addModal':
                // Modal de adicionar já é limpo automaticamente
                break;
            
            case 'confirmModal':
                if (window.modalManager) {
                    window.modalManager.confirmCallback = null;
                }
                break;

            case 'paymentHistoryModal':
                if (window.paymentModalManager) {
                    window.paymentModalManager.closeHistoryModal();
                }
                break;
        }

        this.isHolding = false;
        this.currentModal = null;
    }
}

