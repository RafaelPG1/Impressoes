        this.isDown = false;
        this.startX = 0;
        this.scrollLeft = 0;
        this.velocity = 0;
        this.lastX = 0;
        this.lastTime = Date.now();

        this.init();
    }

    init() {
        // Mouse Down
        this.tableContainer.addEventListener('mousedown', (e) => {
            // Ignora se clicou em botão, link ou input
            if (e.target.tagName === 'BUTTON' || 
                e.target.tagName === 'A' || 
                e.target.tagName === 'INPUT' ||
                e.target.closest('button') ||
                e.target.closest('a')) {
                return;
            }

            this.isDown = true;
            this.tableContainer.style.userSelect = 'none';
            
            this.startX = e.pageX - this.tableContainer.offsetLeft;
            this.scrollLeft = this.tableContainer.scrollLeft;
            this.lastX = e.pageX;
            this.lastTime = Date.now();
            this.velocity = 0;

            // Previne seleção de texto
            e.preventDefault();
        });

        // Mouse Leave
        this.tableContainer.addEventListener('mouseleave', () => {
            if (this.isDown) {
                this.isDown = false;
                this.tableContainer.style.userSelect = '';
                this.applyInertia();
            }
        });

        // Mouse Up
        this.tableContainer.addEventListener('mouseup', () => {
            if (this.isDown) {
                this.isDown = false;
                this.tableContainer.style.userSelect = '';
                this.applyInertia();
            }
        });

        // Mouse Move
        this.tableContainer.addEventListener('mousemove', (e) => {
            if (!this.isDown) return;
            
            e.preventDefault();
            
            const x = e.pageX - this.tableContainer.offsetLeft;
            const walk = (x - this.startX) * 1.5; // Multiplicador para velocidade
            
            this.tableContainer.scrollLeft = this.scrollLeft - walk;

            // Calcula velocidade para inércia
            const currentTime = Date.now();
            const timeDiff = currentTime - this.lastTime;
            const distDiff = e.pageX - this.lastX;
            
            if (timeDiff > 0) {
                this.velocity = distDiff / timeDiff;
            }
            
            this.lastX = e.pageX;
            this.lastTime = currentTime;
        });

        // Touch events para mobile
        this.tableContainer.addEventListener('touchstart', (e) => {
            this.isDown = true;
            this.startX = e.touches[0].pageX - this.tableContainer.offsetLeft;
            this.scrollLeft = this.tableContainer.scrollLeft;
        }, { passive: true });

        this.tableContainer.addEventListener('touchend', () => {
            this.isDown = false;
        });

        this.tableContainer.addEventListener('touchmove', (e) => {
            if (!this.isDown) return;
            
            const x = e.touches[0].pageX - this.tableContainer.offsetLeft;
            const walk = (x - this.startX) * 1.5;
            this.tableContainer.scrollLeft = this.scrollLeft - walk;
        }, { passive: true });
    }

    applyInertia() {
        // Aplica efeito de inércia suave
        const friction = 0.95;
        let currentVelocity = this.velocity * 50; // Multiplica para efeito mais visível

        const animate = () => {
            if (Math.abs(currentVelocity) < 0.5) return;

            this.tableContainer.scrollLeft -= currentVelocity;
            currentVelocity *= friction;

            requestAnimationFrame(animate);
        };

        animate();
    }
}

