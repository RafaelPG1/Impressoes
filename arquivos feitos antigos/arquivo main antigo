// ===============================================
// CALENDÁRIO CUSTOMIZADO - DATETIME PICKER
// Corrigido: Layout em Grid + Display Minimalista
// ===============================================

class CustomDateTimePicker {
    constructor() {
        this.overlay = document.getElementById('customDateTimeOverlay');
        this.currentDate = new Date();
        this.selectedDate = new Date();
        this.targetInput = null;
        
        this.initializeElements();
        this.setupEventListeners();
        this.renderCalendar();
    }

    initializeElements() {
        this.elements = {
            overlay: document.getElementById('customDateTimeOverlay'),
            closeBtn: document.getElementById('closeDateTimePicker'),
            cancelBtn: document.getElementById('cancelDateTime'),
            confirmBtn: document.getElementById('confirmDateTime'),
            prevMonth: document.getElementById('prevMonth'),
            nextMonth: document.getElementById('nextMonth'),
            currentMonth: document.getElementById('currentMonth'),
            calendarDays: document.getElementById('calendarDays'),
            selectedDateDisplay: document.getElementById('selectedDateDisplay'),
            hourInput: document.getElementById('hourInput'),
            minuteInput: document.getElementById('minuteInput'),
            nowBtn: document.getElementById('setNowBtn')
        };
        
        // Verificar se todos os elementos foram encontrados
        const missingElements = Object.entries(this.elements)
            .filter(([key, value]) => !value)
            .map(([key]) => key);
        
        if (missingElements.length > 0) {
            console.error('❌ Elementos não encontrados:', missingElements);
        }
    }

    setupEventListeners() {
        // Fechar overlay
        this.elements.closeBtn.addEventListener('click', () => this.close());
        this.elements.cancelBtn.addEventListener('click', () => this.close());
        this.elements.overlay.addEventListener('click', (e) => {
            if (e.target === this.elements.overlay) this.close();
        });

        // Navegação
        this.elements.prevMonth.addEventListener('click', () => this.changeMonth(-1));
        this.elements.nextMonth.addEventListener('click', () => this.changeMonth(1));

        // Confirmar
        this.elements.confirmBtn.addEventListener('click', () => this.confirm());
        
        // Botão "Agora"
        this.elements.nowBtn.addEventListener('click', () => this.setNow());

        // Sistema de digitação sequencial para hora e minuto
        this.setupTimeInputBehavior(this.elements.hourInput, 23);
        this.setupTimeInputBehavior(this.elements.minuteInput, 59);

        // ESC para fechar
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && this.overlay.classList.contains('show')) {
                this.close();
            }
        });

        // Interceptar cliques em inputs datetime-local
        this.interceptDateTimeInputs();
    }

    setupTimeInputBehavior(input, maxValue) {
        let digitBuffer = '';
        let lastInputTime = 0;
        let isComplete = false; // Flag para indicar quando completou 2 dígitos

        input.addEventListener('click', (e) => {
            e.target.select();
            digitBuffer = '';
            isComplete = false;
        });

        input.addEventListener('focus', (e) => {
            e.target.select();
            digitBuffer = '';
            isComplete = false;
        });

        input.addEventListener('keydown', (e) => {
            const currentTime = Date.now();
            
            // Se passou mais de 1 segundo desde o último dígito, reseta o buffer
            if (currentTime - lastInputTime > 1000) {
                digitBuffer = '';
                isComplete = false;
            }
            
            // Apenas números são permitidos
            if (e.key >= '0' && e.key <= '9') {
                e.preventDefault();
                
                const digit = e.key;
                
                // Se já completou 2 dígitos, APENAS zera e espera próxima digitação
                if (isComplete) {
                    // Micro-animação visual de reset
                    input.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        input.style.transform = 'scale(1)';
                    }, 100);
                    
                    digitBuffer = '';
                    isComplete = false;
                    input.value = '00';
                    lastInputTime = currentTime;
                    this.updateSelectedDisplay();
                    return; // PARA AQUI - não processa o dígito ainda
                }
                
                // Se o buffer está vazio, adiciona o primeiro dígito
                if (digitBuffer === '') {
                    digitBuffer = digit;
                    input.value = digitBuffer.padStart(2, '0');
                } else {
                    // Adiciona o segundo dígito
                    digitBuffer += digit;
                    let value = parseInt(digitBuffer);
                    
                    // Valida o valor máximo
                    if (value > maxValue) {
                        // Se ultrapassar, zera e reseta
                        digitBuffer = '';
                        isComplete = false;
                        input.value = '00';
                    } else {
                        input.value = value.toString().padStart(2, '0');
                        // Marca como completo após 2 dígitos válidos
                        isComplete = true;
                    }
                }
                
                lastInputTime = currentTime;
                this.updateSelectedDisplay();
            } else if (e.key === 'Backspace' || e.key === 'Delete') {
                e.preventDefault();
                digitBuffer = '';
                isComplete = false;
                input.value = '00';
                this.updateSelectedDisplay();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                let value = parseInt(input.value) || 0;
                value = (value + 1) > maxValue ? 0 : value + 1;
                input.value = value.toString().padStart(2, '0');
                digitBuffer = '';
                isComplete = false;
                this.updateSelectedDisplay();
            } else if (e.key === 'ArrowDown') {
                e.preventDefault();
                let value = parseInt(input.value) || 0;
                value = (value - 1) < 0 ? maxValue : value - 1;
                input.value = value.toString().padStart(2, '0');
                digitBuffer = '';
                isComplete = false;
                this.updateSelectedDisplay();
            } else if (e.key !== 'Tab') {
                // Bloqueia outras teclas exceto Tab
                e.preventDefault();
            }
        });

        // Remove o evento de input padrão
        input.addEventListener('input', (e) => {
            e.preventDefault();
        });
        
        // Adiciona transição suave para a animação
        input.style.transition = 'transform 0.1s ease';
    }


    interceptDateTimeInputs() {
        // Encontra todos os inputs datetime-local
        document.querySelectorAll('input[type="datetime-local"]').forEach(input => {
            // Remove o comportamento padrão
            input.addEventListener('click', (e) => {
                e.preventDefault();
                this.open(input);
            });

            // Previne abertura do calendário nativo ao focar
            input.addEventListener('focus', (e) => {
                e.preventDefault();
                input.blur();
                this.open(input);
            });
        });
    }

    open(inputElement) {
        this.targetInput = inputElement;
        
        // Carrega a data do input se existir
        if (inputElement.value) {
            const date = new Date(inputElement.value);
            this.selectedDate = date;
            this.currentDate = new Date(date);
            this.elements.hourInput.value = date.getHours().toString().padStart(2, '0');
            this.elements.minuteInput.value = date.getMinutes().toString().padStart(2, '0');
        } else {
            // Usa data/hora atual
            const now = new Date();
            this.selectedDate = now;
            this.currentDate = new Date(now);
            this.elements.hourInput.value = now.getHours().toString().padStart(2, '0');
            this.elements.minuteInput.value = now.getMinutes().toString().padStart(2, '0');
        }
        
        this.renderCalendar();
        this.updateSelectedDisplay();
        this.overlay.classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    close() {
        this.overlay.classList.remove('show');
        document.body.style.overflow = '';
        this.targetInput = null;
    }

    changeMonth(direction) {
        this.currentDate.setMonth(this.currentDate.getMonth() + direction);
        this.renderCalendar();
    }

    renderCalendar() {
        const year = this.currentDate.getFullYear();
        const month = this.currentDate.getMonth();
        
        // Atualizar header do mês
        const monthNames = ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho',
                           'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
        this.elements.currentMonth.textContent = `${monthNames[month]} ${year}`;
        
        // Limpar dias anteriores
        this.elements.calendarDays.innerHTML = '';
        
        // Primeiro dia do mês (0 = Domingo, 6 = Sábado)
        const firstDay = new Date(year, month, 1).getDay();
        
        // Último dia do mês
        const lastDay = new Date(year, month + 1, 0).getDate();
        
        // Último dia do mês anterior
        const prevLastDay = new Date(year, month, 0).getDate();
        
        // Dias do mês anterior (células vazias no início)
        for (let i = firstDay - 1; i >= 0; i--) {
            const dayBtn = this.createDayButton(prevLastDay - i, true);
            this.elements.calendarDays.appendChild(dayBtn);
        }
        
        // Dias do mês atual
        const today = new Date();
        for (let day = 1; day <= lastDay; day++) {
            const isToday = day === today.getDate() && 
                           month === today.getMonth() && 
                           year === today.getFullYear();
            
            const isSelected = day === this.selectedDate.getDate() && 
                              month === this.selectedDate.getMonth() && 
                              year === this.selectedDate.getFullYear();
            
            const dayBtn = this.createDayButton(day, false, isToday, isSelected);
            dayBtn.addEventListener('click', () => this.selectDate(day));
            this.elements.calendarDays.appendChild(dayBtn);
        }
        
        // Dias do próximo mês (completar o grid)
        const totalCells = this.elements.calendarDays.children.length;
        const remainingCells = 42 - totalCells; // 6 semanas * 7 dias
        for (let day = 1; day <= remainingCells; day++) {
            const dayBtn = this.createDayButton(day, true);
            this.elements.calendarDays.appendChild(dayBtn);
        }
    }

    createDayButton(day, isOtherMonth, isToday = false, isSelected = false) {
        const button = document.createElement('button');
        button.className = 'calendar-day';
        button.textContent = day;
        button.type = 'button';
        
        if (isOtherMonth) {
            button.classList.add('other-month');
            button.disabled = true;
        }
        
        if (isToday) button.classList.add('today');
        if (isSelected) button.classList.add('selected');
        
        return button;
    }

    selectDate(day) {
        this.selectedDate.setFullYear(this.currentDate.getFullYear());
        this.selectedDate.setMonth(this.currentDate.getMonth());
        this.selectedDate.setDate(day);
        
        this.renderCalendar();
        this.updateSelectedDisplay();
    }

    updateSelectedDisplay() {
        const weekdays = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
        const months = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun',
                       'jul', 'ago', 'set', 'out', 'nov', 'dez'];
        
        const weekday = weekdays[this.selectedDate.getDay()];
        const month = months[this.selectedDate.getMonth()];
        const day = this.selectedDate.getDate();
        const hour = this.elements.hourInput.value.padStart(2, '0');
        const minute = this.elements.minuteInput.value.padStart(2, '0');
        
        // Formato minimalista: Sex • 5 dez • 00:00
        this.elements.selectedDateDisplay.textContent = 
            `${weekday} • ${day} ${month} • ${hour}:${minute}`;
    }

    validateHour(e) {
        let value = parseInt(e.target.value);
        if (isNaN(value) || value < 0) value = 0;
        if (value > 23) value = 23;
        e.target.value = value.toString().padStart(2, '0');
    }

    validateMinute(e) {
        let value = parseInt(e.target.value);
        if (isNaN(value) || value < 0) value = 0;
        if (value > 59) value = 59;
        e.target.value = value.toString().padStart(2, '0');
    }

    setNow() {
        const now = new Date();
        
        // Atualizar data selecionada
        this.selectedDate = now;
        this.currentDate = new Date(now);
        
        // Atualizar hora
        this.elements.hourInput.value = now.getHours().toString().padStart(2, '0');
        this.elements.minuteInput.value = now.getMinutes().toString().padStart(2, '0');
        
        // Renderizar calendário e atualizar display
        this.renderCalendar();
        this.updateSelectedDisplay();
    }

    confirm() {
        if (!this.targetInput) return;
        
        // Criar data completa com hora
        const year = this.selectedDate.getFullYear();
        const month = (this.selectedDate.getMonth() + 1).toString().padStart(2, '0');
        const day = this.selectedDate.getDate().toString().padStart(2, '0');
        const hour = this.elements.hourInput.value.padStart(2, '0');
        const minute = this.elements.minuteInput.value.padStart(2, '0');
        
        // Formato: YYYY-MM-DDTHH:MM
        const dateTimeString = `${year}-${month}-${day}T${hour}:${minute}`;
        
        // Atualizar input
        this.targetInput.value = dateTimeString;
        
        // Disparar evento de mudança para que outros sistemas detectem
        const event = new Event('change', { bubbles: true });
        this.targetInput.dispatchEvent(event);
        
        // Fechar calendário
        this.close();
    }
}

