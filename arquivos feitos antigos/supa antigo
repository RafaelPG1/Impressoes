    _calcularPagamentoDia(restoDia, pagamento) {
        if (pagamento >= restoDia) {
            return {
                pago: restoDia,
                resto: 0,
                pagamentoUsado: restoDia,
                status: "pago"
            };
        }

        return {
            pago: pagamento,
            resto: restoDia - pagamento,
            pagamentoUsado: pagamento,
            status: "parcial"
        };
    }

    async _syncApplyPayment({ clienteId, valorPagamento, impressoesIds = null }) {
        try {
            console.log("\n" + "=".repeat(50));
            console.log("[PAGAMENTO] Valor pago recebido:", valorPagamento);
            console.log("[PAGAMENTO] Cliente ID:", clienteId);
            console.log("=".repeat(50) + "\n");

            const valorPagoOriginal = Number(valorPagamento);
            let pagamentoRestante = valorPagoOriginal;

            console.log("[BUSCA] Carregando dias pendentes ordenados...");
            
            let query = this.supabase
                .from('impressoes')
                .select('*')
                .eq('cliente_id', clienteId)
                .gt('valor_restante', 0);

            if (impressoesIds && impressoesIds.length > 0) {
                query = query.in('id', impressoesIds);
                console.log("[BUSCA] Modo MANUAL - IDs:", impressoesIds);
            }

            const { data: dias, error: fetchError } = await query
                .order('valor_restante', { ascending: true })
                .order('data_impressao', { ascending: true });

            if (fetchError) {
                console.error("[BUSCA] ❌ Erro:", fetchError);
                throw fetchError;
            }

            if (!dias || dias.length === 0) {
                console.log("[BUSCA] ⚠️ Nenhum dia pendente");
                return {
                    pagamento: null,
                    totalUsado: 0,
                    totalSobrando: pagamentoRestante,
                    detalhes: [],
                    diasAtualizados: []
                };
            }

            console.log("[BUSCA] ✅ Total de dias pendentes:", dias.length);
            dias.forEach((dia, idx) => {
                console.log(`  ${idx + 1}. Dia ${idx + 1} = R$ ${Number(dia.valor_restante).toFixed(2)}`);
            });

            console.log("\n[REGISTRO] Criando registro de pagamento...");
            
            const { data: pagamento, error: pagamentoError } = await this.supabase
                .from('pagamentos')
                .insert({
                    cliente_id: clienteId,
                    valor_total: valorPagoOriginal,
                    tipo_aplicacao: impressoesIds ? 'manual' : 'automatico',
                    observacao: 'Pagamento aplicado',
                    data_pagamento: new Date().toISOString()
                })
                .select()
                .single();

            if (pagamentoError) {
                console.error("[REGISTRO] ❌ Erro:", pagamentoError);
                throw pagamentoError;
            }

            console.log("[REGISTRO] ✅ Pagamento ID:", pagamento.id.substring(0, 8) + "...");

            console.log("\n[LOOP] Iniciando processamento dos dias...");
            console.log("Payment = " + pagamentoRestante);
            console.log("");

            const detalhes = [];
            const diasAtualizados = [];
            let diaNumero = 0;

            for (const dia of dias) {
                if (pagamentoRestante <= 0) {
                    console.log("[LOOP] ⚠️ Dinheiro acabou, parando loop");
                    break;
                }

                diaNumero++;
                const restoDia = Number(dia.valor_restante);
                const pagoAntes = Number(dia.valor_pago);

                console.log(`Dia ${diaNumero} = ${restoDia.toFixed(2)}`);
                console.log(`Payment = ${pagamentoRestante.toFixed(2)}`);

                const resultado = this._calcularPagamentoDia(restoDia, pagamentoRestante);

                console.log(`${pagamentoRestante.toFixed(2)} ${pagamentoRestante >= restoDia ? '>=' : '<'} ${restoDia.toFixed(2)} → ${resultado.status === 'pago' ? 'paga dia completo' : 'pagamento parcial'}`);
                console.log(`pago = ${resultado.pago.toFixed(2)}`);
                console.log(`resto = ${resultado.resto.toFixed(2)}`);
                console.log(`status = ${resultado.status}`);

                pagamentoRestante -= resultado.pagamentoUsado;
                console.log(`payment = ${pagamentoRestante.toFixed(2)}`);

                const novoValorPago = pagoAntes + resultado.pago;
                let dataPrimeiroPagamento = dia.data_primeiro_pagamento;
                let dataQuitacao = null;

                if (!dataPrimeiroPagamento && novoValorPago > 0) {
                    dataPrimeiroPagamento = new Date().toISOString();
                }

                if (resultado.status === 'pago') {
                    dataQuitacao = new Date().toISOString();
                }

                const updateData = {
                    valor_pago: novoValorPago,
                    status_pagamento: resultado.status === 'pago' ? 'pago' : (novoValorPago > 0 ? 'parcial' : 'pendente'),
                    data_primeiro_pagamento: dataPrimeiroPagamento
                };

                if (dataQuitacao) {
                    updateData.data_quitacao = dataQuitacao;
                }

                const { error: updateError } = await this.supabase
                    .from('impressoes')
                    .update(updateData)
                    .eq('id', dia.id);

                if (updateError) {
                    console.error("[LOOP] ❌ Erro ao atualizar dia:", updateError);
                    throw updateError;
                }

                console.log("[LOOP] ✅ Dia atualizado com sucesso");

                const { error: relacaoError } = await this.supabase
                    .from('pagamentos_impressoes')
                    .insert({
                        pagamento_id: pagamento.id,
                        impressao_id: dia.id,
                        valor_aplicado: resultado.pagamentoUsado
                    });

                if (relacaoError) {
                    console.error("[LOOP] ❌ Erro ao criar relação:", relacaoError);
                    throw relacaoError;
                }

                detalhes.push({
                    dia: diaNumero,
                    impressao_id: dia.id,
                    valor_aplicado: resultado.pagamentoUsado,
                    pagoAntes: pagoAntes,
                    pagoDepois: novoValorPago,
                    restoAntes: restoDia,
                    restoDepois: resultado.resto,
                    status: resultado.status
                });

                diasAtualizados.push({
                    ...dia,
                    ...updateData
                });

                console.log("");

                if (resultado.status === 'parcial') {
                    console.log("⚠️ Loop parou - pagamento parcial realizado\n");
                    break;
                }
            }

            const totalUsado = valorPagoOriginal - pagamentoRestante;

            console.log("=".repeat(50));
            console.log("[FINAL] ✅ Pagamento concluído!");
            console.log(`[FINAL] Valor pago pelo cliente: R$ ${valorPagoOriginal.toFixed(2)}`);
            console.log(`[FINAL] Valor usado: R$ ${totalUsado.toFixed(2)}`);
            console.log(`[FINAL] Valor sobrando: R$ ${pagamentoRestante.toFixed(2)}`);
            console.log(`[FINAL] Dias processados: ${diaNumero}`);
            console.log("=".repeat(50) + "\n");

            return {
                pagamento: pagamento,
                totalUsado: totalUsado,
                totalSobrando: pagamentoRestante,
                detalhes: detalhes,
                diasAtualizados: diasAtualizados
            };

        } catch (error) {
            console.error("\n" + "=".repeat(50));
            console.error("[ERRO CRÍTICO] ❌ Falha no processamento");
            console.error("[ERRO]", error.message || error);
            console.error("=".repeat(50) + "\n");
            throw error;
        }
    }

    async _syncRemovePayment({ paymentId, clienteId }) {
        try {
            console.log("\n" + "=".repeat(50));
            console.log("[REMOVE] Removendo pagamento:", paymentId);
            console.log("[REMOVE] Cliente ID:", clienteId);
            console.log("=".repeat(50) + "\n");

