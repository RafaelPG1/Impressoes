                .select('*')
                .eq('cliente_id', clienteId);

            if (fetchError) throw fetchError;

            console.log(`[REMOVE] Total de impressões do cliente: ${impressoes.length}`);

            console.log("[REMOVE] Resetando todas as impressões...");

            for (const impressao of impressoes) {
                const { error: resetError } = await this.supabase
                    .from('impressoes')
                    .update({
                        valor_pago: 0,
                        status_pagamento: 'pendente',
                        data_primeiro_pagamento: null,
                        data_quitacao: null
                    })
                    .eq('id', impressao.id);

                if (resetError) throw resetError;
            }

            console.log("[REMOVE] ✅ Todas as impressões resetadas");

            const { error: deleteError } = await this.supabase
                .from('pagamentos')
                .delete()
                .eq('id', paymentId);

            if (deleteError) throw deleteError;

            console.log("[REMOVE] ✅ Pagamento deletado");

            const { data: pagamentosRestantes, error: pagamentosError } = await this.supabase
                .from('pagamentos')
                .select('*')
                .eq('cliente_id', clienteId)
                .order('data_pagamento', { ascending: true });

            if (pagamentosError) throw pagamentosError;

            console.log(`[REMOVE] Pagamentos restantes: ${pagamentosRestantes.length}`);

            if (pagamentosRestantes.length > 0) {
                console.log("[REMOVE] Reprocessando pagamentos restantes...");

                for (const pagamento of pagamentosRestantes) {
                    console.log(`[REMOVE] Reaplicando pagamento de R$ ${pagamento.valor_total}`);

                    const { data: impressoesAssociadas } = await this.supabase
                        .from('pagamentos_impressoes')
                        .select('impressao_id')
                        .eq('pagamento_id', pagamento.id);

                    const impressoesIds = impressoesAssociadas?.map(p => p.impressao_id) || null;

                    await this.supabase
                        .from('pagamentos_impressoes')
                        .delete()
                        .eq('pagamento_id', pagamento.id);

                    await this.supabase
                        .from('pagamentos')
                        .delete()
                        .eq('id', pagamento.id);

                    await this._syncApplyPayment({
                        clienteId: clienteId,
                        valorPagamento: pagamento.valor_total,
                        impressoesIds: impressoesIds
                    });
                }

                console.log("[REMOVE] ✅ Todos os pagamentos reaplicados");
            }

            console.log("=".repeat(50));
            console.log("[REMOVE] ✅ Remoção concluída com sucesso!");
            console.log("=".repeat(50) + "\n");

            return true;

        } catch (error) {
            console.error("\n" + "=".repeat(50));
            console.error("[REMOVE] ❌ Erro ao remover pagamento");
            console.error("[REMOVE]", error.message || error);
            console.error("=".repeat(50) + "\n");
            throw error;
        }
    }

    async _syncSavePrices({ prices, offsetPrice }) {
        const updates = Object.entries(prices).map(([tipo, valor]) => ({
            tipo: parseInt(tipo),
            valor: parseFloat(valor)
        }));

        for (const update of updates) {
            const { error } = await this.supabase
                .from('precos')
                .update({ valor: update.valor })
                .eq('tipo', update.tipo);

            if (error) throw error;
        }
        
        const { error: offsetError } = await this.supabase
            .from('precos')
            .upsert({ 
                tipo: 5, 
                valor: parseFloat(offsetPrice),
                descricao: 'Folha Offset'
            }, { onConflict: 'tipo' });

        if (offsetError) throw offsetError;

        return true;
    }

    async _syncResetPrices() {
        const defaultPrices = [
            { tipo: 1, valor: 0.50, descricao: 'Xerox P&B' },
            { tipo: 2, valor: 1.00, descricao: 'Xerox Colorido' },
            { tipo: 3, valor: 1.50, descricao: 'Digital P&B' },
            { tipo: 4, valor: 2.00, descricao: 'Digital Colorido' },
            { tipo: 5, valor: 0.50, descricao: 'Folha Offset' }
        ];

        for (const price of defaultPrices) {
            const { error } = await this.supabase
                .from('precos')
                .upsert({ 
                    tipo: price.tipo, 
                    valor: price.valor,
                    descricao: price.descricao
                }, { onConflict: 'tipo' });

            if (error) throw error;
        }

        return true;
    }

    async loadImpressions() {
        if (!this.isConfigured) return [];

        try {
            const { data, error } = await this.supabase
                .from('impressoes')
                .select(`
                    *,
                    clientes (
                        id,
                        nome,
                        telefone
                    )
                `)
                .order('created_at', { ascending: false });

            if (error) throw error;

            return data.map(item => ({
                id: item.id,
                cliente: item.clientes?.nome || 'Desconhecido',
                clienteId: item.cliente_id,
                tipoImpressao: item.tipo_impressao,
                tipoPreco: item.tipo_preco,
                folhasNormais: item.folhas_normais,
                folhasOffset: item.folhas_offset,
                projetoCanva: parseFloat(item.projeto_canva || 0),
                trabalho: parseFloat(item.trabalho || 0),
                valorTotal: parseFloat(item.valor_total),
                valorPago: parseFloat(item.valor_pago || 0),
                valorRestante: parseFloat(item.valor_restante || 0),
                statusPagamento: item.status_pagamento || 'pendente',
                dataHora: item.data_impressao || item.data_hora || item.created_at,
                timestamp: new Date(item.created_at).getTime()
            }));
        } catch (error) {
            console.error('Erro ao carregar impressões:', error);
            return [];
        }
    }

    async loadClientsSummary() {
        if (!this.isConfigured) return [];

        try {
            const { data: impressoes, error: impressoesError } = await this.supabase
                .from('impressoes')
                .select('id')
                .limit(1);

            if (impressoesError) throw impressoesError;

            if (!impressoes || impressoes.length === 0) {
                return [];
            }

            const { data, error } = await this.supabase
                .from('vw_resumo_clientes')
                .select('*')
                .order('saldo_devedor', { ascending: false });

            if (error) throw error;

            const resumoFiltrado = data.filter(item => item.total_compras > 0);

            return resumoFiltrado.map(item => ({
                id: item.id,
                cliente: item.cliente,
                telefone: item.telefone,
                valorAcumulado: parseFloat(item.valor_acumulado || 0),
                totalCompras: parseInt(item.total_compras || 0),
                folhasNormais: parseInt(item.folhas_normais || 0),
                folhasOffset: parseInt(item.folhas_offset || 0),
                saldoDevedor: parseFloat(item.saldo_devedor || 0),
                valorPagoTotal: parseFloat(item.valor_pago_total || 0)
            }));
        } catch (error) {
            console.error('Erro ao carregar resumo:', error);
            return [];
        }
    }

    async loadPrices() {
        if (!this.isConfigured) return null;

        try {
            const { data, error } = await this.supabase
                .from('precos')
                .select('*')
                .order('tipo', { ascending: true });

            if (error) throw error;

            const prices = {};
            data.forEach(item => {
                prices[item.tipo] = parseFloat(item.valor);
            });

            return prices;
        } catch (error) {
            console.error('Erro ao carregar preços:', error);
            return null;
        }
    }

    subscribeToImpressions(callback) {
        if (!this.isConfigured) return null;

        const channel = this.supabase
            .channel('impressoes_changes')
            .on('postgres_changes', 
                { event: '*', schema: 'public', table: 'impressoes' },
                async () => {
                    const impressions = await this.loadImpressions();
                    callback(impressions);
                }
            )
            .subscribe();

        return channel;
    }

    async _getOrCreateCliente(nome, telefone = null) {
        if (!nome || typeof nome !== 'string' || nome.trim() === '') {
            throw new Error('Nome do cliente é obrigatório');
        }

        const nomeCliente = nome.trim();
        const tel = telefone || `Aguardando cadastro - ${nomeCliente}`;
        
        let { data: cliente, error } = await this.supabase
            .from('clientes')
            .select('*')
            .eq('nome', nomeCliente)
            .maybeSingle();

        if (!cliente) {
            const { data: novoCliente, error: createError } = await this.supabase
                .from('clientes')
                .insert({ 
                    nome: nomeCliente, 
                    telefone: tel 
                })
                .select()
                .single();

            if (createError) throw createError;
            return novoCliente;
        }

        if (error) throw error;
        return cliente;
    }

    async cleanupOrphanedClients() {
        if (!this.isConfigured) return false;

        try {
            const { data: clientes, error: clientesError } = await this.supabase
                .from('clientes')
                .select('id');

            if (clientesError) throw clientesError;

            for (const cliente of clientes) {
                const { data: impressoes, error: impressoesError } = await this.supabase
                    .from('impressoes')
                    .select('id')
                    .eq('cliente_id', cliente.id)
                    .limit(1);

                if (impressoesError) throw impressoesError;

                if (!impressoes || impressoes.length === 0) {
                    await this.supabase
                        .from('clientes')
                        .delete()
                        .eq('id', cliente.id);
                }
            }

            return true;
        } catch (error) {
            console.error('Erro ao limpar clientes órfãos:', error);
            return false;
        }
    }

    async redistributePayment(clienteId, valorARedistribuir) {
        if (!this.isConfigured) return false;

        try {
            const { data: impressoes, error: fetchError } = await this.supabase
                .from('impressoes')
                .select('*')
                .eq('cliente_id', clienteId)
                .neq('status_pagamento', 'pago')
                .order('data_impressao', { ascending: true });

            if (fetchError) throw fetchError;

            if (!impressoes || impressoes.length === 0) {
                return true;
            }

            let valorRestante = valorARedistribuir;

            for (const impressao of impressoes) {
                if (valorRestante <= 0) break;

                const valorDevedor = parseFloat(impressao.valor_total) - parseFloat(impressao.valor_pago);
                const valorAplicar = Math.min(valorRestante, valorDevedor);
                const novoValorPago = parseFloat(impressao.valor_pago) + valorAplicar;
                const novoStatus = novoValorPago >= parseFloat(impressao.valor_total) ? 'pago' : 'parcial';

                const { error: updateError } = await this.supabase
                    .from('impressoes')
                    .update({
                        valor_pago: novoValorPago,
                        status_pagamento: novoStatus
                    })
                    .eq('id', impressao.id);

                if (updateError) throw updateError;

                valorRestante -= valorAplicar;
            }

            return true;
        } catch (error) {
            console.error('Erro ao redistribuir pagamento:', error);
            return false;
        }
    }

    getSyncStatus() {
        return {
            queueSize: this.syncQueue.length,
            isSyncing: this.isSyncing,
            isConfigured: this.isConfigured
        };
    }
}

export const supabaseManager = new SupabaseManager();