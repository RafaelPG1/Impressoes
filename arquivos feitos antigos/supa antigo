    async _syncAddImpression(impressionData) {
        const cliente = await this._getOrCreateCliente(impressionData.cliente);
        
        if (!cliente || !cliente.id) {
            throw new Error('Erro ao obter/criar cliente');
        }

        const dataToInsert = {
            cliente_id: cliente.id,
            tipo_preco: impressionData.tipoPreco,
            folhas_normais: impressionData.folhasNormais,
            folhas_offset: impressionData.folhasOffset,
            projeto_canva: impressionData.projetoCanva || 0,
            trabalho: impressionData.trabalho || 0,
            valor_total: impressionData.valorTotal,
            valor_pago: impressionData.valorPago || 0,
            status_pagamento: impressionData.statusPagamento || 'pendente',
            data_impressao: impressionData.dataHora || new Date().toISOString()
        };

        if (impressionData.tipoImpressao && impressionData.tipoImpressao !== 0) {
            dataToInsert.tipo_impressao = impressionData.tipoImpressao;
        }

        const { data, error } = await this.supabase
            .from('impressoes')
            .insert([dataToInsert])
            .select()
            .single();

        if (error) throw error;
        return data;
    }

