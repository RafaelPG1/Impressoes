    addToSyncQueue(operation) {
        const queueItem = {
            id: `sync_${Date.now()}_${Math.random()}`,
            operation,
            timestamp: Date.now(),
            retries: 0
        };
        
        this.syncQueue.push(queueItem);
        this.processSyncQueue();
        
        return queueItem.id;
    }

    async processSyncQueue() {
        if (!this.isConfigured || this.isSyncing || this.syncQueue.length === 0) {
            return;
        }

        this.isSyncing = true;

        while (this.syncQueue.length > 0) {
            const item = this.syncQueue[0];
            
            try {
                await this.executeOperation(item.operation);
                this.syncQueue.shift();
                this.retryAttempts[item.id] = 0;
            } catch (error) {
                console.error('Erro na sincronização:', error);
                
                item.retries++;
                
                if (item.retries >= this.maxRetries) {
                    console.error('Máximo de tentativas atingido, removendo da fila:', item.operation);
                    this.syncQueue.shift();
                    
                    if (window.modernAlert) {
                        window.modernAlert.warning('Alguns dados não foram sincronizados');
                    }
                } else {
                    this.syncQueue.push(this.syncQueue.shift());
                    await new Promise(resolve => setTimeout(resolve, 1000 * item.retries));
                }
            }
        }

        this.isSyncing = false;
    }

    startSyncWorker() {
        setInterval(() => {
            this.processSyncQueue();
        }, 5000);
    }

    async executeOperation(operation) {
        const { type, data } = operation;

        switch (type) {
            case 'ADD_IMPRESSION':
                return await this._syncAddImpression(data);
            case 'UPDATE_IMPRESSION':
                return await this._syncUpdateImpression(data);
            case 'DELETE_IMPRESSION':
                return await this._syncDeleteImpression(data);
            case 'CLEAR_ALL':
                return await this._syncClearAll();
            case 'APPLY_PAYMENT':
                return await this._syncApplyPayment(data);
            case 'SAVE_PRICES':
                return await this._syncSavePrices(data);
            case 'RESET_PRICES':
                return await this._syncResetPrices();
            case 'REMOVE_PAYMENT':
                return await this._syncRemovePayment(data);
            default:
                throw new Error(`Operação desconhecida: ${type}`);
        }
    }

