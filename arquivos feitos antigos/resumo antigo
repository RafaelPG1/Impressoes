// resumoClientes.js - VERSÃO CORRIGIDA COM CUSTOM SELECT
import { supabaseManager } from './supabase.js';

// ===============================
// RENDERIZAÇÃO DO RESUMO DE CLIENTES
// ===============================

export async function carregarResumoClientes(options = {}) {
    const {
        containerId = 'resumoClientes',
        orderBy = 'saldo_devedor',
        ascending = false
    } = options;

    const container = document.getElementById(containerId);
    
    if (!container) {
        console.error(`Container ${containerId} não encontrado`);
        return;
    }

    if (!supabaseManager.isConfigured) {
        container.innerHTML = `
            <div class="empty-state">
                <i class="fas fa-exclamation-triangle"></i>
                <p>Supabase não configurado</p>
            </div>
        `;
        return;
    }

    try {
        let resumo = await supabaseManager.loadClientsSummary();

        if (!resumo || resumo.length === 0) {
            container.innerHTML = `
                <div class="empty-state">
                    <i class="fas fa-users"></i>
                    <p>Nenhum cliente com impressões ainda</p>
                </div>
            `;
            return;
        }

        resumo.sort((a, b) => {
            const saldoDevedorA = a.saldoDevedor || 0;
            const saldoDevedorB = b.saldoDevedor || 0;
            
            const priorityA = saldoDevedorA <= 0 ? 1 : 2;
            const priorityB = saldoDevedorB <= 0 ? 1 : 2;
            
            if (priorityA !== priorityB) {
                return priorityA - priorityB;
            }
            
            const nomeA = (a.cliente || '').toLowerCase().trim();
            const nomeB = (b.cliente || '').toLowerCase().trim();
            return nomeA.localeCompare(nomeB, 'pt-BR');
        });

        container.innerHTML = resumo.map(cliente => renderClienteSummary(cliente)).join('');
        
    } catch (error) {
        console.error('❌ Erro ao carregar resumo de clientes:', error);
        container.innerHTML = `
            <div class="empty-state">
                <i class="fas fa-exclamation-triangle"></i>
                <p>Erro ao carregar dados</p>
            </div>
        `;
        
        if (window.modernAlert) {
            window.modernAlert.error('Erro ao carregar resumo de clientes');
        }
    }
}

// ===============================
// RENDERIZAÇÃO DE UM CLIENTE
// ===============================

function renderClienteSummary(cliente) {
    const saldoDevedor = cliente.saldoDevedor || 0;
    const valorPagoTotal = cliente.valorPagoTotal || 0;
    const valorAcumulado = cliente.valorAcumulado || 0;
    const statusClasse = saldoDevedor > 0 ? 'devedor' : 'quite';
    
    return `
        <div class="client-summary ${statusClasse}">
            <div class="client-summary-name">
                <i class="fas fa-user"></i>
                ${cliente.cliente}
            </div>
            <div class="client-summary-stats">
                <div class="client-summary-original">
                    <span class="summary-label">Total Original:</span>
                    <span class="summary-value original">R$ ${valorAcumulado.toFixed(2)}</span>
                </div>

                <div class="client-summary-total">
                    <span class="summary-label">Total em Aberto:</span>
                    <span class="summary-value ${saldoDevedor > 0 ? 'pending' : 'paid'}">R$ ${saldoDevedor.toFixed(2)}</span>
                </div>

                <div class="client-summary-count">
                    ${cliente.totalCompras} ${cliente.totalCompras === 1 ? 'impressão' : 'impressões'}
                </div>
                <div class="client-summary-folhas">
                    <span>
                        <i class="fas fa-file"></i>
                        ${cliente.folhasNormais} folhas normais
                    </span>
                    <span>
                        <i class="fas fa-file-alt"></i>
                        ${cliente.folhasOffset} offset
                    </span>
                </div>
                <div class="client-summary-debt">
                    ${saldoDevedor > 0 ? `
                        <div class="client-debt-value">
                            <i class="fas fa-exclamation-circle"></i>
                            Saldo Devedor: <strong>R$ ${saldoDevedor.toFixed(2)}</strong>
                        </div>
                    ` : `
                        <div class="client-paid-value">
                            <i class="fas fa-check-circle"></i>
                            <strong>Cliente em dia!</strong>
                        </div>
                    `}
                    <div class="client-paid-value">
                        <i class="fas fa-dollar-sign"></i>
                        Total Pago: R$ ${valorPagoTotal.toFixed(2)}
                    </div>
                </div>
            </div>
        </div>
    `;
}

// ===============================
// CLASSE PARA GERENCIAR CUSTOM SELECT
// ===============================

class CustomSelect {
    constructor(containerId, options = {}) {
        this.containerId = containerId;
        this.container = document.getElementById(containerId);
        this.trigger = null;
        this.dropdown = null;
        this.optionsContainer = null;
        this.selectedValue = '';
        this.options = [];
        this.onChange = options.onChange || (() => {});
        
        if (this.container) {
            this.init();
        } else {
            console.warn(`Container ${containerId} não encontrado - será inicializado quando disponível`);
        }
    }

    init() {
        if (!this.container) {
            console.error(`Container ${this.containerId} não encontrado`);
            return;
        }

        this.trigger = this.container.querySelector('.custom-select-trigger');
        this.dropdown = this.container.querySelector('.custom-select-dropdown');
        this.optionsContainer = this.container.querySelector('.custom-select-options');

        if (!this.trigger || !this.dropdown || !this.optionsContainer) {
            console.error('Elementos do custom select não encontrados');
            return;
        }

        this.setupEventListeners();
    }

    setupEventListeners() {
        if (!this.trigger) return;

        this.trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            this.toggleDropdown();
        });

        document.addEventListener('click', (e) => {
            if (this.container && !this.container.contains(e.target)) {
                this.closeDropdown();
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && this.isOpen()) {
                this.closeDropdown();
            }
        });
    }

    toggleDropdown() {
        if (this.isOpen()) {
            this.closeDropdown();
        } else {
            this.openDropdown();
        }
    }

    openDropdown() {
        if (this.trigger && this.dropdown) {
            this.trigger.classList.add('open');
            this.dropdown.classList.add('open');
        }
    }

    closeDropdown() {
        if (this.trigger && this.dropdown) {
            this.trigger.classList.remove('open');
            this.dropdown.classList.remove('open');
        }
    }

    isOpen() {
        return this.dropdown && this.dropdown.classList.contains('open');
    }

    loadOptions(options) {
        this.options = options;
        this.renderOptions();
    }

    renderOptions() {
        if (!this.optionsContainer) return;

        let optionsHTML = `
            <div class="custom-select-option custom-select-option-default" data-value="">
                <i class="fas fa-times-circle"></i> Selecione um cliente
            </div>
        `;

        if (this.options.length === 0) {
            optionsHTML += `
                <div class="custom-select-empty">
                    Nenhum cliente disponível
                </div>
            `;
        } else {
            optionsHTML += this.options.map(option => `
                <div class="custom-select-option" data-value="${option.value}">
                    ${option.label}
                </div>
            `).join('');
        }

        this.optionsContainer.innerHTML = optionsHTML;

        this.optionsContainer.querySelectorAll('.custom-select-option').forEach(optionEl => {
            optionEl.addEventListener('click', (e) => {
                const value = e.currentTarget.getAttribute('data-value');
                this.selectOption(value);
            });
        });
    }

    // ===============================================
    // MÉTODO CORRIGIDO - TRATA value === '' COMO RESET
    // ===============================================
    selectOption(value) {
        console.log('[SELECT] Opção clicada, value:', value);
        
        // CORREÇÃO: Tratar explicitamente value === '' como RESET
        if (value === '' || value === null || value === undefined) {
            console.log('[SELECT] ⚠️ Reset detectado - limpando seleção');
            this.resetSelection();
            this.closeDropdown();
            this.onChange('');
            return;
        }
        
        this.selectedValue = value;
        
        const selectedOption = this.options.find(opt => opt.value === value);
        
        if (!selectedOption) {
            console.warn('[SELECT] Opção não encontrada:', value);
            this.resetSelection();
            this.closeDropdown();
            return;
        }
        
        if (this.trigger) {
            const triggerText = this.trigger.querySelector('.trigger-text');
            if (triggerText) {
                triggerText.textContent = selectedOption.label;
                console.log('[SELECT] ✅ Texto atualizado:', selectedOption.label);
            }

            if (this.optionsContainer) {
                this.optionsContainer.querySelectorAll('.custom-select-option').forEach(opt => {
                    opt.classList.remove('selected');
                });

                const currentOption = this.optionsContainer.querySelector(`[data-value="${value}"]`);
                if (currentOption) {
                    currentOption.classList.add('selected');
                }
            }
        }

        this.closeDropdown();
        this.onChange(value);
        console.log('[SELECT] ✅ Cliente selecionado:', value);
    }

    // ===============================================
    // NOVO MÉTODO - RESET COMPLETO DO SELECT
    // ===============================================
    resetSelection() {
        console.log('[SELECT] 🔄 Resetando seleção...');
        
        this.selectedValue = '';
        
        if (this.trigger) {
            const triggerText = this.trigger.querySelector('.trigger-text');
            if (triggerText) {
                triggerText.textContent = 'Selecione um cliente';
            }
        }
        
        if (this.optionsContainer) {
            this.optionsContainer.querySelectorAll('.custom-select-option').forEach(opt => {
                opt.classList.remove('selected');
            });
        }
        
        console.log('[SELECT] ✅ Seleção limpa');
    }

    getValue() {
        return this.selectedValue;
    }

    reset() {
        this.resetSelection();
    }

    reinit() {
        this.container = document.getElementById(this.containerId);
        if (this.container) {
            this.init();
        }
    }
}

// ===============================
// GERENCIADOR DE MODAL DE PAGAMENTO
// ===============================

export class PaymentModalManager {
    constructor() {
        this.initializeElements();
        this.setupEventListeners();
        this.currentClienteId = null;
        
        this.paymentSelect = null;
        this.historySelect = null;
        
        setTimeout(() => {
            this.initializeCustomSelects();
        }, 100);
    }

    initializeCustomSelects() {
        this.paymentSelect = new CustomSelect('paymentClienteContainer', {
            onChange: (value) => this.onClienteChange(value)
        });
        
        this.historySelect = new CustomSelect('historyClienteContainer', {
            onChange: (value) => this.loadPaymentHistory(value)
        });
    }

    initializeElements() {
        this.elements = {
            modal: document.getElementById('paymentModal'),
            btnShowModal: document.getElementById('showPaymentModalBtn'),
            btnApply: document.getElementById('applyPaymentBtn'),
            inputValue: document.getElementById('paymentValue'),
            listImpressions: document.getElementById('impressionsList'),
            debtInfo: document.getElementById('clientDebtInfo'),
            debtValue: document.getElementById('clientDebtValue'),
            paidValue: document.getElementById('clientPaidValue'),
            totalOriginal: document.getElementById('clientTotalOriginal'),
            closeButtons: document.querySelectorAll('#paymentModal .close, #paymentModal .close-modal'),
            
            historyModal: document.getElementById('paymentHistoryModal'),
            historyList: document.getElementById('paymentHistoryList'),
            historyCloseButtons: document.querySelectorAll('#paymentHistoryModal .close, #paymentHistoryModal .close-modal'),
            
            successModal: document.getElementById('paymentSuccessModal'),
            successClientName: document.getElementById('successClientName'),
            successPaymentValue: document.getElementById('successPaymentValue'),
            successPaymentDate: document.getElementById('successPaymentDate'),
            successCloseButtons: document.querySelectorAll('#paymentSuccessModal .close, #paymentSuccessModal .close-modal')
        };
    }

    setupEventListeners() {
        this.elements.btnShowModal?.addEventListener('click', () => this.showModal());

        this.elements.closeButtons?.forEach(btn => {
            btn.addEventListener('click', () => this.closeModal());
        });

        this.elements.btnApply?.addEventListener('click', () => this.applyPayment());

        this.elements.historyCloseButtons?.forEach(btn => {
            btn.addEventListener('click', () => this.closeHistoryModal());
        });

        this.elements.successCloseButtons?.forEach(btn => {
            btn.addEventListener('click', () => this.closeSuccessModal());
        });
    }

    async showModal() {
        if (!this.paymentSelect || !this.paymentSelect.container) {
            this.initializeCustomSelects();
        }
        
        await this.loadClientes();
        this.resetModal();
        
        if (this.elements.modal) {
            this.elements.modal.style.display = 'block';
        }
    }

    closeModal() {
        if (this.elements.modal) {
            this.elements.modal.style.display = 'none';
        }
        this.resetModal();
    }

    resetModal() {
        if (this.paymentSelect) {
            this.paymentSelect.reset();
        }
        
        if (this.elements.inputValue) {
            this.elements.inputValue.value = '';
        }
        
        if (this.elements.debtInfo) {
            this.elements.debtInfo.style.display = 'none';
        }
        
        if (this.elements.listImpressions) {
            this.elements.listImpressions.style.display = 'none';
            this.elements.listImpressions.innerHTML = '';
        }
        
        this.currentClienteId = null;
    }

    async loadClientes() {
        console.log('[MODAL] 📋 Carregando clientes para o modal de pagamento...');
        
        try {
            const resumo = await supabaseManager.loadClientsSummary();
            
            const clientesComDebito = resumo.filter(c => c.saldoDevedor > 0);
            console.log(`[MODAL] 💰 Clientes com débito: ${clientesComDebito.length}`);
            
            if (clientesComDebito.length === 0) {
                if (this.paymentSelect) {
                    this.paymentSelect.loadOptions([]);
                }
                return;
            }
            
            const options = clientesComDebito.map(cliente => ({
                value: cliente.id,
                label: `${cliente.cliente} — Deve: R$ ${cliente.saldoDevedor.toFixed(2)}`
            }));
            
            if (this.paymentSelect) {
                this.paymentSelect.loadOptions(options);
                console.log('[MODAL] ✅ Clientes carregados no custom select');
            }

            await this.loadClientesForHistory();
            
        } catch (error) {
            console.error('[MODAL] ❌ Erro ao carregar clientes:', error);
            if (window.modernAlert) {
                window.modernAlert.error('Erro ao carregar clientes');
            }
        }
    }

    async loadClientesForHistory() {
        try {
            const { data: clientesComPagamentos, error } = await supabaseManager.supabase
                .from('pagamentos')
                .select('cliente_id')
                .order('data_pagamento', { ascending: false });

            if (error) throw error;

            const clientesIdsComPagamentos = [...new Set(clientesComPagamentos.map(p => p.cliente_id))];

            if (clientesIdsComPagamentos.length === 0) {
                if (this.historySelect) {
                    this.historySelect.loadOptions([]);
                }
                return;
            }

            const resumo = await supabaseManager.loadClientsSummary();
            const clientesComHistorico = resumo.filter(c => clientesIdsComPagamentos.includes(c.id));
            
            const options = clientesComHistorico.map(cliente => ({
                value: cliente.id,
                label: `${cliente.cliente} — ${cliente.totalCompras} impressões`
            }));
            
            if (this.historySelect) {
                this.historySelect.loadOptions(options);
            }
            
        } catch (error) {
            console.error('[HISTORY] ❌ Erro ao carregar clientes para histórico:', error);
            if (this.historySelect) {
                this.historySelect.loadOptions([]);
            }
        }
    }

    // ===============================================
    // MÉTODO CORRIGIDO - TRATA clienteId VAZIO
    // ===============================================
    async onClienteChange(clienteId) {
        console.log(`[MODAL] 🔄 Cliente selecionado: ${clienteId}`);
        
        // CORREÇÃO: Tratar clienteId vazio explicitamente
        if (!clienteId || clienteId === '' || clienteId === 'null') {
            console.log('[MODAL] ℹ️ Nenhum cliente selecionado - ocultando informações');
            
            if (this.elements.debtInfo) {
                this.elements.debtInfo.style.display = 'none';
            }
            
            if (this.elements.listImpressions) {
                this.elements.listImpressions.style.display = 'none';
            }
            
            if (this.elements.inputValue) {
                this.elements.inputValue.value = '';
            }
            
            this.currentClienteId = null;
            
            console.log('[MODAL] ✅ Estado resetado');
            return;
        }

        this.currentClienteId = clienteId;

        try {
            const resumo = await supabaseManager.loadClientsSummary();
            const cliente = resumo.find(c => c.id === clienteId);

            if (cliente) {
                console.log(`[MODAL] 💰 Dados do cliente: ${cliente.cliente}`);
                
                if (this.elements.totalOriginal) {
                    this.elements.totalOriginal.textContent = `R$ ${cliente.valorAcumulado.toFixed(2)}`;
                }
                if (this.elements.debtValue) {
                    this.elements.debtValue.textContent = `R$ ${cliente.saldoDevedor.toFixed(2)}`;
                }
                if (this.elements.paidValue) {
                    this.elements.paidValue.textContent = `R$ ${cliente.valorPagoTotal.toFixed(2)}`;
                }
                if (this.elements.debtInfo) {
                    this.elements.debtInfo.style.display = 'flex';
                }
            } else {
                console.error(`[MODAL] ❌ Cliente não encontrado no resumo: ${clienteId}`);
            }
        } catch (error) {
            console.error('[MODAL] ❌ Erro ao buscar dados do cliente:', error);
            if (window.modernAlert) {
                window.modernAlert.error('Erro ao carregar dados do cliente');
            }
        }
    }

    formatDateTime(dataHora) {
        const data = new Date(dataHora);
        return data.toLocaleString('pt-BR', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
        });
    }

    async applyPayment() {
        const valorPagamento = parseFloat(this.elements.inputValue?.value || 0);

        if (!this.currentClienteId) {
            if (window.modernAlert) {
                window.modernAlert.error('Selecione um cliente');
            }
            return;
        }

        if (!valorPagamento || valorPagamento <= 0) {
            if (window.modernAlert) {
                window.modernAlert.error('Informe um valor válido');
            }
            return;
        }

        const clienteIdToApply = this.currentClienteId;

        const resumo = await supabaseManager.loadClientsSummary();
        const cliente = resumo.find(c => c.id === clienteIdToApply);
        const nomeCliente = cliente ? cliente.cliente : 'Cliente';

        this.closeModal();

        if (window.modernLoading) {
            window.modernLoading.show();
        }

        try {
            await supabaseManager._syncApplyPayment({
                clienteId: clienteIdToApply,
                valorPagamento: valorPagamento,
                impressoesIds: null
            });

            await new Promise(resolve => setTimeout(resolve, 1000));
            
            if (window.impressionManager) {
                await window.impressionManager.loadFromSupabase();
            }
            
            await carregarResumoClientes({
                containerId: 'resumoClientes',
                orderBy: 'saldo_devedor',
                ascending: false
            });
            
            await this.loadClientes();
            
            this.showSuccessModal(nomeCliente, valorPagamento);

        } catch (error) {
            console.error('[MODAL] ❌ Erro ao aplicar pagamento:', error);
            if (window.modernAlert) {
                window.modernAlert.error('Erro ao aplicar pagamento');
            }
        } finally {
            if (window.modernLoading) {
                window.modernLoading.hide();
            }
        }
    }

    showSuccessModal(nomeCliente, valorPagamento) {
        const now = new Date();
        const dataHoraFormatada = now.toLocaleString('pt-BR', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit'
        });

        if (this.elements.successClientName) {
            this.elements.successClientName.textContent = nomeCliente;
        }
        if (this.elements.successPaymentValue) {
            this.elements.successPaymentValue.textContent = `R$ ${valorPagamento.toFixed(2)}`;
        }
        if (this.elements.successPaymentDate) {
            this.elements.successPaymentDate.textContent = dataHoraFormatada;
        }

        if (this.elements.successModal) {
            this.elements.successModal.style.display = 'block';
        }
    }

    closeSuccessModal() {
        if (this.elements.successModal) {
            this.elements.successModal.style.display = 'none';
        }
    }

    async loadPaymentHistory(clienteId) {
        if (!clienteId) {
            if (this.elements.historyList) {
                this.elements.historyList.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-receipt"></i>
                        <p>Selecione um cliente para ver o histórico</p>
                    </div>
                `;
            }
            return;
        }

        try {
            const { data: pagamentos, error } = await supabaseManager.supabase
                .from('pagamentos')
                .select(`
                    *,
                    pagamentos_impressoes (
                        impressao_id,
                        valor_aplicado
                    )
                `)
                .eq('cliente_id', clienteId)
                .order('data_pagamento', { ascending: false });

            if (error) throw error;

            if (!pagamentos || pagamentos.length === 0) {
                if (this.elements.historyList) {
                    this.elements.historyList.innerHTML = `
                        <div class="empty-state">
                            <i class="fas fa-inbox"></i>
                            <p>Nenhum pagamento registrado para este cliente</p>
                        </div>
                    `;
                }
                return;
            }

            if (this.elements.historyList) {
                this.elements.historyList.innerHTML = pagamentos.map(pagamento => {
                    const dataFormatada = this.formatDateTime(pagamento.data_pagamento);
                    const diasPagos = pagamento.pagamentos_impressoes?.length || 0;
                    
                    return `
                        <div class="payment-history-item">
                            <div class="payment-history-header">
                                <div class="payment-history-date">
                                    <i class="fas fa-calendar-check"></i>
                                    ${dataFormatada}
                                </div>
                                <div class="payment-history-value">
                                    R$ ${parseFloat(pagamento.valor_total).toFixed(2)}
                                </div>
                            </div>
                            <div class="payment-history-details">
                                <span class="payment-history-type">
                                    <i class="fas fa-info-circle"></i>
                                    Aplicação Automática
                                </span>
                                <span class="payment-history-days">
                                    <i class="fas fa-print"></i>
                                    ${diasPagos} ${diasPagos === 1 ? 'impressão paga' : 'impressões pagas'}
                                </span>
                            </div>
                            <button class="btn-remove-payment" data-payment-id="${pagamento.id}" data-client-id="${clienteId}">
                                <i class="fas fa-trash-alt"></i> Remover Pagamento
                            </button>
                        </div>
                    `;
                }).join('');

                this.elements.historyList.querySelectorAll('.btn-remove-payment').forEach(btn => {
                    btn.addEventListener('click', async (e) => {
                        const paymentId = e.currentTarget.getAttribute('data-payment-id');
                        const clientId = e.currentTarget.getAttribute('data-client-id');
                        await this.confirmRemovePayment(paymentId, clientId);
                    });
                });
            }

        } catch (error) {
            console.error('[HISTORY] ❌ Erro ao carregar histórico:', error);
            if (this.elements.historyList) {
                this.elements.historyList.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-exclamation-triangle"></i>
                        <p>Erro ao carregar histórico</p>
                    </div>
                `;
            }
        }
    }

    async confirmRemovePayment(paymentId, clientId) {
        if (window.modalManager) {
            window.modalManager.showConfirm(
                'Remover Pagamento',
                'Tem certeza que deseja remover este pagamento? Todas as impressões relacionadas serão recalculadas.',
                async () => {
                    await this.removePayment(paymentId, clientId);
                }
            );
        }
    }

    async removePayment(paymentId, clientId) {
        try {
            if (window.modernLoading) {
                window.modernLoading.show();
            }

            const { data: paymentData } = await supabaseManager.supabase
                .from('pagamentos')
                .select('valor_total')
                .eq('id', paymentId)
                .single();

            const resumo = await supabaseManager.loadClientsSummary();
            const cliente = resumo.find(c => c.id === clientId);
            const nomeCliente = cliente ? cliente.cliente : 'Cliente';
            const valorRemovido = paymentData ? parseFloat(paymentData.valor_total) : 0;

            await supabaseManager._syncRemovePayment({
                paymentId: paymentId,
                clienteId: clientId
            });

            await new Promise(resolve => setTimeout(resolve, 1000));
            
            if (window.impressionManager) {
                await window.impressionManager.loadFromSupabase();
            }
            
            await carregarResumoClientes({
                containerId: 'resumoClientes',
                orderBy: 'saldo_devedor',
                ascending: false
            });
            
            await this.loadPaymentHistory(clientId);
            await this.loadClientes();

            if (window.modernLoading) {
                window.modernLoading.hide();
            }

            showPaymentRemoved(nomeCliente, valorRemovido);

        } catch (error) {
            console.error('[REMOVE] ❌ Erro ao remover pagamento:', error);
            if (window.modernAlert) {
                window.modernAlert.error('Erro ao remover pagamento');
            }
            if (window.modernLoading) {
                window.modernLoading.hide();
            }
        }
    }

    showHistoryModal() {
        // Reinicializar custom select se necessário
        if (!this.historySelect || !this.historySelect.container) {
            this.initializeCustomSelects();
        }
        
        if (this.elements.historyModal) {
            this.elements.historyModal.style.display = 'block';
        }
        this.loadClientesForHistory();
    }

    closeHistoryModal() {
        if (this.elements.historyModal) {
            this.elements.historyModal.style.display = 'none';
        }
        
        if (this.historySelect) {
            this.historySelect.reset();
        }
        
        if (this.elements.historyList) {
            this.elements.historyList.innerHTML = `
                <div class="empty-state">
                    <i class="fas fa-receipt"></i>
                    <p>Selecione um cliente para ver o histórico</p>
                </div>
            `;
        }
    }
}

let paymentModalManager = null;

document.addEventListener('DOMContentLoaded', () => {
    paymentModalManager = new PaymentModalManager();
    console.log('[MODAL] ✅ PaymentModalManager inicializado');

    const summaryHeader = document.querySelector('.summary-card .card-header .header-actions');
    if (summaryHeader) {
        const historyBtn = document.createElement('button');
        historyBtn.id = 'showPaymentHistoryBtn';
        historyBtn.className = 'action-btn info-btn';
        historyBtn.innerHTML = '<i class="fas fa-history"></i> Histórico';
        
        historyBtn.addEventListener('click', () => {
            paymentModalManager.showHistoryModal();
        });

        summaryHeader.appendChild(historyBtn);
    }
});

export { paymentModalManager };