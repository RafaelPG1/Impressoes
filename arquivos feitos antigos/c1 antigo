/* ===============================================
   SISTEMA DE IMPRESSÕES - CSS PARTE 1
   
   CONTEÚDO:
   - Variáveis CSS (Design System Global)
   - Reset e Configurações Globais
   - Layout Principal
   - Componentes Reutilizáveis (Toast, Cards, Botões, Formulários, Modais, Badges, Tabelas)
   - Header Principal
   - SEÇÃO: Preços (Azul)
   - SEÇÃO: Nova Impressão (Verde)
   - Sistema de Loading e Alertas Modernos
   - Animações
   - Utilitários
   - Responsividade
   =============================================== */


/* ===============================================
   1. VARIÁVEIS CSS - DESIGN SYSTEM GLOBAL
   =============================================== */

:root {
    /* Cores Principais */
    --color-primary: #8b5cf6;
    --color-primary-dark: #7c3aed;
    --color-primary-light: #a78bfa;
    
    --color-success: #10b981;
    --color-success-dark: #059669;
    --color-success-light: #34d399;
    
    --color-danger: #ef4444;
    --color-danger-dark: #dc2626;
    --color-danger-light: #f87171;
    
    --color-warning: #f59e0b;
    --color-warning-dark: #d97706;
    --color-warning-light: #fbbf24;
    
    --color-info: #3b82f6;
    --color-info-dark: #2563eb;
    --color-info-light: #60a5fa;
    
    /* Cores das Seções */
    --color-prices: #028686;
    --color-prices-light: #05a0a0;
    --color-prices-dark: #016565;
    
    /* Backgrounds */
    --bg-primary: #0a0a0f;
    --bg-secondary: #13131a;
    --bg-tertiary: #1a1a24;
    --bg-card: #1e1e2a;
    --bg-card-hover: #252533;
    
    /* Texto */
    --text-primary: #f5f5f7;
    --text-secondary: #d1d5db;
    --text-tertiary: #9ca3af;
    --text-muted: #6b7280;
    
    /* Bordas */
    --border-color: rgba(255, 255, 255, 0.1);
    --border-color-light: rgba(255, 255, 255, 0.05);
    --border-color-hover: rgba(255, 255, 255, 0.2);
    
    /* Sombras */
    --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.4);
    --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.5);
    --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.6);
    --shadow-xl: 0 16px 48px rgba(0, 0, 0, 0.7);
    
    /* Espaçamento */
    --spacing-xs: 0.25rem;
    --spacing-sm: 0.5rem;
    --spacing-md: 1rem;
    --spacing-lg: 1.5rem;
    --spacing-xl: 2rem;
    --spacing-2xl: 3rem;
    
    /* Border Radius */
    --radius-sm: 0.5rem;
    --radius-md: 0.75rem;
    --radius-lg: 1rem;
    --radius-xl: 1.5rem;
    
    /* Transições */
    --transition-fast: 150ms ease;
    --transition-base: 250ms ease;
    --transition-slow: 400ms ease;
    
    /* Tipografia */
    --font-sans: 'Inter', 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;
}


/* ===============================================
   2. RESET E CONFIGURAÇÕES GLOBAIS
   =============================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-sans);
    background: var(--bg-primary);
    background-image: 
        radial-gradient(at 0% 0%, rgba(139, 92, 246, 0.08) 0px, transparent 50%),
        radial-gradient(at 100% 0%, rgba(16, 185, 129, 0.05) 0px, transparent 50%),
        radial-gradient(at 100% 100%, rgba(59, 130, 246, 0.05) 0px, transparent 50%),
        radial-gradient(at 0% 100%, rgba(239, 68, 68, 0.05) 0px, transparent 50%);
    min-height: 100vh;
    color: var(--text-primary);
    line-height: 1.6;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

html {
    scroll-behavior: smooth;
}

/* Remove spin buttons dos inputs numéricos */
input[type="number"]::-webkit-outer-spin-button,
input[type="number"]::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
}

input[type="number"] {
    -moz-appearance: textfield;
    appearance: textfield;
}

/* Estados de foco e seleção */
*:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
}

::selection {
    background: var(--color-primary);
    color: white;
}

::-moz-selection {
    background: var(--color-primary);
    color: white;
}


/* ===============================================
   3. LAYOUT PRINCIPAL
   =============================================== */

.container {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-lg);
}


/* ===============================================
   4. COMPONENTES REUTILIZÁVEIS
   =============================================== */

/* ---------- Toast Notifications ---------- */

.toast-container {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 10000;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    pointer-events: none;
}

.toast {
    background: var(--bg-card);
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    min-width: 320px;
    max-width: 420px;
    border: 1px solid var(--border-color);
    pointer-events: all;
    animation: slideInRight 0.3s ease;
}

.toast i {
    font-size: 1.5rem;
    flex-shrink: 0;
}

.toast span {
    flex: 1;
    font-weight: 500;
    color: var(--text-primary);
    font-size: 0.95rem;
}

.toast.toast-success {
    border-left: 4px solid var(--color-success);
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), var(--bg-card));
}

.toast.toast-success i {
    color: var(--color-success);
}

.toast.toast-error {
    border-left: 4px solid var(--color-danger);
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), var(--bg-card));
}

.toast.toast-error i {
    color: var(--color-danger);
}

.toast.toast-warning {
    border-left: 4px solid var(--color-warning);
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), var(--bg-card));
}

.toast.toast-warning i {
    color: var(--color-warning);
}

.toast.toast-info {
    border-left: 4px solid var(--color-info);
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), var(--bg-card));
}

.toast.toast-info i {
    color: var(--color-info);
}

/* ---------- Cards ---------- */

.card {
    background: var(--bg-card);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-lg);
    margin-bottom: var(--spacing-xl);
    overflow: hidden;
    transition: all var(--transition-base);
    position: relative;
    animation: fadeInUp 0.5s ease;
}

.card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.3), transparent);
}

.card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
    border-color: var(--border-color-hover);
}

.card-header {
    padding: var(--spacing-lg) var(--spacing-xl);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    border-bottom: 1px solid var(--border-color);
    background: linear-gradient(135deg, var(--bg-tertiary) 0%, var(--bg-card) 100%);
    position: relative;
}

.card-header h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.card-header i {
    font-size: 1.1rem;
    opacity: 0.9;
}

/* ---------- Botões ---------- */

/* Botões base */
.btn {
    padding: var(--spacing-md) var(--spacing-xl);
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    transition: all var(--transition-base);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    position: relative;
    overflow: hidden;
}

.btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.btn:hover::before {
    width: 400px;
    height: 400px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--color-success), var(--color-success-dark));
    color: white;
    width: 100%;
    box-shadow: 0 4px 16px rgba(16, 185, 129, 0.3);
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(16, 185, 129, 0.5);
}

.btn-secondary {
    background: linear-gradient(135deg, var(--bg-tertiary), var(--bg-secondary));
    color: var(--text-primary);
    border: 1px solid var(--border-color);
}

.btn-secondary:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-color-hover);
}

.btn-danger {
    background: linear-gradient(135deg, var(--color-danger), var(--color-danger-dark));
    color: white;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
}

.btn-danger:hover {
    box-shadow: 0 6px 20px rgba(239, 68, 68, 0.5);
}

/* Botões de ação no header */
.header-actions {
    display: flex;
    gap: var(--spacing-md);
    align-items: center;
    flex-wrap: wrap;
}

.action-btn {
    padding: var(--spacing-sm) var(--spacing-lg);
    border: none;
    border-radius: var(--radius-md);
    color: white;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-base);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    position: relative;
    overflow: hidden;
}

.action-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.action-btn:hover::before {
    width: 300px;
    height: 300px;
}

.action-btn:hover {
    transform: translateY(-2px);
}

.action-btn i {
    color: white !important;
}

/* Botões específicos */
.clear-btn {
    background: linear-gradient(135deg, var(--color-danger), var(--color-danger-dark));
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
}

.clear-btn:hover {
    box-shadow: 0 6px 20px rgba(239, 68, 68, 0.5);
}

.add-btn {
    background: linear-gradient(135deg, var(--color-success), var(--color-success-dark));
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
}

.add-btn:hover {
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
}

.info-btn {
    background: linear-gradient(135deg, var(--color-info), var(--color-info-dark));
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
}

.info-btn:hover {
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.5);
}

/* Botões de ícone */
.btn-icon {
    padding: var(--spacing-sm);
    border-radius: var(--radius-sm);
    border: none;
    cursor: pointer;
    transition: all var(--transition-fast);
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.btn-edit {
    background: linear-gradient(135deg, var(--color-info), var(--color-info-dark));
    color: white;
    margin-right: var(--spacing-sm);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
}

.btn-edit:hover {
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.5);
    transform: translateY(-2px);
}

.btn-danger.btn-icon {
    padding: var(--spacing-sm);
}

/* ---------- Formulários ---------- */

.form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group label {
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: var(--spacing-sm);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.form-group input,
.form-group select {
    padding: var(--spacing-md);
    background: var(--bg-secondary);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 500;
    transition: all var(--transition-fast);
}

.form-group input::placeholder {
    color: var(--text-muted);
}

.form-group input:focus,
.form-group select:focus {
    outline: none;
    border-color: var(--color-success);
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
    background: var(--bg-tertiary);
}

.form-group input:disabled {
    background: var(--bg-primary);
    cursor: not-allowed;
    opacity: 0.5;
}

.form-group select {
    cursor: pointer;
}

.form-group select option {
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: var(--spacing-md);
}

.form-group input.error,
.form-group select.error {
    border-color: var(--color-danger) !important;
    box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.15) !important;
}

.field-error {
    display: block;
    color: var(--color-danger-light);
    font-size: 0.85rem;
    font-weight: 600;
    margin-top: var(--spacing-sm);
}

.field-info {
    display: block;
    color: var(--text-tertiary);
    font-size: 0.85rem;
    margin-top: var(--spacing-sm);
    font-style: italic;
}

/* ---------- Modais ---------- */

.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    overflow-y: auto;
}

/* Z-index hierarchy para modais */
#confirmModal {
    z-index: 10000;
}

#paymentSuccessModal {
    z-index: 3000;
}

#paymentHistoryModal,
#paymentModal,
#editModal,
#addModal {
    z-index: 2000;
}

.modal-content {
    background: var(--bg-card);
    margin: 5% auto;
    padding: 0;
    border-radius: var(--radius-xl);
    width: 90%;
    max-width: 520px;
    max-height: 90vh;
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--border-color);
    animation: modalSlideIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: flex;
    flex-direction: column;
}

.modal-large {
    max-width: 700px;
}

.modal-header {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: white;
    padding: var(--spacing-lg) var(--spacing-xl);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
}

.modal-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
}

.modal-header h3 {
    margin: 0;
    font-weight: 700;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.modal-header i {
    font-size: 1.1rem;
}

/* Variações de header de modal */
.success-header {
    background: linear-gradient(135deg, var(--color-success), var(--color-success-dark));
}

.error-header {
    background: linear-gradient(135deg, var(--color-danger), var(--color-danger-dark));
}

.confirm-header {
    background: linear-gradient(135deg, var(--color-danger), var(--color-danger-dark));
}

.close {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.75rem;
    font-weight: bold;
    cursor: pointer;
    transition: all var(--transition-fast);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
}

.close:hover {
    color: white;
    background: rgba(255, 255, 255, 0.2);
    transform: rotate(90deg);
}

.modal-body {
    padding: var(--spacing-xl);
    overflow-y: auto;
}

.modal-buttons {
    display: flex;
    gap: var(--spacing-md);
    justify-content: flex-end;
    margin-top: var(--spacing-xl);
}

.info-box {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(59, 130, 246, 0.05));
    border-left: 4px solid var(--color-info);
    padding: var(--spacing-lg);
    border-radius: var(--radius-md);
    margin: var(--spacing-lg) 0;
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
}

.info-box i {
    color: var(--color-info);
    font-size: 1.25rem;
    margin-top: 2px;
    flex-shrink: 0;
}

.info-box p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
}

/* ---------- Badges e Status ---------- */

.status-badge {
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    white-space: nowrap;
}

.status-badge.ativo,
.status-badge.pendente {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(239, 68, 68, 0.1));
    color: var(--color-danger-light);
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.status-badge.riscado,
.status-badge.manual,
.status-badge.pago {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(16, 185, 129, 0.1));
    color: var(--color-success-light);
    border: 1px solid rgba(16, 185, 129, 0.3);
}

.status-badge.parcial {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(245, 158, 11, 0.1));
    color: var(--color-warning-light);
    border: 1px solid rgba(245, 158, 11, 0.3);
}

.offset-badge {
    background: rgba(245, 158, 11, 0.2);
    color: var(--color-warning-light);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 700;
    margin-left: var(--spacing-xs);
}

/* ---------- Tabelas ---------- */

.table-container {
    width: 100%;
    max-height: 600px;
    position: relative;
    background: var(--bg-card);
}

.table-scroll-wrapper {
    width: 100%;
    max-height: 600px;
    overflow-x: auto;
    overflow-y: auto;
}

.table-scroll-wrapper::-webkit-scrollbar {
    width: 10px;
    height: 10px;
}

.table-scroll-wrapper::-webkit-scrollbar-track {
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
}

.table-scroll-wrapper::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    border-radius: var(--radius-sm);
}

.table-scroll-wrapper::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 1000px;
}

table thead {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg-card);
}

table th {
    background: linear-gradient(135deg, var(--bg-tertiary), var(--bg-card));
    color: var(--text-secondary);
    padding: var(--spacing-lg) var(--spacing-md);
    font-weight: 700;
    text-align: center;
    border-bottom: 1px solid var(--border-color);
    border-right: 1px solid var(--border-color-light);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
}

table th:last-child {
    border-right: none;
}

table td {
    padding: var(--spacing-lg) var(--spacing-md);
    border-bottom: 1px solid var(--border-color-light);
    border-right: 1px solid var(--border-color-light);
    font-size: 0.95rem;
    color: var(--text-primary);
    white-space: nowrap;
    text-align: center;
}

table td:last-child {
    border-right: none;
}

/* Linha normal (cliente não pagou) - borda CINZA */
table tbody tr {
    border-left: 3px solid var(--text-tertiary);
}

/* Estados de linha - Pagamento Completo (Verde) */
.paid-impression {
    opacity: 0.6;
    background: rgba(16, 185, 129, 0.03) !important;
    border-left: 3px solid var(--color-success) !important;
}

.paid-impression:hover {
    opacity: 0.8;
    background: rgba(16, 185, 129, 0.08) !important;
}

/* Estados de linha - Pagamento Parcial (Amarelo) */
.partial-impression {
    background: rgba(245, 158, 11, 0.03) !important;
    border-left: 3px solid var(--color-warning) !important;
}

.partial-impression:hover {
    background: rgba(245, 158, 11, 0.08) !important;
}

/* Header da tabela - borda BRANCA */
table thead tr {
    border-left: 3px solid rgba(255, 255, 255, 0.5);
}

/* Células específicas */
.client-name {
    font-weight: 700;
    color: var(--text-primary);
    font-size: 1.05rem;
}

.tipo-info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
}

.tipo-nome {
    font-weight: 600;
    color: var(--text-secondary);
}

.folhas-display {
    font-weight: 600;
    color: var(--text-primary);
}

.valor-info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
}

.valor-total-display {
    font-weight: 800;
    color: var(--color-success-light);
    font-size: 1.2rem;
    font-family: var(--font-mono);
}

.valor-pago-display {
    font-size: 0.85rem;
}

.status-pago {
    color: var(--color-success-light);
    font-weight: 600;
}

.status-parcial {
    color: var(--color-warning-light);
    font-weight: 600;
}

.status-pendente {
    color: var(--color-danger-light);
    font-weight: 600;
}

.data-hora {
    font-size: 0.85rem;
    color: var(--text-tertiary);
}

.acoes {
    display: flex;
    gap: var(--spacing-xs);
    justify-content: center;
}

.empty-state {
    text-align: center;
    padding: var(--spacing-2xl) var(--spacing-xl);
    color: var(--text-tertiary);
}

.empty-state i {
    font-size: 3.5rem;
    margin-bottom: var(--spacing-lg);
    opacity: 0.3;
    color: var(--text-muted);
}

.empty-state p {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-tertiary);
}


/* ===============================================
   5. HEADER PRINCIPAL
   =============================================== */

.header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
    padding: var(--spacing-xl) 0;
    position: relative;
}

.header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
    border-radius: 2px;
}

.header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.5px;
    margin-bottom: var(--spacing-sm);
}

.header i {
    margin-right: var(--spacing-md);
    filter: drop-shadow(0 0 12px rgba(139, 92, 246, 0.5));
}


/* ===============================================
   6. SEÇÃO: PREÇOS (AZUL)
   =============================================== */

.prices-card .card-header {
    background: linear-gradient(135deg, rgba(2, 134, 134, 0.15) 0%, var(--bg-card) 100%);
}

.prices-card .card-header h2 {
    color: var(--color-prices-light);
}

.prices-card .card-header i {
    color: var(--color-prices);
}

.prices-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
    padding: var(--spacing-xl);
    justify-content: center;
}

.price-item {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    text-align: center;
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
    flex: 0 0 calc(33.333% - var(--spacing-lg));
    min-width: 250px;
}

.price-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(2, 134, 134, 0.1), transparent);
    transition: left 0.5s;
}

.price-item:hover {
    transform: translateY(-4px);
    border-color: var(--color-prices);
    box-shadow: 0 8px 24px rgba(2, 134, 134, 0.25);
}

.price-item:hover::before {
    left: 100%;
}

.price-item label {
    display: block;
    font-weight: 700;
    color: var(--text-secondary);
    margin-bottom: var(--spacing-md);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.price-item input {
    width: 120px;
    padding: var(--spacing-md);
    background: var(--bg-secondary);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: 1.5rem;
    font-weight: 700;
    text-align: center;
    transition: all var(--transition-fast);
    font-family: var(--font-mono);
}

.price-item input:focus {
    outline: none;
    border-color: var(--color-prices);
    box-shadow: 0 0 0 4px rgba(2, 134, 134, 0.15);
}

.price-item input[readonly] {
    cursor: not-allowed;
    opacity: 0.7;
}

.price-label {
    display: block;
    margin-top: var(--spacing-sm);
    font-size: 0.85rem;
    color: var(--text-muted);
}

.price-item-offset {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(245, 158, 11, 0.05));
    border-color: rgba(245, 158, 11, 0.3);
}

.price-item-offset:hover {
    border-color: var(--color-warning);
    box-shadow: 0 8px 24px rgba(245, 158, 11, 0.25);
}

.price-item-offset label {
    color: var(--color-warning-light);
}

.lock-btn {
    background: var(--bg-tertiary);
    border: 2px solid var(--color-prices);
    color: var(--color-prices);
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition-base);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
}

.lock-btn:hover {
    background: var(--color-prices);
    transform: scale(1.05);
    box-shadow: 0 4px 16px rgba(2, 134, 134, 0.4);
}

.lock-btn:hover i {
    color: white !important;
}

.lock-btn.unlocked {
    border-color: var(--color-success);
    color: var(--color-success);
}

.lock-btn.unlocked:hover {
    background: var(--color-success);
}

.paper-prices {
    background: var(--bg-secondary);
    padding: var(--spacing-lg) var(--spacing-xl);
    border-top: 1px solid var(--border-color);
}

.paper-info {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-sm);
    color: var(--text-secondary);
    font-size: 0.95rem;
}

.paper-info i {
    color: var(--color-info);
}


/* ===============================================
   7. SEÇÃO: NOVA IMPRESSÃO (VERDE)
   =============================================== */

.form-card .card-header {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, var(--bg-card) 100%);
}

.form-card .card-header h2 {
    color: var(--color-success-light);
}

.form-card .card-header i {
    color: var(--color-success);
}

.impression-form {
    padding: var(--spacing-xl);
}

.tipo-preco {
    margin-top: var(--spacing-sm);
    font-size: 0.9rem;
    color: var(--color-success-light);
    font-weight: 600;
    display: none;
}

/* Card de Total */
.total-card {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(16, 185, 129, 0.03) 100%);
    border: 2px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    margin-top: var(--spacing-xl);
    transition: all var(--transition-base);
}

.total-card:hover {
    border-color: rgba(16, 185, 129, 0.5);
    box-shadow: 0 8px 32px rgba(16, 185, 129, 0.2);
}

.card-title {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-secondary);
    margin-bottom: var(--spacing-lg);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.card-title i {
    color: var(--color-success);
}

.total-display {
    text-align: center;
}

.total-final-section {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(16, 185, 129, 0.05));
    border: 2px solid rgba(16, 185, 129, 0.4);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
    display: flex;
    align-items: center;
    justify-content: center;
}

.total-value {
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-success-light);
    font-family: var(--font-mono);
    letter-spacing: -1px;
}

.calculation-breakdown {
    background: transparent;
    border: 1px solid var(--border-color-light);
    border-radius: var(--radius-sm);
    padding: var(--spacing-md);
    margin: 0 auto var(--spacing-lg) auto;
    display: inline-flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    width: fit-content;
}

.calculation-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing-md);
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.4;
}

.calculation-item .item-icon {
    font-size: 1.1rem;
    min-width: 20px;
    text-align: center;
    opacity: 0.8;
}

.calculation-item .item-formula {
    font-family: var(--font-mono);
    letter-spacing: 0.3px;
    color: var(--text-tertiary);
}

.calculation-item .item-arrow {
    color: var(--text-muted);
    font-weight: 500;
    opacity: 0.6;
}

.calculation-item .item-result {
    color: var(--text-secondary);
    font-weight: 700;
    font-family: var(--font-mono);
}

.calculation-empty {
    text-align: center;
    color: var(--text-primary);
    font-size: 0.85rem;
    padding: var(--spacing-md);
    opacity: 0.6;
}

.calculation-total-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-lg);
    margin-top: var(--spacing-sm);
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(16, 185, 129, 0.05));
    border: 2px solid rgba(16, 185, 129, 0.4);
    border-radius: var(--radius-md);
    font-size: 1.1rem;
    font-family: var(--font-mono);
}

.calculation-total-line .total-label {
    color: var(--color-success-light);
    font-weight: 700;
}

.calculation-total-line .total-arrow {
    opacity: 0.6;
    color: var(--color-success-light);
}

.calculation-total-line .total-result {
    font-weight: 800;
    color: var(--color-success-light);
    font-size: 1.25rem;
}


/* ===============================================
   8. SISTEMA DE LOADING E ALERTAS MODERNOS
   =============================================== */

/* ---------- Loading Overlay ---------- */

.modern-loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 10, 15, 0.92);
    backdrop-filter: blur(12px);
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    animation: modernFadeIn 0.3s ease;
}

.modern-loading-overlay.show {
    display: flex;
}

.modern-loading-card {
    background: linear-gradient(135deg, #1e1e2a 0%, #13131a 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 48px 56px;
    box-shadow: 
        0 20px 60px rgba(0, 0, 0, 0.8),
        0 0 1px rgba(255, 255, 255, 0.15);
    text-align: center;
    animation: modernScaleIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    overflow: hidden;
}

.modern-loading-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.03),
        transparent
    );
    animation: modernShine 2s infinite;
}

.modern-loading-spinner {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
    position: relative;
}

.spinner-ring {
    position: absolute;
    width: 100%;
    height: 100%;
    border: 4px solid transparent;
    border-radius: 50%;
    animation: modernSpinRing 1.5s cubic-bezier(0.5, 0, 0.5, 1) infinite;
}

.spinner-ring:nth-child(1) {
    border-top-color: #8b5cf6;
    animation-delay: 0s;
}

.spinner-ring:nth-child(2) {
    border-top-color: #10b981;
    animation-delay: -0.3s;
    width: 90%;
    height: 90%;
    top: 5%;
    left: 5%;
}

.spinner-ring:nth-child(3) {
    border-top-color: #3b82f6;
    animation-delay: -0.6s;
    width: 80%;
    height: 80%;
    top: 10%;
    left: 10%;
}

.modern-loading-text {
    font-size: 16px;
    font-weight: 600;
    color: #d1d5db;
    margin: 0;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    animation: modernPulseText 1.5s ease-in-out infinite;
}

/* ---------- Sistema de Alertas ---------- */

.modern-alert-container {
    position: fixed;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100000;
    display: flex;
    flex-direction: column;
    gap: 12px;
    pointer-events: none;
    width: 90%;
    max-width: 480px;
}

.modern-alert {
    background: linear-gradient(135deg, #1e1e2a 0%, #13131a 100%);
    border: 2px solid;
    border-radius: 16px;
    padding: 20px 24px;
    box-shadow: 
        0 12px 40px rgba(0, 0, 0, 0.6),
        0 0 1px rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    gap: 16px;
    pointer-events: all;
    animation: modernSlideDown 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(12px);
}

.modern-alert.hiding {
    animation: modernSlideUp 0.3s ease forwards;
}

.modern-alert::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    animation: modernAlertPulse 2s ease-in-out infinite;
}

.modern-alert.success {
    border-color: rgba(16, 185, 129, 0.4);
}

.modern-alert.success::before {
    background: #10b981;
}

.modern-alert.error {
    border-color: rgba(239, 68, 68, 0.4);
}

.modern-alert.error::before {
    background: #ef4444;
}

.modern-alert.warning {
    border-color: rgba(245, 158, 11, 0.4);
}

.modern-alert.warning::before {
    background: #f59e0b;
}

.modern-alert.info {
    border-color: rgba(59, 130, 246, 0.4);
}

.modern-alert.info::before {
    background: #3b82f6;
}

.modern-alert-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    flex-shrink: 0;
    animation: modernIconBounce 0.6s ease;
}

.modern-alert.success .modern-alert-icon {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
}

.modern-alert.error .modern-alert-icon {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
}

.modern-alert.warning .modern-alert-icon {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
}

.modern-alert.info .modern-alert-icon {
    background: rgba(59, 130, 246, 0.15);
    color: #3b82f6;
}

.modern-alert-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.modern-alert-title {
    font-size: 16px;
    font-weight: 700;
    color: #f5f5f7;
    margin: 0;
}

.modern-alert-message {
    font-size: 14px;
    color: #d1d5db;
    margin: 0;
    line-height: 1.5;
}

.modern-alert-close {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: none;
    color: #9ca3af;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
    font-size: 18px;
}

.modern-alert-close:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #f5f5f7;
    transform: rotate(90deg);
}






/* ===============================================
   MODAL DE ADICIONAR IMPRESSÃO MANUAL - CUSTOM (SCROLL NATURAL) - VERDE
   =============================================== */

/* Container customizado do modal de adicionar */
.modal-add-custom {
  max-width: 550px !important;
  width: 90% !important;
  max-height: 90vh !important;
  display: flex !important;
  flex-direction: column !important;
  margin: 2.5vh auto !important;
  overflow-y: auto !important; /* SCROLL NO MODAL INTEIRO */
  overflow-x: hidden !important;
}

/* Header verde para o modal de adicionar */
#addModal .modal-header {
  background: linear-gradient(135deg, var(--color-success), var(--color-success-dark)) !important;
}

#addModal .modal-header h3,
#addModal .modal-header i,
#addModal .modal-header .close {
  color: white !important;
}

#addModal .modal-header .close:hover {
  background: rgba(255, 255, 255, 0.2) !important;
}

/* Scrollbar customizada para o MODAL INTEIRO - Verde */
.modal-add-custom::-webkit-scrollbar {
  width: 8px;
}

.modal-add-custom::-webkit-scrollbar-track {
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
}

.modal-add-custom::-webkit-scrollbar-thumb {
  background: linear-gradient(135deg, var(--color-success), var(--color-success-dark));
  border-radius: var(--radius-sm);
}

.modal-add-custom::-webkit-scrollbar-thumb:hover {
  background: var(--color-success-dark);
}

/* Body customizado do modal de adicionar - SEM SCROLL PRÓPRIO */
.modal-body-add {
  display: flex;
  flex-direction: column;
  gap: 18px;
  overflow: visible; /* SEM scroll interno */
  padding: var(--spacing-xl);
  flex: 0 0 auto; /* Não cresce nem encolhe, usa tamanho natural */
}

/* Form groups no modal de adicionar */
.modal-body-add .form-group {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.modal-body-add .form-group label {
  font-weight: 600;
  color: var(--text-secondary);
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.modal-body-add .form-group input {
  padding: var(--spacing-md);
  background: var(--bg-secondary);
  border: 2px solid var(--border-color);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  font-size: 1rem;
  font-weight: 500;
  transition: all var(--transition-fast);
}

.modal-body-add .form-group input:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.15);
  background: var(--bg-tertiary);
}

/* Info box customizado para modal de adicionar */
.modal-body-add .info-box {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(59, 130, 246, 0.05));
  border-left: 4px solid var(--color-info);
  padding: var(--spacing-lg);
  border-radius: var(--radius-md);
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-md);
  margin: 0;
}

.modal-body-add .info-box i {
  color: var(--color-info);
  font-size: 1.25rem;
  margin-top: 2px;
  flex-shrink: 0;
}

.modal-body-add .info-box p {
  margin: 0;
  color: var(--text-secondary);
  font-size: 0.9rem;
  line-height: 1.8;
}

.modal-body-add .info-box p strong {
  color: var(--text-primary);
  font-weight: 700;
}

/* Botões customizados - NO FLUXO NATURAL DO MODAL */
.modal-buttons-add {
  display: flex;
  gap: 12px;
  padding: var(--spacing-lg) var(--spacing-xl);
  border-top: none; /* Remove linha divisória */
  flex-shrink: 0; /* Não encolhe */
  /* SEM position, SEM z-index - totalmente no fluxo */
}

.modal-buttons-add .btn {
  flex: 1;
  min-width: 0;
}

/* Ordem padrão - Desktop: Cancelar (esquerda), Adicionar (direita) */
.modal-buttons-add .btn-secondary {
  order: 1;
}

.modal-buttons-add .btn-primary {
  order: 2;
}

/* Mobile - Ajustes para telas pequenas e zoom alto */
@media (max-width: 768px) {
  .modal-add-custom {
    max-width: 95% !important;
    width: 95% !important;
    margin: 1vh auto !important;
    max-height: 96vh !important;
  }
  
  .modal-body-add {
    padding: var(--spacing-lg);
    gap: 16px;
  }
  
  .modal-body-add .info-box {
    padding: var(--spacing-md);
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  
  .modal-body-add .info-box i {
    font-size: 1.5rem;
  }
  
  .modal-buttons-add {
    padding: var(--spacing-md) var(--spacing-lg);
    flex-direction: column;
    gap: 10px;
  }
  
  .modal-buttons-add .btn {
    width: 100%;
  }
}

@media (max-width: 600px) {
  .modal-add-custom {
    max-width: 98% !important;
    width: 98% !important;
    margin: 0.5vh auto !important;
    max-height: 98vh !important;
  }
  
  .modal-body-add {
    padding: var(--spacing-md);
    gap: 14px;
  }
  
  .modal-body-add .form-group input {
    padding: var(--spacing-sm);
  }
  
  .modal-buttons-add {
    padding: var(--spacing-sm) var(--spacing-md);
  }
}

/* Suporte a zoom alto (150%+) */
@media (min-resolution: 1.5dppx) {
  .modal-body-add {
    gap: 14px;
  }
  
  .modal-body-add .info-box {
    padding: var(--spacing-md);
  }
}

/* Ícone de calendário branco */
input[type="datetime-local"]::-webkit-calendar-picker-indicator {
  filter: invert(1);
  opacity: 0.9;
  cursor: pointer;
}


/* ===============================================
   MODAL DE EDIÇÃO - CUSTOM (SCROLL NATURAL)
   =============================================== */

/* Container customizado do modal de edição */
.modal-edit-custom {
  max-width: 600px !important;
  width: 90% !important;
  max-height: 90vh !important;
  display: flex !important;
  flex-direction: column !important;
  margin: 2.5vh auto !important;
  overflow-y: auto !important; /* SCROLL NO MODAL INTEIRO */
  overflow-x: hidden !important;
}

/* Body customizado do modal de edição - SEM SCROLL PRÓPRIO */
.modal-body-edit {
  display: flex;
  flex-direction: column;
  gap: 16px;
  overflow: visible; /* SEM scroll interno */
  padding: var(--spacing-xl);
  flex: 0 0 auto; /* Não cresce nem encolhe, usa tamanho natural */
}

/* Scrollbar customizada para o MODAL INTEIRO */
.modal-edit-custom::-webkit-scrollbar {
  width: 8px;
}

.modal-edit-custom::-webkit-scrollbar-track {
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
}

.modal-edit-custom::-webkit-scrollbar-thumb {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  border-radius: var(--radius-sm);
}

.modal-edit-custom::-webkit-scrollbar-thumb:hover {
  background: var(--color-primary-dark);
}

/* Botões customizados - NO FLUXO NATURAL DO MODAL */
.modal-buttons-edit {
  display: flex;
  gap: 12px;
  padding: var(--spacing-lg) var(--spacing-xl);
  border-top: none;
  flex-shrink: 0; /* Não encolhe */
  /* SEM position, SEM z-index - totalmente no fluxo */
}

.modal-buttons-edit .btn {
  flex: 1;
  min-width: 0;
}

/* Form blocks */
.form-block {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* Grid */
.form-grid {
  display: grid;
  gap: 14px;
}

.grid-2 {
  grid-template-columns: 1fr 1fr;
}

/* Tamanhos */
.form-group.full {
  width: 100%;
}

/* Valor Total - Estilo com Borda no Valor */
.total-card.edit-total {
    background: transparent !important;
    border: none !important;
    padding: 20px 0 8px 0;
    text-align: center;
    box-shadow: none !important;
    margin-top: 0;
    margin-bottom: 0;
}

.total-card.edit-total .total-label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    font-family: var(--font-sans) !important;
    color: var(--text-tertiary) !important;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.total-card.edit-total .total-value {
    display: inline-block;
    font-size: 24px;
    font-weight: 700;
    font-family: var(--font-mono) !important;
    color: var(--color-success) !important;
    background: var(--bg-secondary);
    border: 2px solid #000000;
    border-radius: var(--radius-md);
    padding: var(--spacing-md) var(--spacing-xl);
    margin: 0 auto;
}

/* Remover animações e hovers */
.total-card.edit-total:hover,
.total-card.edit-total .total-value:hover,
.total-card.edit-total .total-label:hover {
    transform: none !important;
    box-shadow: none !important;
}

/* Esconder o breakdown no modal de edição */
#editModal .calculation-breakdown {
    display: none;
}

/* Mobile - Ajustes para telas pequenas e zoom alto */
@media (max-width: 768px) {
  .modal-edit-custom {
    max-width: 95% !important;
    width: 95% !important;
    margin: 1vh auto !important;
    max-height: 96vh !important;
  }
  
  .modal-body-edit {
    padding: var(--spacing-lg);
    gap: 14px;
  }
  
  .modal-buttons-edit {
    padding: var(--spacing-md) var(--spacing-lg);
    flex-direction: column;
    gap: 10px;
  }
  
  .modal-buttons-edit .btn {
    width: 100%;
  }
  
  .grid-2 {
    grid-template-columns: 1fr;
  }
  
  .total-card.edit-total {
    padding: 16px 0 8px 0;
  }
  
  .total-card.edit-total .total-value {
    font-size: 20px;
    padding: var(--spacing-sm) var(--spacing-lg);
  }
}

@media (max-width: 600px) {
  .modal-edit-custom {
    max-width: 98% !important;
    width: 98% !important;
    margin: 0.5vh auto !important;
    max-height: 98vh !important;
  }
  
  .modal-body-edit {
    padding: var(--spacing-md);
  }
  
  .modal-buttons-edit {
    padding: var(--spacing-sm) var(--spacing-md);
  }
}

/* Suporte a zoom alto (150%+) */
@media (min-resolution: 1.5dppx) {
  .modal-body-edit {
    gap: 12px;
  }
  
  .form-grid {
    gap: 12px;
  }
  
  .total-card.edit-total {
    padding: 12px 0 6px 0;
  }
}






/* ===============================================
   CALENDÁRIO CUSTOMIZADO - VERSÃO RESPONSIVA COM SCROLL
   =============================================== */

/* Overlay do Calendário */
.custom-datetime-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    z-index: 10001;
    animation: fadeIn 0.3s ease;
}

.custom-datetime-overlay.show {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2vh 0;
}

/* Container Principal do Calendário - DINÂMICO COM SCROLL */
.custom-datetime-picker {
    background: linear-gradient(135deg, #1e1e2a 0%, #13131a 100%);
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 16px;
    box-shadow: 
        0 20px 60px rgba(0, 0, 0, 0.8),
        0 0 1px rgba(139, 92, 246, 0.5);
    width: 90%;
    max-width: 320px;
    max-height: 96vh; /* Altura máxima dinâmica */
    animation: slideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto; /* SCROLL NO CONTAINER INTEIRO */
    overflow-x: hidden;
    margin: auto;
}

/* Scrollbar customizada para o calendário */
.custom-datetime-picker::-webkit-scrollbar {
    width: 6px;
}

.custom-datetime-picker::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 3px;
}

.custom-datetime-picker::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    border-radius: 3px;
}

.custom-datetime-picker::-webkit-scrollbar-thumb:hover {
    background: #7c3aed;
}

/* Header do Calendário - MINIMALISTA E COMPACTO */
.datetime-header {
    background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    padding: 16px;
    text-align: center;
    position: relative;
    flex-shrink: 0;
}

.datetime-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
}

.selected-date-display {
    color: white;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 8px;
    opacity: 0.7;
}

.selected-date-main {
    color: white;
    font-size: 20px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    letter-spacing: 0.5px;
}

.selected-date-main i {
    font-size: 18px;
    opacity: 0.9;
}

.close-datetime-picker {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(255, 255, 255, 0.15);
    border: none;
    color: white;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    font-size: 14px;
}

.close-datetime-picker:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: rotate(90deg);
}

/* Corpo do Calendário - FLUXO NATURAL, SEM SCROLL PRÓPRIO */
.datetime-body {
    padding: 16px;
    background: #1e1e2a;
    flex: 0 0 auto; /* Não cresce nem encolhe, usa tamanho natural */
    overflow: visible; /* SEM scroll interno */
}

/* Navegação do Mês */
.calendar-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.calendar-nav button {
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid rgba(139, 92, 246, 0.3);
    color: #a78bfa;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    font-size: 13px;
}

.calendar-nav button:hover {
    background: rgba(139, 92, 246, 0.25);
    border-color: rgba(139, 92, 246, 0.5);
    transform: scale(1.05);
}

.current-month {
    color: #f5f5f7;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.3px;
}

/* GRID DO CALENDÁRIO */
.calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    margin-bottom: 14px;
}

/* Cabeçalhos dos dias da semana */
.calendar-weekday {
    text-align: center;
    font-size: 10px;
    font-weight: 700;
    color: #9ca3af;
    padding: 6px 0;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

/* Container dos dias */
#calendarDays {
    display: contents;
    grid-column: 1 / -1;
}

/* Botões dos dias */
.calendar-day {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #d1d5db;
    background: transparent;
    border: 1.5px solid transparent;
    position: relative;
    min-height: 34px;
}

.calendar-day:hover:not(:disabled) {
    background: rgba(139, 92, 246, 0.15);
    border-color: rgba(139, 92, 246, 0.3);
    transform: scale(1.05);
}

.calendar-day.other-month {
    color: #6b7280;
    opacity: 0.4;
    cursor: not-allowed;
}

.calendar-day:disabled {
    cursor: not-allowed;
}

.calendar-day.today {
    color: #3b82f6;
    font-weight: 700;
}

.calendar-day.today::after {
    content: '';
    position: absolute;
    bottom: 3px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    background: #3b82f6;
    border-radius: 50%;
}

.calendar-day.selected {
    background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    color: white;
    border-color: #8b5cf6;
    transform: scale(1.05);
    box-shadow: 0 3px 12px rgba(139, 92, 246, 0.4);
}

.calendar-day.selected:hover {
    transform: scale(1.05);
}

/* Seletor de Hora */
/* Seletor de Hora - PRECISA SER RELATIVE PARA O BOTÃO "AGORA" */
.time-selector {
    background: rgba(139, 92, 246, 0.08);
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 12px;
    padding: 14px;
    margin-bottom: 14px;
    position: relative; /* ADICIONAR ESTA LINHA */
}

.time-selector-label {
    color: #9ca3af;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    margin-bottom: 10px;
    display: block;
}

.time-inputs {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
}

.time-input-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
}

.time-input-label {
    color: #6b7280;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
}

.time-input {
    background: #13131a;
    border: 2px solid rgba(139, 92, 246, 0.3);
    border-radius: 10px;
    color: #f5f5f7;
    font-size: 20px;
    font-weight: 700;
    text-align: center;
    width: 60px;
    height: 50px;
    font-family: 'Courier New', monospace;
}

.time-input:focus {
    outline: none;
    border-color: #8b5cf6;
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
}

.time-separator {
    color: #8b5cf6;
    font-size: 26px;
    font-weight: 700;
    margin: 0 2px;
}

/* Botões de Ação - NO FLUXO NATURAL DO CALENDÁRIO */
.datetime-actions {
    display: flex;
    gap: 10px;
    flex-shrink: 0; /* Não encolhe */
    /* SEM position, SEM z-index - totalmente no fluxo */
}
/* Botão "Agora" - Posicionado no canto superior direito do time-selector */
.set-now-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: #60a5fa;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 4px;
}

.set-now-btn i {
    font-size: 10px;
}

.set-now-btn:hover {
    background: rgba(59, 130, 246, 0.25);
    border-color: rgba(59, 130, 246, 0.5);
    transform: scale(1.05);
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
}

/* Responsivo para o botão "Agora" */
@media (max-width: 600px) {
    .set-now-btn {
        top: 8px;
        right: 8px;
        padding: 3px 6px;
        font-size: 9px;
        border-radius: 5px;
        gap: 3px;
    }

    .set-now-btn i {
        font-size: 9px;
    }
}

@media (max-width: 380px) {
    .set-now-btn {
        top: 6px;
        right: 6px;
        padding: 2px 5px;
        font-size: 8px;
        border-radius: 4px;
        gap: 2px;
    }

    .set-now-btn i {
        font-size: 8px;
    }
}
.datetime-btn {
    flex: 1;
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.datetime-btn i {
    font-size: 13px;
}

.datetime-btn-cancel {
    background: rgba(239, 68, 68, 0.15);
    border: 2px solid rgba(239, 68, 68, 0.3);
    color: #f87171;
}

.datetime-btn-cancel:hover {
    background: rgba(239, 68, 68, 0.25);
    border-color: rgba(239, 68, 68, 0.5);
    transform: translateY(-2px);
}

.datetime-btn-ok {
    background: linear-gradient(135deg, #10b981, #059669);
    border: 2px solid #10b981;
    color: white;
    box-shadow: 0 3px 10px rgba(16, 185, 129, 0.3);
}

.datetime-btn-ok:hover {
    box-shadow: 0 5px 16px rgba(16, 185, 129, 0.5);
    transform: translateY(-2px);
}

/* Animações */
@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(50px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@keyframes fadeIn {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

