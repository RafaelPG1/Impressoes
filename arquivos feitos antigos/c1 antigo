/* ===============================================
   11. RESPONSIVIDADE
   =============================================== */

@media (max-width: 1024px) {
    .prices-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    :root {
        --spacing-lg: 1rem;
        --spacing-xl: 1.5rem;
        --spacing-2xl: 2rem;
    }
    
    .container {
        padding: var(--spacing-lg) var(--spacing-md);
    }
    
    .header h1 {
        font-size: 2rem;
    }
    
    .form-row {
        grid-template-columns: 1fr;
    }
    
    .prices-grid {
        grid-template-columns: 1fr;
    }
    
    .paper-info {
        flex-direction: column;
        gap: var(--spacing-sm);
        text-align: center;
    }
    
    table {
        font-size: 0.85rem;
    }
    
    table th,
    table td {
        padding: var(--spacing-sm);
    }
    
    .card-header {
        flex-direction: column;
        gap: var(--spacing-md);
        text-align: center;
    }
    
    .header-actions {
        flex-direction: column;
        width: 100%;
    }
    
    .action-btn {
        width: 100%;
        justify-content: center;
    }
    
    .toast-container {
        right: var(--spacing-md);
        left: var(--spacing-md);
    }
    
    .toast {
        min-width: auto;
        max-width: 100%;
    }
    
    .total-value {
        font-size: 2rem;
    }
    
    .modal-content {
        width: 95%;
        margin: 10% auto;
    }
    
    .modal-buttons {
        flex-direction: column-reverse;
    }
    
    .modal-buttons .btn {
        width: 100%;
    }
    
    .table-container {
        max-height: 500px;
    }
    
    .modern-alert-container {
        width: 95%;
    }
    
    .modern-loading-card {
        padding: 32px 40px;
    }
    
    .modern-loading-spinner {
        width: 64px;
        height: 64px;
    }
}

@media (max-width: 480px) {
    .header h1 {
        font-size: 1.75rem;
    }
    
    .card-header h2 {
        font-size: 1.1rem;
    }
    
    .btn {
        padding: var(--spacing-sm) var(--spacing-lg);
        font-size: 0.9rem;
    }
    
    .action-btn {
        padding: var(--spacing-sm) var(--spacing-md);
        font-size: 0.85rem;
    }
    
    .total-value {
        font-size: 1.75rem;
    }
    
    .total-card {
        padding: var(--spacing-lg);
    }
    
    .table-container {
        max-height: 400px;
    }
    
    .modern-loading-card {
        padding: 24px 32px;
    }
    
    .modern-loading-spinner {
        width: 56px;
        height: 56px;
    }
    
    .modern-loading-text {
        font-size: 14px;
    }
}

