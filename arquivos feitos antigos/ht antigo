<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Impressões</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="style-parte1.css">
    <link rel="stylesheet" href="style-parte2.css">
</head>
<body>
    <!-- Toast Container -->
    <div id="toastContainer" class="toast-container"></div>

    <div class="container">
        <!-- Header -->
        <header class="header">
            <h1><i class="fas fa-print"></i> Sistema de Gerenciamento de Impressões</h1>
        </header>

        <!-- Seção de Preços (Azul) -->
        <section class="card prices-card">
            <div class="card-header">
                <h2><i class="fas fa-tags"></i> Preços</h2>
                <div class="header-actions">
                    <button id="clearPricesBtn" class="action-btn clear-btn">
                        <i class="fas fa-trash"></i> Limpar Preços
                    </button>
                    <button id="lockButton" class="lock-btn">
                        <i class="fas fa-lock" id="lockIcon"></i>
                    </button>
                </div>
            </div>
            <div class="prices-grid">
                <div class="price-item">
                    <label>Preço 1 - Xerox P&B</label>
                    <input type="number" id="preco1" value="0.50" step="0.01" min="0" readonly>
                    <span class="price-label">R$/unidade</span>
                </div>
                <div class="price-item">
                    <label>Preço 2 - Xerox Colorido</label>
                    <input type="number" id="preco2" value="1.00" step="0.01" min="0" readonly>
                    <span class="price-label">R$/unidade</span>
                </div>
                <div class="price-item">
                    <label>Preço 3 - Digital P&B</label>
                    <input type="number" id="preco3" value="1.50" step="0.01" min="0" readonly>
                    <span class="price-label">R$/unidade</span>
                </div>
                <div class="price-item">
                    <label>Preço 4 - Digital Colorido</label>
                    <input type="number" id="preco4" value="2.00" step="0.01" min="0" readonly>
                    <span class="price-label">R$/unidade</span>
                </div>
                <div class="price-item price-item-offset">
                    <label>Folha Offset</label>
                    <input type="number" id="precoOffset" value="0.50" step="0.01" min="0" readonly>
                    <span class="price-label">R$/unidade</span>
                </div>
            </div>
            <div class="paper-prices">
                <div class="paper-info">
                    <span><i class="fas fa-info-circle"></i> <strong>Folha Offset:</strong> Adiciona <strong id="offsetPriceInfo">+ R$ 0,50</strong> por unidade</span>
                </div>
            </div>
        </section>

        <!-- Formulário de Entrada (Verde) -->
        <section class="card form-card">
            <div class="card-header">
                <h2><i class="fas fa-plus-circle"></i> Nova Impressão</h2>
                <button id="clearFormBtn" class="action-btn clear-btn">
                    <i class="fas fa-eraser"></i> Limpar Formulário
                </button>
            </div>
            <form id="impressaoForm" class="impression-form">
                <div class="form-row">
                    <div class="form-group">
                        <label for="nomeCliente">Nome do Cliente</label>
                        <input type="text" id="nomeCliente" placeholder="Digite o nome do cliente" required>
                        <span class="field-error" id="nomeClienteError"></span>
                    </div>
                    <div class="form-group">
                        <label for="tipoImpressao">Tipo de Impressão</label>
                        <select id="tipoImpressao" required>
                            <option value="">Selecione o tipo</option>
                            <option value="1">Xerox Preto e Branco</option>
                            <option value="2">Xerox Colorido</option>
                            <option value="3">Impressão Digital P&B</option>
                            <option value="4">Impressão Digital Colorido</option>
                        </select>
                        <div id="precoTipo" class="tipo-preco"></div>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="folhasNormais">Folhas</label>
                        <input type="number" id="folhasNormais" min="0" placeholder="0.00">
                    </div>
                    <div class="form-group">
                        <label for="folhasOffset">Folhas Offset <span id="offsetPriceLabel">(+R$ 0,50/un)</span></label>
                        <input type="number" id="folhasOffset" min="0" placeholder="0.00">
                        <span class="field-error" id="folhasOffsetError"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="projetoCanva">Projeto Canva (Valor Adicional)</label>
                        <input type="number" id="projetoCanva" min="0" step="0.01" placeholder="0.00">
                        <span class="field-info">Valor adicional por criação de design</span>
                    </div>
                    <div class="form-group">
                        <label for="trabalho">Trabalho (Valor Adicional)</label>
                        <input type="number" id="trabalho" min="0" step="0.01" placeholder="0.00">
                        <span class="field-info">Valor adicional por serviços extras</span>
                    </div>
                </div>

                <div class="total-card">
                    <div class="card-title">
                        <i class="fas fa-calculator"></i>
                        Valor Total
                    </div>
                    <div class="total-display">
                        <div class="total-final-section">
                            <span id="valorTotal" class="total-value">R$ 0,00</span>
                        </div>
                        
                        <div id="totalBreakdown" class="calculation-breakdown"></div>
                        
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Adicionar Impressão
                        </button>
                    </div>
                </div>
            </form>
        </section>

        <!-- Tabela e Resumo -->
        <section class="data-section">
            <!-- Tabela de Impressões (Roxo) -->
            <div class="card table-card">
                <div class="card-header">
                    <h2><i class="fas fa-table"></i> Impressões Registradas</h2>
                    <div class="header-actions">
                        <button id="addManualBtn" class="action-btn add-btn">
                            <i class="fas fa-plus"></i> Adicionar Impressão
                        </button>
                        <button id="clearTableBtn" class="action-btn clear-btn">
                            <i class="fas fa-trash-alt"></i> Limpar Registros
                        </button>
                    </div>
                </div>
                <div class="table-container">
                    <div class="table-scroll-wrapper">
                        <table id="impressoesTable">
                            <thead>
                                <tr>
                                    <th>Cliente</th>
                                    <th>Tipo + Preço</th>
                                    <th>Folhas Normais</th>
                                    <th>Folhas Offset</th>
                                    <th>Projeto Canva</th>
                                    <th>Trabalho</th>
                                    <th>Valor (Total/Pago/Resta)</th>
                                    <th>Status</th>
                                    <th>Data/Hora</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody id="impressoesTableBody">
                                <tr>
                                    <td colspan="10" class="empty-state">
                                        <i class="fas fa-print"></i>
                                        <p>Nenhuma impressão registrada ainda</p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Resumo por Cliente (Laranja) -->
            <div class="card summary-card">
                <div class="card-header">
                    <h2><i class="fas fa-chart-pie"></i> Resumo por Cliente</h2>
                    <div class="header-actions">
                        <button id="showPaymentModalBtn" class="action-btn add-btn">
                            <i class="fas fa-dollar-sign"></i> Registrar Pagamento
                        </button>
                    </div>
                </div>
                <div id="resumoClientes" class="summary-list">
                    <div class="empty-state">
                        <i class="fas fa-users"></i>
                        <p>Nenhum cliente com impressões ainda</p>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Modal de Confirmação -->
    <div id="confirmModal" class="modal">
        <div class="modal-content confirm-modal">
            <div class="modal-header confirm-header">
                <h3><i class="fas fa-question-circle"></i> <span id="confirmTitle">Confirmar</span></h3>
                <span class="close">&times;</span>
            </div>
            <div class="modal-body">
                <p id="confirmMessage">Tem certeza que deseja realizar esta ação?</p>
                <div class="modal-buttons">
                    <button type="button" class="btn btn-secondary" id="confirmCancelBtn">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-primary" id="confirmOkBtn">
                        <i class="fas fa-check"></i> Confirmar
                    </button>
                </div>
            </div>
        </div>
    </div>

<!-- Modal de Adicionar Impressão Manual -->
<div id="addModal" class="modal">
    <div class="modal-content modal-add-custom">
        <div class="modal-header">
            <h3><i class="fas fa-plus-circle"></i> Adicionar Impressão Manual</h3>
            <span class="close">&times;</span>
        </div>
        <form id="addForm">
            <div class="modal-body modal-body-add">
                <div class="form-group">
                    <label for="addCliente">Nome do Cliente:</label>
                    <input type="text" id="addCliente" placeholder="Digite o nome do cliente" required>
                </div>
                <div class="form-group">
                    <label for="addValorTotal">Valor Total:</label>
                    <input type="number" id="addValorTotal" step="0.01" min="0" placeholder="R$ 0,00" required>
                </div>
                <div class="form-group">
                    <label for="addDataHora">Data/Hora:</label>
                    <input type="datetime-local" id="addDataHora" required>
                </div>
            </div>
            
            <div class="modal-buttons modal-buttons-add">
    <button type="button" class="btn btn-secondary">
        <i class="fas fa-times"></i> Cancelar
    </button>
    <button type="submit" class="btn btn-primary">
        <i class="fas fa-save"></i> Adicionar
    </button>
</div>
        </form>
    </div>
</div>

<!-- Modal de Editar Impressão - ATUALIZADO -->
<div id="editModal" class="modal">
  <div class="modal-content modal-edit-custom">
    
    <!-- HEADER -->
    <div class="modal-header">
      <h3><i class="fas fa-edit"></i> Editar Impressão</h3>
      <span class="close">&times;</span>
    </div>

    <form id="editForm">
      <div class="modal-body-edit">

        <!-- BLOCO 1 -->
        <div class="form-block">
          <div class="form-group full">
            <label>Nome do Cliente</label>
            <input type="text" id="editCliente" required>
          </div>

          <div class="form-group full">
            <label>Tipo de Impressão</label>
            <select id="editTipoImpressao" required></select>
            <div id="editPrecoTipo" class="tipo-preco"></div>
          </div>
        </div>

        <!-- BLOCO 2 -->
        <div class="form-grid grid-2">
          <div class="form-group">
            <label>Folhas Normais</label>
            <input type="number" id="editFolhasNormais" min="0">
          </div>

          <div class="form-group">
            <label>Folhas Offset</label>
            <input type="number" id="editFolhasOffset" min="0">
          </div>
        </div>

        <!-- BLOCO 3 -->
        <div class="form-grid grid-2">
          <div class="form-group">
            <label>Projeto Canva</label>
            <input type="number" id="editProjetoCanva" step="0.01" min="0">
          </div>

          <div class="form-group">
            <label>Trabalho</label>
            <input type="number" id="editTrabalho" step="0.01" min="0">
          </div>
        </div>

        <!-- NOVO: BLOCO VALOR TOTAL MANUAL (aparece quando necessário) -->
        <div class="form-group full" id="editValorTotalManualContainer" style="display: none;">
          <label>
            <i class="fas fa-hand-pointer"></i> Valor Total Manual
            <span class="field-info" style="display: block; margin-top: 4px; font-size: 12px;">
              Use este campo para impressões manuais sem detalhamento
            </span>
          </label>
          <input type="number" id="editValorTotalManual" step="0.01" min="0" placeholder="0.00">
        </div>

        <!-- BLOCO 4 -->
        <div class="form-group full">
          <label>Data / Hora</label>
          <input type="datetime-local" id="editDataHora">
        </div>

        <!-- TOTAL -->
        <div class="total-card edit-total">
          <span class="total-label">Valor Total</span>
          <span id="editValorTotal" class="total-value">R$ 0,00</span>
          <div id="editTotalBreakdown" class="calculation-breakdown"></div>
        </div>

      </div>

      <!-- BOTÕES -->
      <div class="modal-buttons-edit">
        <button type="button" class="btn btn-secondary">
          <i class="fas fa-times"></i> Cancelar
        </button>
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-save"></i> Salvar Alterações
        </button>
      </div>

    </form>
  </div>
</div>


    <!-- Modal de Registrar Pagamento -->
    <div id="paymentModal" class="modal">
        <div class="modal-content modal-large">
            <div class="modal-header">
                <h3><i class="fas fa-dollar-sign"></i> Registrar Pagamento</h3>
                <span class="close">&times;</span>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="paymentCliente">Selecione o Cliente:</label>
                    <div class="custom-select-container" id="paymentClienteContainer">
                        <div class="custom-select-trigger" id="paymentClienteTrigger">
                            <span class="trigger-text">Selecione um cliente</span>
                            <i class="fas fa-chevron-down trigger-arrow"></i>
                        </div>
                        <div class="custom-select-dropdown" id="paymentClienteDropdown">
                            <div class="custom-select-options" id="paymentClienteOptions">
                                <!-- Options serão inseridas via JS -->
                            </div>
                        </div>
                    </div>
                </div>
                
                <div id="clientDebtInfo" class="debt-info">
                    <div class="debt-card debt-card-original">
                        <div class="debt-label">Total Original:</div>
                        <div class="debt-value" id="clientTotalOriginal">R$ 0,00</div>
                    </div>
                    <div class="debt-card debt-card-pending">
                        <div class="debt-label">Total em Aberto:</div>
                        <div class="debt-value" id="clientDebtValue">R$ 0,00</div>
                    </div>
                    <div class="debt-card debt-card-paid">
                        <div class="debt-label">Total Pago:</div>
                        <div class="debt-value" id="clientPaidValue">R$ 0,00</div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="paymentValue">Valor do Pagamento:</label>
                    <input type="number" id="paymentValue" step="0.01" min="0" placeholder="0.00">
                </div>

                <div id="impressionsList" class="impressions-payment-list"></div>

                <div class="modal-buttons">
                    <button type="button" class="btn btn-secondary close-modal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="button" id="applyPaymentBtn" class="btn btn-primary">
                        <i class="fas fa-check"></i> Aplicar Pagamento
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de Histórico de Pagamentos -->
    <div id="paymentHistoryModal" class="modal">
        <div class="modal-content modal-large">
            <div class="modal-header">
                <h3><i class="fas fa-history"></i> Histórico de Pagamentos</h3>
                <span class="close">&times;</span>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="historyCliente">Selecione o Cliente:</label>
                    <div class="custom-select-container" id="historyClienteContainer">
                        <div class="custom-select-trigger" id="historyClienteTrigger">
                            <span class="trigger-text">Selecione um cliente</span>
                            <i class="fas fa-chevron-down trigger-arrow"></i>
                        </div>
                        <div class="custom-select-dropdown" id="historyClienteDropdown">
                            <div class="custom-select-options" id="historyClienteOptions">
                                <!-- Options serão inseridas via JS -->
                            </div>
                        </div>
                    </div>
                </div>

                <div id="paymentHistoryList" class="payment-history-list">
                    <div class="empty-state">
                        <i class="fas fa-receipt"></i>
                        <p>Selecione um cliente para ver o histórico</p>
                    </div>
                </div>

                <div class="modal-buttons">
                    <button type="button" class="btn btn-secondary close-modal">
                        <i class="fas fa-times"></i> Fechar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de Confirmação de Pagamento -->
    <div id="paymentSuccessModal" class="modal">
        <div class="modal-content success-modal">
            <div class="modal-header success-header">
                <h3><i class="fas fa-check-circle"></i> Pagamento Registrado com Sucesso!</h3>
                <span class="close">&times;</span>
            </div>
            <div class="modal-body">
                <div class="payment-success-details">
                    <div class="success-detail-item">
                        <i class="fas fa-user"></i>
                        <div>
                            <span class="detail-label">Cliente:</span>
                            <span class="detail-value" id="successClientName">—</span>
                        </div>
                    </div>
                    <div class="success-detail-item">
                        <i class="fas fa-money-bill-wave"></i>
                        <div>
                            <span class="detail-label">Valor Pago:</span>
                            <span class="detail-value success-amount" id="successPaymentValue">R$ 0,00</span>
                        </div>
                    </div>
                    <div class="success-detail-item">
                        <i class="fas fa-calendar-check"></i>
                        <div>
                            <span class="detail-label">Data/Hora:</span>
                            <span class="detail-value" id="successPaymentDate">—</span>
                        </div>
                    </div>
                </div>
                <div class="modal-buttons">
                    <button type="button" class="btn btn-primary close-modal">
                        <i class="fas fa-check"></i> Entendido
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de Pagamento Removido -->
    <div id="paymentRemovedOverlay" class="payment-removed-overlay">
        <div class="payment-removed-modal">
            <div class="payment-removed-header">
                <div class="payment-removed-icon-wrapper">
                    <svg class="payment-removed-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="white">
                        <path d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z"/>
                    </svg>
                </div>
            </div>

            <div class="payment-removed-body">
                <h2 class="payment-removed-title">Pagamento Removido</h2>

                <div class="payment-removed-message">
                    <p>O pagamento foi removido com sucesso. Todas as impressões relacionadas foram recalculadas.</p>
                </div>

                <div class="payment-removed-details">
                    <div class="payment-removed-detail-item">
                        <span class="payment-removed-detail-label">
                            <i class="fas fa-user"></i>
                            Cliente
                        </span>
                        <span class="payment-removed-detail-value client-name" id="removedClientName">—</span>
                    </div>

                    <div class="payment-removed-detail-item">
                        <span class="payment-removed-detail-label">
                            <i class="fas fa-dollar-sign"></i>
                            Valor Removido
                        </span>
                        <span class="payment-removed-detail-value amount" id="removedAmount">R$ 0,00</span>
                    </div>
                </div>

                <button class="payment-removed-button" onclick="closePaymentRemoved()">
                    <i class="fas fa-check"></i>
                    Entendido
                </button>
            </div>
        </div>
    </div>

    <!-- Sistema de Loading e Alertas Modernos -->
    <div id="modernLoadingOverlay" class="modern-loading-overlay">
        <div class="modern-loading-card">
            <div class="modern-loading-spinner">
                <div class="spinner-ring"></div>
                <div class="spinner-ring"></div>
                <div class="spinner-ring"></div>
            </div>
            <p class="modern-loading-text">Carregando...</p>
        </div>
    </div>

    <div id="modernAlertContainer" class="modern-alert-container"></div>

<!-- CALENDÁRIO CUSTOMIZADO -->
<div class="custom-datetime-overlay" id="customDateTimeOverlay">
    <div class="custom-datetime-picker">
        <!-- Header Minimalista -->
        <div class="datetime-header">
            <button class="close-datetime-picker" id="closeDateTimePicker">
                <i class="fas fa-times"></i>
            </button>
            <div class="selected-date-display">Data Selecionada</div>
            <div class="selected-date-main">
                <i class="far fa-calendar"></i>
                <span id="selectedDateDisplay">Sex • 5 dez • 00:00</span>
            </div>
        </div>

        <!-- Body -->
        <div class="datetime-body">
            <!-- Navegação do Mês -->
            <div class="calendar-nav">
                <button id="prevMonth" type="button">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <div class="current-month" id="currentMonth">Junho 2021</div>
                <button id="nextMonth" type="button">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>

            <!-- Grade do Calendário -->
            <div class="calendar-grid">
                <div class="calendar-weekday">D</div>
                <div class="calendar-weekday">S</div>
                <div class="calendar-weekday">T</div>
                <div class="calendar-weekday">Q</div>
                <div class="calendar-weekday">Q</div>
                <div class="calendar-weekday">S</div>
                <div class="calendar-weekday">S</div>
                <!-- Dias serão inseridos via JS -->
                <div id="calendarDays"></div>
            </div>

            <!-- Seletor de Hora -->
<div class="time-selector">
    <!-- Botão "Agora" - pequeno e discreto -->
    <button class="set-now-btn" id="setNowBtn" type="button">
        <i class="far fa-clock"></i>
        Atual
    </button>
    
    <label class="time-selector-label">Selecione a Hora</label>
    <div class="time-inputs">
        <div class="time-input-group">
            <span class="time-input-label">Hora</span>
            <input type="number" class="time-input" id="hourInput" min="0" max="23" value="11">
        </div>
        <span class="time-separator">:</span>
        <div class="time-input-group">
            <span class="time-input-label">Min</span>
            <input type="number" class="time-input" id="minuteInput" min="0" max="59" value="22">
        </div>
    </div>
</div>

            <!-- Botões de Ação -->
            <div class="datetime-actions">
                <button class="datetime-btn datetime-btn-cancel" id="cancelDateTime" type="button">
                    <i class="fas fa-times"></i>
                    Cancelar
                </button>
                <button class="datetime-btn datetime-btn-ok" id="confirmDateTime" type="button">
                    <i class="fas fa-check"></i>
                    Confirmar
                </button>
            </div>
        </div>
    </div>
    
</div>


    <!-- Scripts para Modal de Pagamento Removido -->
    <script>
        /**
         * Exibe o modal de pagamento removido
         * @param {string} clientName - Nome do cliente
         * @param {number} amount - Valor do pagamento removido
         */
        function showPaymentRemoved(clientName, amount) {
            const overlay = document.getElementById('paymentRemovedOverlay');
            const clientNameElement = document.getElementById('removedClientName');
            const amountElement = document.getElementById('removedAmount');

            clientNameElement.textContent = clientName;
            amountElement.textContent = `R$ ${amount.toFixed(2)}`;

            overlay.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        /**
         * Fecha o modal de pagamento removido
         */
        function closePaymentRemoved() {
            const overlay = document.getElementById('paymentRemovedOverlay');
            overlay.classList.remove('show');
            document.body.style.overflow = '';
        }

        // Fecha ao clicar fora do modal
        document.getElementById('paymentRemovedOverlay').addEventListener('click', function(e) {
            if (e.target === this) {
                closePaymentRemoved();
            }
        });

        // Fecha ao pressionar ESC
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const overlay = document.getElementById('paymentRemovedOverlay');
                if (overlay.classList.contains('show')) {
                    closePaymentRemoved();
                }
            }
        });
    </script>

    <!-- Script Principal -->
    <script type="module" src="main.js"></script>
</body>
