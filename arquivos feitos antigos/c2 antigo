/* ===============================================
   CUSTOM SELECT - DROPDOWN CORRIGIDO
   =============================================== */

.custom-select-container {
    position: relative;
    width: 100%;
}

/* TRIGGER (campo clicável) */
.custom-select-trigger {
    width: 100%;
    padding: var(--spacing-md);
    background: var(--bg-secondary);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-align: left;
    user-select: none;
}

.custom-select-trigger:hover {
    border-color: var(--border-color-hover);
}

.custom-select-trigger.open {
    border-color: var(--color-success);
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
}

.custom-select-trigger .trigger-text {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.custom-select-trigger .trigger-arrow {
    margin-left: var(--spacing-sm);
    transition: transform 0.2s ease;
    color: var(--text-tertiary);
}

.custom-select-trigger.open .trigger-arrow {
    transform: rotate(180deg);
}

/* DROPDOWN - USANDO SCALE + OPACITY (mais confiável que max-height) */
.custom-select-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    background: var(--bg-secondary);
    border: 2px solid var(--border-color-hover);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    z-index: 1000;
    
    /* CORREÇÃO: usar transform + opacity ao invés de max-height */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scaleY(0.95);
    transform-origin: top;
    transition: 
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0s linear 0.2s; /* delay no visibility só quando FECHANDO */
    
    /* Altura mínima garante espaço mesmo vazio */
    min-height: 60px;
}

.custom-select-dropdown.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scaleY(1);
    transition: 
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0s linear 0s; /* sem delay quando ABRINDO */
}

/* LISTA DE OPÇÕES */
.custom-select-options {
    max-height: 240px; /* altura máxima quando há muitos itens */
    overflow-y: auto;
    overflow-x: hidden;
}

/* Scrollbar customizada */
.custom-select-options::-webkit-scrollbar {
    width: 8px;
}

.custom-select-options::-webkit-scrollbar-track {
    background: var(--bg-tertiary);
    border-radius: var(--radius-sm);
}

.custom-select-options::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, var(--color-success), var(--color-success-dark));
    border-radius: var(--radius-sm);
}

.custom-select-options::-webkit-scrollbar-thumb:hover {
    background: var(--color-success-dark);
}

/* Firefox scrollbar */
.custom-select-options {
    scrollbar-width: thin;
    scrollbar-color: var(--color-success) var(--bg-tertiary);
}

/* OPÇÕES INDIVIDUAIS */
.custom-select-option {
    padding: var(--spacing-md) var(--spacing-lg);
    cursor: pointer;
    transition: background 0.15s ease;
    color: var(--text-primary);
    font-size: 0.95rem;
    border-bottom: 1px solid var(--border-color-light);
    min-height: 50px;
    display: flex;
    align-items: center;
}

.custom-select-option:last-child {
    border-bottom: none;
}

.custom-select-option:hover {
    background: var(--bg-tertiary);
}

.custom-select-option.selected {
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-success-light);
    font-weight: 600;
}

/* OPÇÃO PADRÃO (ex: "Selecione um cliente") */
.custom-select-option-default {
    background: var(--bg-secondary) !important;
    border-bottom: 2px solid var(--border-color) !important;
    font-weight: 600 !important;
    color: var(--text-tertiary) !important;
    gap: var(--spacing-sm);
}

.custom-select-option-default i {
    color: var(--text-muted);
    font-size: 0.9rem;
}

.custom-select-option-default:hover {
    background: var(--bg-tertiary) !important;
    color: var(--text-secondary) !important;
}

/* MENSAGEM DE LISTA VAZIA */
.custom-select-empty {
    padding: var(--spacing-xl);
    text-align: center;
    color: var(--text-tertiary);
    font-size: 0.9rem;
    font-style: italic;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
}

.custom-select-empty i {
    font-size: 2rem;
    opacity: 0.3;
}

