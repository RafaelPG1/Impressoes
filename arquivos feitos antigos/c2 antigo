   VARIAÇÕES POR MODAL
   =============================================== */

/* MODAL DE HISTÓRICO (AZUL) */
#paymentHistoryModal .custom-select-trigger.open {
    border-color: var(--color-info);
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
}

#paymentHistoryModal .custom-select-dropdown {
