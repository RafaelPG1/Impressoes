/* ===============================================
   SISTEMA DE IMPRESSÕES - CSS PARTE 2
   
   CONTEÚDO:
   - SEÇÃO: Impressões Registradas (Roxo)
   - SEÇÃO: Resumo por Cliente (Laranja)
   - Modal de Pagamento (COMPLETO - Verde)
   - Modal de Histórico de Pagamentos (Azul)
   - Modal de Sucesso de Pagamento
   - Modal de Pagamento Removido
   - Estilos Específicos para Selects dos Modais
   - Componentes Específicos de Pagamento
   - Animações Específicas
   - Responsividade Específica
   =============================================== */


/* ===============================================
   1. LAYOUT DA SEÇÃO DE DADOS
   =============================================== */

.data-section {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--spacing-xl);
    align-items: start;
}


/* ===============================================
   2. SEÇÃO: IMPRESSÕES REGISTRADAS (ROXO)
   =============================================== */

.table-card {
    display: flex;
    flex-direction: column;
}

.table-card .card-header {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, var(--bg-card) 100%);
}

.table-card .card-header h2 {
    color: var(--color-primary-light);
}

.table-card .card-header i {
    color: var(--color-primary);
}


/* ===============================================
   3. SEÇÃO: RESUMO POR CLIENTE (LARANJA)
   =============================================== */

.summary-card {
    display: flex;
    flex-direction: column;
}

.summary-card .card-header {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, var(--bg-card) 100%);
}

.summary-card .card-header h2 {
    color: var(--color-warning-light);
    flex: 1;
}

.summary-card .card-header i {
    color: var(--color-warning);
}

.summary-list {
    padding: var(--spacing-lg);
    max-height: 600px;
    overflow-y: auto;
}

.summary-list::-webkit-scrollbar {
    width: 8px;
}

.summary-list::-webkit-scrollbar-track {
    background: var(--bg-secondary);
}

.summary-list::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, var(--color-warning), var(--color-warning-dark));
    border-radius: var(--radius-sm);
}

.client-summary {
    background: var(--bg-tertiary);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-warning);
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
}

.client-summary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(245, 158, 11, 0.1), transparent);
    transition: left 0.5s;
}

.client-summary:hover::before {
    left: 100%;
}

.client-summary:hover {
    transform: translateX(6px);
    border-left-width: 6px;
    box-shadow: var(--shadow-md);
}

.client-summary-name {
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: var(--spacing-md);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 1.15rem;
}

.client-summary-name i {
    color: var(--color-warning);
    font-size: 1.1rem;
}

.client-summary-stats {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
}

.client-summary-original {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--border-color-light);
}

.client-summary-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) 0;
}

.summary-label {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.summary-value {
    font-size: 1.2rem;
    font-weight: 800;
    font-family: var(--font-mono);
}

.summary-value.original {
    color: var(--color-info-light);
}

.summary-value.pending {
    color: var(--color-danger-light);
}

.summary-value.paid {
    color: var(--color-success-light);
}

.client-summary-count {
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-weight: 600;
}

.client-summary-folhas {
    display: flex;
    gap: var(--spacing-lg);
    font-size: 0.85rem;
    color: var(--text-tertiary);
}

.client-summary-folhas span {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
}

.client-summary-folhas i {
    color: var(--text-muted);
}

.client-summary-debt {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--border-color-light);
}

.client-debt-value {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 0.95rem;
    color: var(--color-danger-light);
    font-weight: 700;
}

.client-debt-value i {
    color: var(--color-danger);
}

.client-paid-value {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 0.95rem;
    color: var(--color-success-light);
    font-weight: 700;
}

.client-paid-value i {
    color: var(--color-success);
}



/* ===============================================
   4. MODAL DE PAGAMENTO - VERDE (OTIMIZADO)
   =============================================== */

/* Container do Modal de Pagamento */
#paymentModal .modal-content {
    max-width: 700px !important;
    width: 90% !important;
    max-height: 70vh !important;
    display: flex !important;
    flex-direction: column !important;
    margin: 2.5vh auto !important;
    overflow-y: auto !important; /* SCROLL NO MODAL INTEIRO */
    overflow-x: hidden !important;
}

/* Header fixo */
#paymentModal .modal-header {
    background: linear-gradient(135deg, var(--color-success), var(--color-success-dark)) !important;
    flex-shrink: 0;
}

#paymentModal .modal-header h3,
#paymentModal .modal-header i,
#paymentModal .modal-header .close {
    color: white !important;
}

#paymentModal .modal-header .close:hover {
    background: rgba(255, 255, 255, 0.2) !important;
}

#paymentModal .modal-header::before {
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent) !important;
}

/* Body - SEM SCROLL PRÓPRIO */
/* 🔧 AJUSTE 1: Removido overflow-y: auto que causava scroll desnecessário */
#paymentModal .modal-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow: visible; /* ✅ Mantém visible para evitar scroll interno */
    padding: var(--spacing-xl);
    flex: 0 0 auto; /* Não cresce nem encolhe, usa tamanho natural */
    min-height: auto; /* ✅ AJUSTE: Remove altura mínima forçada */
}

/* Form Groups */
#paymentModal .form-group {
    margin-bottom: 0; /* Remove margin individual */
    flex-shrink: 0;
}

#paymentModal .form-group label {
    margin-bottom: var(--spacing-sm);
}

#paymentModal .form-group input,
#paymentModal .form-group select {
    padding: var(--spacing-md);
}

/* Informações de Débito */
#paymentModal .debt-info {
    margin: 0; /* Remove margin individual, gap do body cuida disso */
    flex-shrink: 0;
}

/* Botões - NO FLUXO NATURAL DO MODAL */
#paymentModal .modal-buttons {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
}

#paymentModal .modal-buttons .btn {
    flex: 1;
    min-width: 0;
}

/* Scrollbar customizada para o MODAL INTEIRO */
#paymentModal .modal-content::-webkit-scrollbar {
    width: 8px;
}

#paymentModal .modal-content::-webkit-scrollbar-track {
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
}

#paymentModal .modal-content::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, var(--color-success), var(--color-success-dark));
    border-radius: var(--radius-sm);
}

#paymentModal .modal-content::-webkit-scrollbar-thumb:hover {
    background: var(--color-success-dark);
}

/* Cards de Débito */
.debt-info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
}

.debt-card {
    background: var(--bg-tertiary);
    padding: var(--spacing-lg);
    border-radius: var(--radius-md);
    border-left: 4px solid var(--color-danger);
    transition: all var(--transition-base);
}

.debt-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.debt-card-original {
    border-left-color: var(--color-info);
}

.debt-card-pending {
    border-left-color: var(--color-danger);
}

.debt-card-paid {
    border-left-color: var(--color-success);
}

.debt-label {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.debt-value {
    font-size: 1.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
    letter-spacing: -0.5px;
}

.debt-card-original .debt-value {
    color: var(--color-info-light);
}

.debt-card-pending .debt-value {
    color: var(--color-danger-light);
}

.debt-card-paid .debt-value {
    color: var(--color-success-light);
}

/* Lista de Impressões para Pagamento */
/* 🔧 AJUSTE 2: Controle de scroll apenas quando necessário */
.impressions-payment-list {
    max-height: 350px; /* ✅ Mantém altura máxima */
    overflow-y: auto; /* ✅ Scroll aparece apenas quando exceder 350px */
    overflow-x: hidden; /* ✅ NOVO: Evita scroll horizontal */
    padding: var(--spacing-md);
    background: var(--bg-secondary);
    border-radius: var(--radius-md);
    border: 2px solid var(--border-color);
}

.impressions-payment-list::-webkit-scrollbar {
    width: 8px;
}

.impressions-payment-list::-webkit-scrollbar-track {
    background: var(--bg-primary);
}

.impressions-payment-list::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    border-radius: var(--radius-sm);
}

.impression-payment-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    margin-bottom: var(--spacing-md);
    background: var(--bg-tertiary);
    border-radius: var(--radius-md);
    border: 2px solid transparent;
    transition: all var(--transition-base);
    cursor: pointer;
}

.impression-payment-item:hover {
    border-color: var(--border-color-hover);
    transform: translateX(4px);
}

.impression-payment-item.selected {
    border-color: var(--color-success);
    background: rgba(16, 185, 129, 0.1);
}

.impression-payment-item.parcial {
    border-left: 3px solid var(--color-warning);
}

.impression-payment-item input[type="checkbox"] {
    width: 20px;
    height: 20px;
    cursor: pointer;
    accent-color: var(--color-success);
    flex-shrink: 0;
}

.impression-payment-details {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-md);
}

.impression-payment-info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    flex: 1;
}

.impression-payment-date {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
}

.impression-payment-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
}

.impression-payment-parcial {
    font-size: 0.8rem;
    color: var(--color-warning-light);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
}

.impression-payment-value {
    text-align: right;
}

.impression-payment-value .label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-bottom: var(--spacing-xs);
}

.impression-payment-value .value {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-success-light);
    font-family: var(--font-mono);
}

/* ===============================
   VALIDAÇÃO DE VALOR DE PAGAMENTO
   =============================== */

/* Mensagem de erro acima do input */
.payment-value-error {
    background: linear-gradient(135deg, #ff4757 0%, #ff6b81 100%);
    color: white;
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    box-shadow: 0 4px 12px rgba(255, 71, 87, 0.2);
    animation: slideDown 0.3s ease-out;
}

.payment-value-error i {
    font-size: 18px;
    flex-shrink: 0;
}

/* Animação de entrada da mensagem de erro */
@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Input com erro */
.input-error {
    border: 2px solid #ff4757 !important;
    background: rgba(255, 71, 87, 0.05) !important;
    animation: shake 0.4s ease-in-out;
}

/* Animação de shake para input com erro */
@keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
    20%, 40%, 60%, 80% { transform: translateX(5px); }
}

/* Botão desabilitado */
#applyPaymentBtn:disabled {
    background: #95a5a6 !important;
    cursor: not-allowed !important;
    opacity: 0.5 !important;
    pointer-events: none;
}

/* Hover no input com erro (mantém a cor de erro) */
input.input-error:hover,
input.input-error:focus {
    border-color: #ff4757 !important;
    box-shadow: 0 0 0 3px rgba(255, 71, 87, 0.1) !important;
}

/* Responsividade */
@media (max-width: 768px) {
    .payment-value-error {
        font-size: 13px;
        padding: 10px 14px;
    }
    
    .payment-value-error i {
        font-size: 16px;
    }
}

/* ===============================================
   5. MODAL DE HISTÓRICO DE PAGAMENTOS (AZUL)
   =============================================== */

/* Container do Modal de Histórico */
#paymentHistoryModal .modal-content {
    max-width: 700px !important;
    width: 90% !important;
    max-height: 90vh !important;
    display: flex !important;
    flex-direction: column !important;
    margin: 2.5vh auto !important;
    overflow-y: auto !important; /* SCROLL NO MODAL INTEIRO */
    overflow-x: hidden !important;
}

/* Header fixo */
#paymentHistoryModal .modal-header {
    background: linear-gradient(135deg, var(--color-info), var(--color-info-dark)) !important;
    flex-shrink: 0;
}

#paymentHistoryModal .modal-header h3,
#paymentHistoryModal .modal-header i,
#paymentHistoryModal .modal-header .close {
    color: white !important;
}

#paymentHistoryModal .modal-header .close:hover {
    background: rgba(255, 255, 255, 0.2) !important;
}

#paymentHistoryModal .modal-header::before {
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent) !important;
}

/* Body - SEM SCROLL PRÓPRIO */
#paymentHistoryModal .modal-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow: visible; /* SEM scroll interno */
    padding: var(--spacing-xl);
    flex: 0 0 auto; /* Não cresce nem encolhe, usa tamanho natural */
}

#paymentHistoryModal .form-group {
    margin-bottom: 0; /* Remove margin individual */
}

#paymentHistoryModal .form-group select {
    border-color: var(--border-color);
    transition: all 0.3s ease;
}

#paymentHistoryModal .form-group select:focus {
    border-color: var(--color-info) !important;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15) !important;
    background: var(--bg-tertiary);
}

#paymentHistoryModal .form-group select:hover {
    border-color: rgba(59, 130, 246, 0.5);
}

/* Botões - NO FLUXO NATURAL DO MODAL */
#paymentHistoryModal .modal-buttons {
    display: flex;
    gap: 12px;
    padding: var(--spacing-lg) var(--spacing-xl);
    flex-shrink: 0;
    justify-content: flex-end;
    padding-bottom: calc(var(--spacing-xl) - 30px);
}

#paymentHistoryModal .modal-buttons .btn {
    min-width: 120px;
}

/* Scrollbar customizada para o MODAL INTEIRO */
#paymentHistoryModal .modal-content::-webkit-scrollbar {
    width: 8px;
}

#paymentHistoryModal .modal-content::-webkit-scrollbar-track {
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
}

#paymentHistoryModal .modal-content::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, var(--color-info), var(--color-info-dark));
    border-radius: var(--radius-sm);
}

#paymentHistoryModal .modal-content::-webkit-scrollbar-thumb:hover {
    background: var(--color-info-dark);
}

/* Lista de Histórico */
.payment-history-list {
    max-height: 450px;
    overflow-y: auto;
    padding: var(--spacing-md);
}

.payment-history-list::-webkit-scrollbar {
    width: 8px;
}

.payment-history-list::-webkit-scrollbar-track {
    background: var(--bg-secondary);
}

.payment-history-list::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, var(--color-success), var(--color-success-dark));
    border-radius: var(--radius-sm);
}

.payment-history-item {
    background: var(--bg-tertiary);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
    transition: all var(--transition-base);
}

.payment-history-item:hover {
    border-color: var(--border-color-hover);
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
}

.payment-history-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--border-color-light);
}

.payment-history-date {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 0.9rem;
    color: var(--text-tertiary);
    font-weight: 500;
}

.payment-history-date i {
    color: var(--color-success);
}

.payment-history-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-success-light);
    font-family: var(--font-mono);
}

.payment-history-details {
    display: flex;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
    font-size: 0.85rem;
    color: var(--text-tertiary);
    flex-wrap: wrap;
}

.payment-history-type,
.payment-history-days {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
}

.payment-history-type i,
.payment-history-days i {
    color: var(--text-muted);
}

.btn-remove-payment {
    width: 100%;
    padding: var(--spacing-sm) var(--spacing-md);
    background: linear-gradient(135deg, var(--color-danger), var(--color-danger-dark));
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-base);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
}

.btn-remove-payment:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
}


/* ===============================================
   6. MODAL DE SUCESSO DE PAGAMENTO
   =============================================== */

/* Container do Modal de Sucesso */
#paymentSuccessModal .modal-content {
    max-width: 600px !important;
    width: 90% !important;
    max-height: calc(80vh - 10px) !important;
    display: flex !important;
    flex-direction: column !important;
    margin: 2.5vh auto !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
}

/* Body - SEM SCROLL PRÓPRIO */
/* 🔧 AJUSTE 3: Reduzido gap para diminuir espaço entre conteúdo e botão */
#paymentSuccessModal .modal-body {
    display: flex;
    flex-direction: column;
    gap: 10px; /* ✅ AJUSTE: Reduzido de 16px para 10px (-6px) */
    overflow: visible;
    padding: var(--spacing-xl);
    flex: 0 0 auto;
}

/* Botões - NO FLUXO NATURAL DO MODAL */
/* 🔧 AJUSTE 4: Controle fino do espaçamento superior do botão */
#paymentSuccessModal .modal-buttons {
    display: flex;
    gap: 12px;
    padding: var(--spacing-lg) var(--spacing-xl);
    flex-shrink: 0;
    justify-content: center;
    padding-top: calc(var(--spacing-lg) - 10px); /* ✅ AJUSTE: Reduz -10px do espaço superior */
    padding-bottom: calc(var(--spacing-xl) - 30px);
}

#paymentSuccessModal .modal-buttons .btn {
    min-width: 150px;
}

/* Scrollbar customizada para o MODAL INTEIRO */
#paymentSuccessModal .modal-content::-webkit-scrollbar {
    width: 8px;
}

#paymentSuccessModal .modal-content::-webkit-scrollbar-track {
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
}

#paymentSuccessModal .modal-content::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, var(--color-success), var(--color-success-dark));
    border-radius: var(--radius-sm);
}

#paymentSuccessModal .modal-content::-webkit-scrollbar-thumb:hover {
    background: var(--color-success-dark);
}

/* 🔧 AJUSTE 5: Controle fino do espaçamento interno dos detalhes */
.payment-success-details {
    background: var(--bg-tertiary);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    margin-bottom: 0; /* ✅ AJUSTE: Remove margin inferior extra */
}

.success-detail-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-md) 0;
    border-bottom: 1px solid var(--border-color-light);
}

.success-detail-item:last-child {
    border-bottom: none;
}

.success-detail-item i {
    font-size: 1.5rem;
    color: var(--color-success);
    min-width: 32px;
    text-align: center;
    flex-shrink: 0;
}

.success-detail-item > div {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
}

.detail-label {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.detail-value {
    font-size: 1.1rem;
    color: var(--text-primary);
    font-weight: 700;
}

.detail-value.success-amount {
    font-size: 1.5rem;
    color: var(--color-success-light);
    font-family: var(--font-mono);
}


/* ===============================================
   7. MODAL DE PAGAMENTO REMOVIDO (OTIMIZADO)
   =============================================== */

.payment-removed-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    z-index: 10001;
    display: none;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.3s ease;
}

.payment-removed-overlay.show {
    display: flex;
}

/* Container do Modal - SCROLL UNIFICADO */
.payment-removed-modal {
    background: var(--bg-card);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-xl);
    max-width: 520px;
    width: 90%;
    max-height: 90vh !important;
    display: flex !important;
    flex-direction: column !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    animation: paymentRemovedScaleIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* Scrollbar customizada */
.payment-removed-modal::-webkit-scrollbar {
    width: 8px;
}

.payment-removed-modal::-webkit-scrollbar-track {
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
}

.payment-removed-modal::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, var(--color-danger), var(--color-danger-dark));
    border-radius: var(--radius-sm);
}

.payment-removed-modal::-webkit-scrollbar-thumb:hover {
    background: var(--color-danger-dark);
}

/* Header fixo */
.payment-removed-header {
    background: linear-gradient(135deg, var(--color-danger), var(--color-danger-dark));
    padding: var(--spacing-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-md);
    position: relative;
    flex-shrink: 0;
}

.payment-removed-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
}

.payment-removed-icon-wrapper {
    width: 80px;
    height: 80px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: paymentRemovedIconBounce 0.6s ease;
}

.payment-removed-icon {
    width: 48px;
    height: 48px;
    fill: white;
}

/* Body - SEM SCROLL PRÓPRIO */
.payment-removed-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: var(--spacing-xl);
    text-align: center;
    overflow: visible;
    flex: 0 0 auto;
}

.payment-removed-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.5px;
    margin: 0;
}

.payment-removed-message {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.10), rgba(239, 68, 68, 0.04));
    border-left: 4px solid var(--color-danger-dark);
    padding: var(--spacing-lg);
    border-radius: var(--radius-lg);
    margin: 0;
}

.payment-removed-message p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
}

.payment-removed-details {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    background: var(--bg-tertiary);
    padding: var(--spacing-lg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    margin: 0;
}

.payment-removed-detail-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm) 0;
}

.payment-removed-detail-item:not(:last-child) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: var(--spacing-md);
}

.payment-removed-detail-label {
    font-size: 0.9rem;
    color: var(--text-tertiary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.payment-removed-detail-label i {
    color: var(--color-danger-light);
}

.payment-removed-detail-value {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
}

.payment-removed-detail-value.client-name {
    color: var(--color-danger-light);
}

.payment-removed-detail-value.amount {
    font-family: var(--font-mono);
    color: var(--color-danger-light);
}

/* Botão - NO FLUXO NATURAL */
.payment-removed-button {
    width: 100%;
    padding: var(--spacing-lg);
    background: linear-gradient(135deg, var(--color-danger), var(--color-danger-dark));
    color: white;
    border: none;
    border-radius: var(--radius-lg);
