/* ===============================================
   DRAG TO SCROLL - APENAS ANIMAÇÕES DO MOUSE
   =============================================== */

/* Remove seleção de texto durante drag */
.table-scroll-wrapper.dragging * {
    user-select: none !important;
    -webkit-user-select: none !important;
    -moz-user-select: none !important;
    -ms-user-select: none !important;
}

/* ===============================================
   MODAL HOLD TO CLOSE - INDICADOR DE PROGRESSO
   =============================================== */

/* Container do indicador de progresso */
.modal-hold-progress {
    position: fixed;
    transform: translate(-50%, -50%);
    z-index: 10001;
    pointer-events: none;
    animation: holdProgressFadeIn 0.2s ease-out;
}

@keyframes holdProgressFadeIn {
    from {
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.8);
    }
    to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }
}

/* Círculo de progresso */
.hold-progress-circle {
    position: relative;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* SVG do círculo */
.progress-ring {
    position: absolute;
    top: 0;
    left: 0;
    transform: rotate(-90deg);
}

.progress-ring-circle {
    stroke: white;
    stroke-width: 3;
    fill: transparent;
    stroke-linecap: round;
    filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.5));
}

/* Ícone no centro */
.hold-progress-icon {
    width: 30px;
    height: 30px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
}

.hold-progress-icon i {
    color: white;
    font-size: 16px;
    animation: holdIconPulse 1s ease-in-out infinite;
}

@keyframes holdIconPulse {
    0%, 100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.1);
    }
}

/* Texto abaixo do círculo */
.hold-progress-text {
    margin-top: 10px;
    color: white;
    font-size: 12px;
    font-weight: 500;
    text-align: center;
    white-space: nowrap;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
    animation: holdTextBlink 1.5s ease-in-out infinite;
}

@keyframes holdTextBlink {
    0%, 100% {
        opacity: 1;
    }
    50% {
        opacity: 0.6;
    }
}